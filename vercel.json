{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/dewa-works-dubai",
      "destination": "/dewa-approvals-dubai",
      "permanent": true
    },
    {
      "source": "/dewa-works-dubai.html",
      "destination": "/dewa-approvals-dubai",
      "permanent": true
    },
    {
      "source": "/dewaapprovalsdubai",
      "destination": "/dewa-approvals-dubai",
      "permanent": true
    },
    {
      "source": "/electrical-contractor-dubai",
      "destination": "/services/electrical-contractors-dubai",
      "permanent": true
    },
    {
      "source": "/electrical-contractor-dubai.html",
      "destination": "/services/electrical-contractors-dubai",
      "permanent": true
    },
    {
      "source": "/electrical-technical-work",
      "destination": "/services/electrical-contractors-dubai",
      "permanent": true
    },
    {
      "source": "/electrical-technical-work.html",
      "destination": "/services/electrical-contractors-dubai",
      "permanent": true
    },
    {
      "source": "/plumbing-contractor-dubai",
      "destination": "/services/plumbing-contractors-dubai",
      "permanent": true
    },
    {
      "source": "/plumbing-contractor-dubai.html",
      "destination": "/services/plumbing-contractors-dubai",
      "permanent": true
    },
    {
      "source": "/plumbing-technical-work",
      "destination": "/services/plumbing-contractors-dubai",
      "permanent": true
    },
    {
      "source": "/plumbing-technical-work.html",
      "destination": "/services/plumbing-contractors-dubai",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/gallery.html",
      "destination": "/gallery",
      "permanent": true
    },
    {
      "source": "/projects.html",
      "destination": "/projects",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
