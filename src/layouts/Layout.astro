---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import MobileStickyBar from '../components/MobileStickyBar.astro';
import { siteConfig } from '../config/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  currentPath?: string;
  canonicalUrl?: string;
  ogImage?: string;
  jsonLd?: Record<string, any> | Record<string, any>[];
  arabicUrl?: string;
  englishUrl?: string;
  isArabic?: boolean;
}

const { 
  title, 
  description, 
  currentPath = '',
  canonicalUrl = `${siteConfig.primaryDomain}${currentPath === '/' ? '' : currentPath}`,
  ogImage = `${siteConfig.primaryDomain}/images/gallery/electrical-panel-assembly.jpg`,
  jsonLd,
  arabicUrl,
  englishUrl,
  isArabic = false
} = Astro.props;

// Base Schema: Validated LocalBusiness & Engineering Contractor without unverified reviews
const businessSchema = {
  "@context": "https://schema.org",
  "@type": ["Electrician", "Plumber", "GeneralContractor", "LocalBusiness"],
  "@id": `${siteConfig.primaryDomain}/#business`,
  "name": siteConfig.legalName,
  "legalName": siteConfig.legalName,
  "alternateName": [siteConfig.siteShortName, "Abbadi Tech LLC", "DEWA Approvals Dubai"],
  "url": `${siteConfig.primaryDomain}/`,
  "logo": `${siteConfig.primaryDomain}/logo.png`,
  "image": ogImage,
  "telephone": siteConfig.phoneRaw,
  "email": siteConfig.email,
  "foundingDate": "2005",
  "priceRange": "AED",
  "paymentAccepted": "Cash, Credit Card, Bank Transfer, Cheque",
  "currenciesAccepted": "AED",
  "openingHours": "Mo-Sa 08:00-18:00",
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      "opens": "08:00",
      "closes": "18:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      "opens": "00:00",
      "closes": "23:59",
      "description": "24/7 Emergency Electrical & MEP On-Call Dispatch"
    }
  ],
  "contactPoint": [
    {
      "@type": "ContactPoint",
      "telephone": siteConfig.phoneRaw,
      "contactType": "technical estimation & authority coordination",
      "areaServed": ["AE", "Dubai", "Abu Dhabi", "Ajman"],
      "availableLanguage": ["English", "Arabic", "Hindi", "Urdu"]
    },
    {
      "@type": "ContactPoint",
      "telephone": siteConfig.phoneRaw,
      "contactType": "emergency electrical dispatch",
      "hoursAvailable": "Mo-Su 00:00-24:00"
    }
  ],
  "founder": {
    "@type": "Person",
    "name": siteConfig.founder.name,
    "jobTitle": siteConfig.founder.title
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": siteConfig.address.street,
    "addressLocality": siteConfig.address.city,
    "addressRegion": siteConfig.address.region,
    "postOfficeBoxNumber": siteConfig.address.postalCode,
    "addressCountry": siteConfig.address.country
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": siteConfig.address.latitude.toString(),
    "longitude": siteConfig.address.longitude.toString()
  },
  "knowsAbout": [
    "DEWA Approvals & NOCs",
    "Single-Line Diagrams (SLD)",
    "Load Schedule Calculations",
    "MDB & SMDB Panel Assembly",
    "Commercial Kitchen Grease Traps",
    "Dubai Municipality Plumbing Regulations",
    "Civil Defence Life Safety Compliance",
    "Water Booster Pump Stations",
    "LV Inspection & Meter Connections"
  ],
  "areaServed": [
    { "@type": "City", "name": "Dubai" },
    { "@type": "AdministrativeArea", "name": "Business Bay" },
    { "@type": "AdministrativeArea", "name": "Downtown Dubai" },
    { "@type": "AdministrativeArea", "name": "DIFC (Dubai International Financial Centre)" },
    { "@type": "AdministrativeArea", "name": "Palm Jumeirah" },
    { "@type": "AdministrativeArea", "name": "Dubai Marina" },
    { "@type": "AdministrativeArea", "name": "JLT (Jumeirah Lakes Towers)" },
    { "@type": "AdministrativeArea", "name": "Al Quoz Industrial Area" },
    { "@type": "AdministrativeArea", "name": "Dubai Investments Park (DIP)" },
    { "@type": "AdministrativeArea", "name": "Dubai South" },
    { "@type": "AdministrativeArea", "name": "Dubai Silicon Oasis" },
    { "@type": "AdministrativeArea", "name": "Al Barsha" },
    { "@type": "City", "name": "Abu Dhabi" },
    { "@type": "City", "name": "Ajman" }
  ]
};
---

<!doctype html>
<html lang={isArabic ? "ar" : "en"} dir={isArabic ? "rtl" : "ltr"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Crawl & Indexing -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content={siteConfig.legalName} />
    <meta name="theme-color" content={siteConfig.colors.navyDark} />

    <!-- Hreflang Canonical & Regional Language Annotations -->
    {isArabic ? (
      <>
        <link rel="alternate" hreflang="ar-ae" href={canonicalUrl} />
        <link rel="alternate" hreflang="en-ae" href={englishUrl || `${siteConfig.primaryDomain}${currentPath.replace(/^\/ar/, '') || '/'}`} />
        <link rel="alternate" hreflang="x-default" href={englishUrl || `${siteConfig.primaryDomain}${currentPath.replace(/^\/ar/, '') || '/'}`} />
      </>
    ) : (
      <>
        <link rel="alternate" hreflang="en-ae" href={canonicalUrl} />
        <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
        {arabicUrl && (
          <link rel="alternate" hreflang="ar-ae" href={arabicUrl} />
        )}
      </>
    )}

    <!-- Geo Meta Tags for UAE Local Pack -->
    <meta name="geo.region" content="AE-DU" />
    <meta name="geo.placename" content="Dubai" />
    <meta name="geo.position" content={`${siteConfig.address.latitude};${siteConfig.address.longitude}`} />
    <meta name="ICBM" content={`${siteConfig.address.latitude}, ${siteConfig.address.longitude}`} />

    <!-- Open Graph (Facebook / LinkedIn / WhatsApp) -->
    <meta property="og:locale" content={isArabic ? "ar_AE" : "en_AE"} />
    <meta property="og:locale:alternate" content={isArabic ? "en_AE" : "ar_AE"} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- Schema.org Base Organization & LocalBusiness Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />

    <!-- Additional Custom JSON-LD (e.g. Service, BreadcrumbList, FAQPage, Article) -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- Conversion & Analytics Event Tracking Stub -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      // Track Phone Calls & WhatsApp clicks as conversions
      document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('a[href^="tel:"]').forEach(function(el) {
          el.addEventListener('click', function() {
            if (typeof gtag === 'function') {
              gtag('event', 'conversion', { 'event_category': 'Engagement', 'event_label': 'Phone Call Click', 'value': 1 });
            }
          });
        });
        document.querySelectorAll('a[href*="wa.me"]').forEach(function(el) {
          el.addEventListener('click', function() {
            if (typeof gtag === 'function') {
              gtag('event', 'conversion', { 'event_category': 'Engagement', 'event_label': 'WhatsApp Chat Click', 'value': 1 });
            }
          });
        });
      });
    </script>
    <script is:inline>
      document.documentElement.classList.add('js-ready');
    </script>
  </head>
  <body>
    <Header currentPath={currentPath} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
    <MobileStickyBar />

    <!-- Back to Top Smooth Scroller -->
    <button id="back-to-top-btn" class="back-to-top" aria-label="Scroll to top of page">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
    </button>

    <script>
      import '../scripts/site-interactions';
    </script>
  </body>
</html>
