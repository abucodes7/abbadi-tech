---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import MobileStickyBar from '../components/MobileStickyBar.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  currentPath?: string;
  canonicalUrl?: string;
  ogImage?: string;
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const { 
  title, 
  description, 
  currentPath = '',
  canonicalUrl = `https://www.abbaditech.com${currentPath || '/'}`,
  ogImage = 'https://www.abbaditech.com/images/gallery/electrical-panel-assembly.jpg',
  jsonLd
} = Astro.props;

// Base LocalBusiness Schema (Electrician, Plumber, GeneralContractor)
const businessSchema = {
  "@context": "https://schema.org",
  "@type": ["Electrician", "Plumber", "GeneralContractor", "LocalBusiness"],
  "@id": "https://www.abbaditech.com/#business",
  "name": "Abbadi Tech Technical Solutions LLC",
  "legalName": "Abbadi Tech Technical Solutions LLC",
  "alternateName": ["Abbadi Tech LLC", "DEWA Approvals Dubai", "Abbadi Tech Contracting"],
  "url": "https://www.abbaditech.com/",
  "logo": "https://www.abbaditech.com/logo.png",
  "image": ogImage,
  "telephone": "+971505546943",
  "email": "it.abbaditech@gmail.com",
  "foundingDate": "2005",
  "priceRange": "AED",
  "paymentAccepted": "Cash, Credit Card, Bank Transfer, Cheque",
  "currenciesAccepted": "AED",
  "openingHours": "Mo-Sa 08:00-18:00",
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      "opens": "08:00",
      "closes": "18:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      "opens": "00:00",
      "closes": "23:59",
      "description": "24/7 Emergency Electrical & MEP On-Call Dispatch"
    }
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "184",
    "bestRating": "5",
    "worstRating": "1"
  },
  "contactPoint": [
    {
      "@type": "ContactPoint",
      "telephone": "+971505546943",
      "contactType": "customer service & technical estimation",
      "areaServed": ["AE", "Dubai", "Abu Dhabi", "Ajman"],
      "availableLanguage": ["English", "Arabic", "Hindi", "Urdu"]
    },
    {
      "@type": "ContactPoint",
      "telephone": "+971505546943",
      "contactType": "emergency dispatch",
      "hoursAvailable": "Mo-Su 00:00-24:00"
    }
  ],
  "founder": {
    "@type": "Person",
    "name": "Koyakutty Mohammed",
    "jobTitle": "Founder & Chairman"
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Oberoi Properties Building, Behind Al Khail Mall",
    "addressLocality": "Dubai",
    "addressRegion": "Dubai",
    "postOfficeBoxNumber": "121908",
    "addressCountry": "AE"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "25.1384",
    "longitude": "55.2348"
  },
  "areaServed": [
    { "@type": "City", "name": "Dubai" },
    { "@type": "AdministrativeArea", "name": "Business Bay" },
    { "@type": "AdministrativeArea", "name": "Downtown Dubai" },
    { "@type": "AdministrativeArea", "name": "DIFC (Dubai International Financial Centre)" },
    { "@type": "AdministrativeArea", "name": "Palm Jumeirah" },
    { "@type": "AdministrativeArea", "name": "Dubai Marina" },
    { "@type": "AdministrativeArea", "name": "JLT (Jumeirah Lakes Towers)" },
    { "@type": "AdministrativeArea", "name": "Al Quoz Industrial Area" },
    { "@type": "AdministrativeArea", "name": "Dubai Investments Park (DIP)" },
    { "@type": "AdministrativeArea", "name": "Dubai South" },
    { "@type": "AdministrativeArea", "name": "Dubai Silicon Oasis" },
    { "@type": "AdministrativeArea", "name": "Al Barsha" },
    { "@type": "City", "name": "Abu Dhabi" },
    { "@type": "City", "name": "Ajman" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Licensed Technical & MEP Contracting Services",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "DEWA Approvals & Fast-Track NOCs Dubai",
          "description": "Certified online portal submissions, Single-Line Diagrams (SLD), load schedule calculations, fit-out NOCs, and final meter energization across Dubai."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Electrical Contractors Dubai",
          "description": "MDB/SMDB panel building, cable pulling, busbar trunking, 3-phase power distribution, and testing & commissioning."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Plumbing & Drainage Contractors Dubai",
          "description": "PPR & copper water supply piping, HDPE & UPVC acoustic drainage, automatic booster pumps, and water heater installations."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Commercial Kitchen Grease Trap & Municipality Approvals",
          "description": "Dubai Municipality compliant grease trap supply, biological dosing systems, and certified kitchen drainage rough-in."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "24/7 Emergency Electrical & MEP Repair Dubai",
          "description": "Rapid on-site emergency dispatch for short circuits, breaker trips, pump failures, and power outages."
        }
      }
    ]
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Crawl & Indexing -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="Abbadi Tech Technical Solutions LLC" />
    <meta name="theme-color" content="#0C2340" />
    <meta name="keywords" content="DEWA approval services Dubai, electrical contractor Dubai, commercial plumbing contractor Dubai, DEWA fit-out NOC, Single-Line Diagram SLD Dubai, load schedule calculation, MDB SMDB panel Dubai, grease trap Dubai Municipality approval, emergency electrical contractor Dubai, MEP contracting Dubai" />

    <!-- Geo Meta Tags for Local UAE SEO -->
    <meta name="geo.region" content="AE-DU" />
    <meta name="geo.placename" content="Dubai" />
    <meta name="geo.position" content="25.1384;55.2348" />
    <meta name="ICBM" content="25.1384, 55.2348" />

    <!-- Open Graph (Facebook / LinkedIn / WhatsApp) -->
    <meta property="og:locale" content="en_AE" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Abbadi Tech LLC" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Schema.org Base Organization & LocalBusiness Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />

    <!-- Additional Custom JSON-LD (e.g. Service or Breadcrumbs) -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- Conversion & Analytics Event Tracking Stub -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      // Track Phone Calls & WhatsApp clicks as conversions
      document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('a[href^="tel:"]').forEach(function(el) {
          el.addEventListener('click', function() {
            if (typeof gtag === 'function') {
              gtag('event', 'conversion', { 'event_category': 'Engagement', 'event_label': 'Phone Call Click', 'value': 1 });
            }
          });
        });
        document.querySelectorAll('a[href*="wa.me"]').forEach(function(el) {
          el.addEventListener('click', function() {
            if (typeof gtag === 'function') {
              gtag('event', 'conversion', { 'event_category': 'Engagement', 'event_label': 'WhatsApp Chat Click', 'value': 1 });
            }
          });
        });
      });
    </script>
  </head>
  <body>
    <Header currentPath={currentPath} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
    <MobileStickyBar />

    <!-- Back to Top Smooth Scroller -->
    <button id="back-to-top-btn" class="back-to-top" aria-label="Scroll to top of page">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
    </button>

    <script>
      import '../scripts/site-interactions';
    </script>
  </body>
</html>
