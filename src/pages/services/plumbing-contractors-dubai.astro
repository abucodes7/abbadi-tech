---
import Layout from '../../layouts/Layout.astro';
import FAQSection from '../../components/FAQSection.astro';
import Icon from '../../components/Icon.astro';
import HeroAnimation from '../../components/HeroAnimation.astro';
import { siteConfig } from '../../config/site';
import { servicesData } from '../../data/services';
import { projectsList } from '../../data/projects';
import { galleryItems } from '../../data/gallery';
import { plumbingFaqs } from '../../data/faq';

const service = servicesData.find(s => s.id === 'plumbing')!;

const pageTitle = service.metaTitle;
const pageDescription = service.metaDescription;

const relevantProjects = projectsList
  .filter(p => p.scope === 'plumbing' || p.scope === 'both')
  .slice(0, 8);

const plumbingPhotos = galleryItems
  .filter(item => item.trade === 'Plumbing Technical Work')
  .slice(0, 6);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.abbaditech.com/" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.abbaditech.com/services" },
    { "@type": "ListItem", "position": 3, "name": service.title, "item": `https://www.abbaditech.com/services/${service.slug}` }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.title,
  "serviceType": "Plumbing & Sanitary Drainage Contracting",
  "provider": {
    "@type": "LocalBusiness",
    "name": "Abbadi Tech LLC",
    "telephone": "+971505546943",
    "url": "https://www.abbaditech.com/"
  },
  "areaServed": ["Dubai", "Abu Dhabi", "Ajman"],
  "description": service.overview
};

const pageFaqs = plumbingFaqs;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  currentPath={`/services/${service.slug}`}
  arabicUrl={`${siteConfig.primaryDomain}/ar/services/plumbing-contractors-dubai`}
  jsonLd={[breadcrumbSchema, serviceSchema]}
>
  <!-- HERO -->
  <section class="service-hero">
    <HeroAnimation />
    <div class="container hero-inner-container">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><a href="/services">Services</a><span>/</span><span>Plumbing works</span>
      </nav>

      <div class="hero-content">
        <div class="hero-text">
          <div class="badges-row">
            <span class="live-status-pill"><span class="pulse-dot"></span> 21+ years experience</span>
            <span class="badge badge-gold">Specialized plumbing works</span>
          </div>

          <h1>{service.heroH1}</h1>
          <p class="hero-lead">{service.overview}</p>

          <div class="hero-actions">
            <a href="/contact" class="btn btn-primary">Request plumbing survey <Icon name="ArrowUpRight" size={16} /></a>
            <a href={`https://wa.me/971505546943?text=${encodeURIComponent("Hello Abbadi Tech, I need a plumbing contractor for a project in Dubai.")}`} target="_blank" rel="noopener" class="btn btn-outline-white">
              <Icon name="MessageSquare" size={16} /> WhatsApp lead engineer
            </a>
            <a href="tel:+971505546943" class="btn btn-outline-white"><Icon name="Phone" size={15} /> +971 50 554 6943</a>
          </div>
        </div>

        <aside class="hero-meta">
          <div class="meta-row"><span>Discipline</span><strong>Plumbing &amp; drainage</strong></div>
          <div class="meta-row"><span>Materials</span><strong>PPR · copper · HDPE · UPVC</strong></div>
          <div class="meta-row"><span>Track Record</span><strong>20+ Years UAE</strong></div>
          <div class="meta-row"><span>Coverage</span><strong>Dubai · Abu Dhabi · Ajman</strong></div>
          <div class="meta-row"><span>Testing</span><strong>10-bar hydrostatic certified</strong></div>
        </aside>
      </div>
    </div>
  </section>

  <!-- BENEFITS -->
  <section class="section section-paper">
    <div class="container">
      <div class="section-header section-header-left">
        <span class="eyebrow">Plumbing reliability</span>
        <h2>High-spec potable water &amp; drainage engineering.</h2>
        <p>We install premium piping materials and precision pressure controls to ensure leak-free operation, acoustic isolation, and municipal health code compliance.</p>
      </div>

      <div class="benefits-grid reveal-group">
        {service.keyBenefits.map((b) => (
          <div class="benefit-item-card">
            <span class="benefit-check"><Icon name="Check" size={15} /></span>
            <p>{b}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DELIVERABLES -->
  <section class="section section-ivory">
    <div class="container">
      <div class="section-header section-header-left">
        <span class="eyebrow">Scope of works</span>
        <h2>Complete plumbing &amp; sanitary deliverables.</h2>
      </div>

      <div class="deliverables-grid reveal-group">
        {service.deliverables.map((d, idx) => (
          <article class="deliverable-card">
            <span class="deliv-idx">{String(idx + 1).padStart(2, '0')}</span>
            <h3>{d.title}</h3>
            <p>{d.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PROJECTS -->
  <section class="section section-paper">
    <div class="container">
      <div class="section-header section-header-left">
        <span class="eyebrow">Delivered excellence</span>
        <h2>Selected plumbing &amp; drainage deliveries in the UAE.</h2>
      </div>

      <div class="projects-list">
        {relevantProjects.map((p, i) => (
          <article class="project-row">
            <span class="p-index">{String(i + 1).padStart(2, '0')}</span>
            <div class="p-main">
              <div class="p-header">
                <span class="p-sector">{p.sectorLabel}</span>
                <span class="p-area"><Icon name="MapPin" size={12} /> {p.location}</span>
              </div>
              <h4>{p.name}</h4>
              <p class="p-client">{p.clientType}</p>
            </div>
            <p class="p-delivered">{p.delivered}</p>
          </article>
        ))}
      </div>

      <div class="list-cta">
        <a href="/projects" class="btn btn-secondary">Explore completed project case studies <Icon name="ArrowRight" size={15} /></a>
      </div>
    </div>
  </section>

  <!-- SITE PHOTOS -->
  <section class="section section-ink" id="site-photos">
    <div class="container">
      <div class="section-header section-header-left">
        <span class="eyebrow light">Photographic proof</span>
        <h2>On-site plumbing execution.</h2>
        <p>Direct field documentation of our DEWA smart water meter cabinets, multi-tenant ultrasonic meter manifolds, commercial utility risers, and booster stations in Dubai.</p>
      </div>

      <div class="site-photos-grid">
        {plumbingPhotos.map((photo) => (
          <article class="site-photo-card">
            <div class="photo-img-wrap">
              <img src={photo.image} alt={`${photo.title} by Abbadi Tech Dubai`} loading="lazy" width="500" height="380" class="photo-img" />
              <span class="photo-loc-badge"><Icon name="MapPin" size={11} /> {photo.location}</span>
            </div>
            <div class="photo-body">
              <h4>{photo.title}</h4>
              <p>{photo.description}</p>
              <div class="photo-tags">
                {photo.tags.slice(0, 3).map(tag => (<span class="p-tag">{tag}</span>))}
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="list-cta">
        <a href="/gallery" class="btn btn-outline-white"><Icon name="LayoutGrid" size={16} /> View all 16+ verified work photos</a>
      </div>
    </div>
  </section>

  <FAQSection
    title="Frequently asked questions about plumbing contracting in Dubai"
    subtitle="Direct answers on piping materials, hydrostatic pressure tests, and booster pump installations."
    badge="Plumbing & drainage"
    faqs={pageFaqs}
  />

  <!-- CTA -->
  <section class="section section-ivory">
    <div class="container">
      <div class="cta-inner-card">
        <span class="eyebrow">Schedule an inspection</span>
        <h2>Schedule a technical plumbing inspection.</h2>
        <p>Whether you require luxury sanitary rough-ins for a Dubai Mall boutique or an automated booster pumping station for a commercial building, consult our lead engineers today.</p>
        <div class="cta-btns">
          <a href="/contact" class="btn btn-primary">Book a free site survey <Icon name="ArrowUpRight" size={16} /></a>
          <a href="https://wa.me/971505546943?text=Hi%20Abbadi%20Tech,%20I%20need%20a%20commercial%20plumbing%20quote" target="_blank" rel="noopener" class="btn btn-secondary"><Icon name="MessageSquare" size={16} /> Instant WhatsApp chat</a>
          <a href="tel:+971505546943" class="btn btn-outline"><Icon name="Phone" size={15} /> +971 50 554 6943</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .service-hero {
    position: relative;
    background: var(--ink-deep);
    color: var(--white);
    padding: clamp(2.75rem, 5vw, 4.5rem) 0 clamp(3rem, 5vw, 4.75rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }

  .hero-inner-container { position: relative; z-index: 2; }

  .crumb {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-heading);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 2.25rem;
  }

  .crumb a:hover { color: var(--brass-soft); }

  .hero-content {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: end;
  }

  .badges-row { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 1rem; }

  .live-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-heading);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--brass-soft);
    border: 1px solid rgba(180, 134, 76, 0.3);
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
  }

  .pulse-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--brass-soft); animation: pulseDot 2.4s ease-in-out infinite; }

  @keyframes pulseDot { 0%, 100% { opacity: 0.35; } 50% { opacity: 1; } }

  .service-hero h1 {
    color: var(--white);
    font-size: clamp(2.5rem, 5vw, 4.2rem);
    margin-bottom: 1.2rem;
    max-width: 20ch;
  }

  .hero-lead {
    font-size: clamp(0.98rem, 1.35vw, 1.08rem);
    color: rgba(255, 255, 255, 0.62);
    max-width: 64ch;
    line-height: 1.7;
    margin-bottom: 1.9rem;
  }

  .hero-actions { display: flex; gap: 0.7rem; flex-wrap: wrap; }

  .hero-meta { border-top: 1px solid rgba(255, 255, 255, 0.12); }

  .meta-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.76rem;
  }

  .meta-row span { color: rgba(255, 255, 255, 0.38); text-transform: uppercase; letter-spacing: 0.08em; font-family: var(--font-heading); font-size: 0.6rem; }
  .meta-row strong { color: var(--white); font-weight: 500; text-align: right; }

  .section-paper { background: var(--paper); }
  .section-ivory { background: var(--ivory); }

  .benefits-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; }

  .benefit-item-card {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    transition: border-color 0.28s, box-shadow 0.28s;
  }

  .benefit-item-card:hover { border-color: var(--line-strong); box-shadow: var(--shadow-subtle); }

  .benefit-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    border-radius: 8px;
    border: 1px solid rgba(47, 110, 104, 0.3);
    background: rgba(47, 110, 104, 0.08);
    color: var(--teal);
  }

  .benefit-item-card p { font-size: 0.88rem; line-height: 1.6; color: var(--stone); }

  .deliverables-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }

  .deliverable-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    transition: transform 0.28s var(--ease-out), border-color 0.28s, box-shadow 0.28s;
  }

  .deliverable-card:hover { transform: translateY(-4px); border-color: var(--line-strong); box-shadow: var(--shadow-md); }

  .deliv-idx { display: block; font-family: var(--font-display); font-size: 1rem; color: var(--teal); margin-bottom: 0.75rem; }
  .deliverable-card h3 { font-family: var(--font-heading); font-size: 0.98rem; font-weight: 600; color: var(--ink); margin-bottom: 0.45rem; }
  .deliverable-card p { font-size: 0.82rem; color: var(--stone); line-height: 1.6; }

  .projects-list { border-top: 1px solid var(--line); }

  .project-row {
    display: grid;
    grid-template-columns: 2.5rem 1fr 0.9fr;
    gap: 1.5rem;
    align-items: start;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--line);
  }

  .p-index { font-family: var(--font-display); font-size: 0.9rem; color: var(--teal); padding-top: 0.15rem; }

  .p-header { display: flex; align-items: center; gap: 0.9rem; flex-wrap: wrap; margin-bottom: 0.35rem; }
  .p-sector { font-family: var(--font-heading); font-size: 0.6rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--brass-deep); }
  .p-area { display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.7rem; color: var(--stone-light); }

  .project-row h4 { font-family: var(--font-heading); font-size: 1.05rem; font-weight: 600; color: var(--ink); margin-bottom: 0.15rem; }
  .p-client { font-size: 0.78rem; color: var(--stone-light); font-style: italic; }
  .p-delivered { font-size: 0.8rem; color: var(--stone); line-height: 1.55; padding-top: 0.3rem; }

  .list-cta { margin-top: 2rem; text-align: center; }

  .section-ink { background: var(--ink); }
  .section-ink .section-header p { color: rgba(255, 255, 255, 0.5); }
  .section-ink .section-header h2 { color: var(--white); }

  .site-photos-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }

  .site-photo-card {
    background: var(--ink-2);
    border: 1px solid var(--ink-line);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s var(--ease-out), border-color 0.3s;
  }

  .site-photo-card:hover { transform: translateY(-4px); border-color: rgba(47, 110, 104, 0.5); }

  .photo-img-wrap { position: relative; aspect-ratio: 4/3; overflow: hidden; background: #000; }
  .photo-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s var(--ease-out); }
  .site-photo-card:hover .photo-img { transform: scale(1.04); }

  .photo-loc-badge {
    position: absolute;
    bottom: 0.65rem;
    left: 0.65rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: rgba(8, 18, 23, 0.72);
    backdrop-filter: blur(6px);
    color: var(--white);
    font-size: 0.66rem;
    font-weight: 500;
    padding: 0.25rem 0.55rem;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.14);
  }

  .photo-body { padding: 1.15rem; display: flex; flex-direction: column; flex: 1; }
  .photo-body h4 { font-family: var(--font-heading); font-size: 0.9rem; font-weight: 600; color: var(--white); margin-bottom: 0.35rem; line-height: 1.4; }
  .photo-body p { font-size: 0.78rem; color: rgba(255, 255, 255, 0.48); line-height: 1.55; margin-bottom: 0.9rem; flex: 1; }
  .photo-tags { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .p-tag { font-size: 0.62rem; color: rgba(255, 255, 255, 0.5); background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.08); padding: 0.18rem 0.45rem; border-radius: 5px; }

  .cta-inner-card {
    background: var(--ink);
    border: 1px solid var(--ink-line);
    border-radius: var(--radius-xl);
    padding: clamp(2rem, 5vw, 4rem);
    text-align: center;
  }

  .cta-inner-card .eyebrow { color: var(--brass-soft); }
  .cta-inner-card h2 { color: var(--white); font-size: clamp(2rem, 3.6vw, 3rem); margin: 1rem auto 0.9rem; max-width: 20ch; }
  .cta-inner-card p { color: rgba(255, 255, 255, 0.55); font-size: 0.95rem; line-height: 1.7; max-width: 64ch; margin: 0 auto 1.75rem; }
  .cta-btns { display: flex; justify-content: center; gap: 0.7rem; flex-wrap: wrap; }
  .cta-btns .btn-outline { border-color: rgba(255, 255, 255, 0.24); color: var(--white); }

  @media (max-width: 1024px) {
    .hero-content { grid-template-columns: 1fr; }
    .hero-meta { max-width: 560px; }
    .deliverables-grid { grid-template-columns: 1fr 1fr; }
    .site-photos-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 760px) {
    .benefits-grid { grid-template-columns: 1fr; }
    .project-row { grid-template-columns: 2rem 1fr; }
    .p-delivered { grid-column: 2; padding-top: 0; }
  }

  @media (max-width: 600px) {
    .service-hero h1 { font-size: clamp(2.1rem, 10vw, 2.9rem); }
    .deliverables-grid { grid-template-columns: 1fr; }
    .site-photos-grid { grid-template-columns: 1fr; }
  }
</style>
