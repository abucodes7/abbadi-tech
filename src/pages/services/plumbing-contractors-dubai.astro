---
import Layout from '../../layouts/Layout.astro';
import FAQSection from '../../components/FAQSection.astro';
import Icon from '../../components/Icon.astro';
import { servicesData } from '../../data/services';
import { projectsList } from '../../data/projects';
import { galleryItems } from '../../data/gallery';

const service = servicesData.find(s => s.id === 'plumbing')!;

const pageTitle = service.metaTitle;
const pageDescription = service.metaDescription;

const relevantProjects = projectsList
  .filter(p => p.scope === 'plumbing' || p.scope === 'both')
  .slice(0, 8);

const plumbingPhotos = galleryItems
  .filter(item => item.trade === 'Plumbing Technical Work')
  .slice(0, 6);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.abbaditech.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Services",
      "item": "https://www.abbaditech.com/services"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": service.title,
      "item": `https://www.abbaditech.com/services/${service.slug}`
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.title,
  "serviceType": "Plumbing & Sanitary Drainage Contracting",
  "provider": {
    "@type": "LocalBusiness",
    "name": "Abbadi Tech LLC",
    "telephone": "+971505546943",
    "url": "https://www.abbaditech.com/"
  },
  "areaServed": ["Dubai", "Abu Dhabi", "Ajman"],
  "description": service.overview
};

const pageFaqs = service.faqs;
---

<Layout 
  title={pageTitle} 
  description={pageDescription} 
  currentPath={`/services/${service.slug}`}
  jsonLd={[breadcrumbSchema, serviceSchema]}
>
  <!-- SERVICE HERO -->
  <section class="service-hero">
    <div class="container">
      <div class="crumb">
        <a href="/">Home</a> <span>/</span> <a href="/services">Services</a> <span>/</span> <span>{service.title}</span>
      </div>

      <div class="hero-content">
        <div class="badges-row">
          <span class="badge badge-blue"><Icon name="Droplets" size={13} /> Commercial &amp; Luxury Sanitary Engineering</span>
          <span class="badge badge-gold">Established 2005</span>
        </div>

        <h1>{service.heroH1}</h1>

        <p class="hero-lead">
          {service.overview}
        </p>

        <div class="hero-actions">
          <a href="/contact" class="btn btn-plumbing">
            Request Plumbing Site Survey
          </a>
          <a href={`https://wa.me/971505546943?text=${encodeURIComponent("Hello Abbadi Tech, I need a plumbing contractor for a project in Dubai.")}`} target="_blank" rel="noopener" class="btn btn-secondary">
            <Icon name="MessageSquare" size={16} /> WhatsApp Lead Plumber
          </a>
          <a href="tel:+971505546943" class="btn btn-outline-white">
            <Icon name="Phone" size={16} /> +971 50 554 6943
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- KEY BENEFITS -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-blue">Plumbing Reliability</span>
        <h2>High-Spec Potable Water &amp; Drainage Engineering</h2>
        <p class="section-sub">
          We install premium piping materials and precision pressure controls to ensure leak-free operation, acoustic isolation, and municipal health code compliance.
        </p>
      </div>

      <div class="benefits-grid">
        {service.keyBenefits.map((b) => (
          <div class="benefit-item-card">
            <div class="benefit-check"><Icon name="CheckCircle2" size={18} color="#10b981" /></div>
            <p>{b}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CORE DELIVERABLES -->
  <section class="section bg-card-section">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-gold">Scope of Works</span>
        <h2>Complete Plumbing &amp; Sanitary Deliverables</h2>
      </div>

      <div class="deliverables-grid">
        {service.deliverables.map((d, idx) => (
          <div class="deliverable-card">
            <span class="deliv-idx">0{idx + 1}</span>
            <h3>{d.title}</h3>
            <p>{d.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURED PROJECTS IN THIS DISCIPLINE -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-blue">Delivered Excellence</span>
        <h2>Selected Plumbing &amp; Drainage Deliveries in the UAE</h2>
      </div>

      <div class="projects-mini-grid">
        {relevantProjects.map((p) => (
          <div class="project-card">
            <div class="p-header">
              <span class="p-sector">{p.sectorLabel}</span>
              <span class="p-area">{p.location}</span>
            </div>
            <h4>{p.name}</h4>
            <p class="p-client">{p.clientType}</p>
            <p class="p-delivered"><strong>Delivered:</strong> {p.delivered}</p>
          </div>
        ))}
      </div>

      <div class="center-btn" style="margin-top:2.5rem; text-align:center;">
        <a href="/projects" class="btn btn-secondary">Explore All 57+ Completed Projects →</a>
      </div>
    </div>
  </section>

  <!-- ON-SITE PLUMBING EXECUTION PHOTOS -->
  <section class="section bg-card-section" id="site-photos">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-gold"><Icon name="Camera" size={13} /> Photographic Proof</span>
        <h2>On-Site Plumbing Technical Execution</h2>
        <p class="section-sub">
          Direct field documentation of our DEWA smart water meter cabinets, multi-tenant ultrasonic meter manifolds, commercial utility risers, and booster stations in Dubai.
        </p>
      </div>

      <div class="site-photos-grid">
        {plumbingPhotos.map((photo) => (
          <div class="site-photo-card">
            <div class="photo-img-wrap">
              <img 
                src={photo.image} 
                alt={`${photo.title} by Abbadi Tech Dubai`} 
                loading="lazy" 
                width="500" 
                height="380" 
                class="photo-img"
              />
              <span class="photo-loc-badge"><Icon name="MapPin" size={11} /> {photo.location}</span>
            </div>
            <div class="photo-body">
              <h4>{photo.title}</h4>
              <p>{photo.description}</p>
              <div class="photo-tags">
                {photo.tags.slice(0, 3).map(tag => (
                  <span class="p-tag">{tag}</span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="center-btn" style="margin-top:2.5rem; text-align:center;">
        <a href="/gallery" class="btn btn-plumbing">
          <Icon name="Layers" size={16} /> View All 16+ Verified Work Photos in Gallery →
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ SECTION -->
  <FAQSection 
    title="Frequently Asked Questions About Plumbing Contracting in Dubai" 
    subtitle="Direct answers on piping materials, hydrostatic pressure tests, and booster pump installations."
    faqs={pageFaqs}
  />

  <!-- FINAL CTA -->
  <section class="section section-cta">
    <div class="container">
      <div class="cta-inner-card">
        <h2>Schedule a Technical Plumbing Inspection</h2>
        <p>Whether you require luxury sanitary rough-ins for a Dubai Mall boutique or an automated booster pumping station for a commercial building, consult our lead engineers today.</p>
        <div class="cta-btns">
          <a href="/contact" class="btn btn-plumbing">Book Free Site Survey</a>
          <a href="https://wa.me/971505546943?text=Hi%20Abbadi%20Tech,%20I%20need%20a%20commercial%20plumbing%20quote" target="_blank" rel="noopener" class="btn btn-secondary">
            <Icon name="MessageSquare" size={16} /> Instant WhatsApp Chat
          </a>
          <a href="tel:+971505546943" class="btn btn-outline-white">
            <Icon name="Phone" size={16} /> Call: +971 50 554 6943
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .service-hero {
    padding: 3.5rem 0 3rem;
    background: radial-gradient(circle at top right, rgba(2, 132, 199, 0.15) 0%, transparent 60%);
    border-bottom: 1px solid var(--border-subtle);
  }

  .crumb {
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-bottom: 1.25rem;
  }

  .crumb a {
    color: var(--text-muted);
  }

  .crumb a:hover {
    color: var(--primary);
  }

  .crumb span {
    margin: 0 0.35rem;
  }

  .badges-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.8rem;
  }

  .service-hero h1 {
    font-size: 2.5rem;
    color: #fff;
    margin-bottom: 1rem;
    max-width: 920px;
  }

  .hero-lead {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 820px;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-plumbing {
    background: linear-gradient(135deg, var(--plumbing) 0%, #0369a1 100%);
    color: #fff;
  }

  .btn-plumbing:hover {
    filter: brightness(1.1);
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .benefit-item-card {
    background: #111724;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .benefit-check {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(2, 132, 199, 0.15);
    color: var(--plumbing-light);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    flex-shrink: 0;
  }

  .benefit-item-card p {
    font-size: 0.95rem;
    color: var(--text-main);
    line-height: 1.5;
  }

  .bg-card-section {
    background: #0b0f18;
  }

  .deliverables-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .deliverable-card {
    background: #111724;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    position: relative;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .deliverable-card:hover {
    transform: translateY(-3px);
    border-color: var(--plumbing-light);
  }

  .deliv-idx {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    color: rgba(56, 189, 248, 0.4);
    font-weight: 700;
    margin-bottom: 0.5rem;
    display: block;
  }

  .deliverable-card h3 {
    font-size: 1.15rem;
    color: #fff;
    margin-bottom: 0.6rem;
  }

  .deliverable-card p {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.55;
  }

  .projects-mini-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .project-card {
    background: #111724;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }

  .p-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.78rem;
    margin-bottom: 0.5rem;
  }

  .p-sector {
    color: var(--plumbing-light);
    font-weight: 600;
  }

  .p-area {
    color: var(--text-dim);
  }

  .project-card h4 {
    font-size: 1.2rem;
    color: #fff;
    margin-bottom: 0.25rem;
  }

  .p-client {
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
    font-style: italic;
  }

  .p-delivered {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  .p-delivered strong {
    color: var(--text-main);
  }

  .btn-outline-white {
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #fff;
  }

  .btn-outline-white:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }

  .cta-inner-card {
    background: linear-gradient(135deg, #0e1e30 0%, #161e2e 100%);
    border: 1px solid rgba(56, 189, 248, 0.3);
    border-radius: var(--radius-lg);
    padding: 3.5rem;
    text-align: center;
  }

  .cta-inner-card h2 {
    font-size: 2.2rem;
    color: #fff;
    margin-bottom: 0.8rem;
  }

  .cta-inner-card p {
    font-size: 1.1rem;
    color: var(--text-muted);
    max-width: 650px;
    margin: 0 auto 2rem;
  }

  .cta-btns {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Site Photos Showcase */
  .site-photos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.75rem;
  }

  .site-photo-card {
    background: #111724;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .site-photo-card:hover {
    transform: translateY(-4px);
    border-color: var(--plumbing);
  }

  .photo-img-wrap {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    background: #000;
  }

  .photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .site-photo-card:hover .photo-img {
    transform: scale(1.05);
  }

  .photo-loc-badge {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-full);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .photo-body {
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .photo-body h4 {
    font-size: 1.15rem;
    color: #fff;
    margin-bottom: 0.5rem;
    line-height: 1.35;
  }

  .photo-body p {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin-bottom: 1rem;
    flex: 1;
  }

  .photo-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .p-tag {
    font-size: 0.72rem;
    color: var(--text-dim);
    background: var(--bg-subtle);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  @media (max-width: 992px) {
    .benefits-grid, .deliverables-grid, .projects-mini-grid, .site-photos-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .service-hero h1 {
      font-size: 1.85rem;
    }
  }
</style>
