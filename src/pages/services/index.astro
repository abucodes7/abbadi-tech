---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import FAQSection from '../../components/FAQSection.astro';
import HeroAnimation from '../../components/HeroAnimation.astro';
import { servicesData } from '../../data/services';
import { servicesIndexFaqs } from '../../data/faq';

const pageTitle = "MEP, Electrical & Plumbing Contractors Dubai | Abbadi Tech";
const pageDescription = "Turnkey electrical, commercial plumbing & DEWA approval services across Dubai since 2005. MDB panels, pump stations & fit-outs. Call +971 50 554 6943.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.abbaditech.com/" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.abbaditech.com/services" }
  ]
};

const sectors = [
  { icon: "ShoppingBag", title: "Retail & boutiques", body: "Dubai Mall, Marina Mall, high-CRI lighting, luxury washrooms." },
  { icon: "UtensilsCrossed", title: "F&B restaurants", body: "Subway, Bianca, Leto Cafe, commercial gas & grease interceptors." },
  { icon: "Building2", title: "Offices & banks", body: "HSBC, ADCB, Pro League HQ, server dual-UPS & power layouts." },
  { icon: "Hotel", title: "Hotels & hospitality", body: "Shangri-La, Radisson Blu, Crowne Plaza, central heating & booster sets." },
  { icon: "Home", title: "Luxury villas", body: "Palm Jumeirah, Emirates Hills, smart home panels & solar hot water." },
  { icon: "Factory", title: "Industrial warehouses", body: "Al Quoz, DIP, Al Ramool 10-unit complex, heavy 3-phase busbars." }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  currentPath="/services"
  jsonLd={breadcrumbSchema}
>
  <!-- HERO -->
  <section class="services-hub-hero">
    <HeroAnimation />
    <div class="container hero-inner-container">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><span>Services</span>
      </nav>

      <div class="hero-split">
        <div class="hero-copy">
          <span class="eyebrow">Turnkey engineering capabilities</span>
          <h1>Electrical &amp; plumbing contracting, engineered end to end.</h1>
          <p class="hero-lead">
            Trusted across Dubai since 2005, Abbadi Tech LLC provides end-to-end electrical and plumbing contracting and DEWA approval services for luxury retail, commercial dining, high-rise towers, and private villas.
          </p>
          <div class="hero-cta-bar">
            <a href="/contact" class="btn btn-primary">Request a free technical survey <Icon name="ArrowUpRight" size={16} /></a>
            <a href="https://wa.me/971505546943?text=Hi%20Abbadi%20Tech,%20I%20have%20an%20inquiry%20regarding%20electrical%20and%20plumbing%20services" target="_blank" rel="noopener" class="btn btn-outline-white">
              <Icon name="MessageSquare" size={16} /> Instant WhatsApp chat
            </a>
          </div>
        </div>

        <div class="hero-index">
          <span class="index-title">Capability index</span>
          <a href="/services/electrical-contractors-dubai" class="index-row">
            <span class="index-num">01</span>
            <span class="index-name">Electrical works &amp; DEWA</span>
            <Icon name="ArrowUpRight" size={15} />
          </a>
          <a href="/services/plumbing-contractors-dubai" class="index-row">
            <span class="index-num">02</span>
            <span class="index-name">Plumbing &amp; drainage</span>
            <Icon name="ArrowUpRight" size={15} />
          </a>
          <a href="/dewa-approvals-dubai" class="index-row">
            <span class="index-num">03</span>
            <span class="index-name">DEWA approvals</span>
            <Icon name="ArrowUpRight" size={15} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CORE SERVICES -->
  <section class="section section-paper services-showcase">
    <div class="container">
      <div class="section-header section-header-left">
        <span class="eyebrow">Dedicated disciplines</span>
        <h2>Two trades. One accountable contractor.</h2>
        <p>Each technical trade is engineered in-house by licensed technicians with full DEWA and Dubai Municipality compliance.</p>
      </div>

      <div class="services-showcase-grid">
        {servicesData.map((service, index) => (
          <article class:list={["service-feature-card", index % 2 === 1 && "is-alt"]}>
            <div class="card-top">
              <span class="service-icon-box"><Icon name={service.icon} size={26} /></span>
              <span class="service-num">0{index + 1}</span>
            </div>

            <div class="card-content">
              <h3>{service.title}</h3>
              <p class="tagline-text">{service.tagline}</p>
              <p class="overview-text">{service.overview}</p>

              <div class="key-deliverables-box">
                <h4>Key capabilities</h4>
                <ul>
                  {service.keyBenefits.slice(0, 4).map((b) => (<li>{b}</li>))}
                </ul>
              </div>

              <div class="card-actions">
                <a href={`/services/${service.slug}`} class="btn btn-primary btn-sm">
                  View full service details <Icon name="ArrowRight" size={14} />
                </a>
                <a href={`https://wa.me/971505546943?text=Hi%20Abbadi%20Tech,%20I%20need%20a%20quote%20for%20${encodeURIComponent(service.title)}`} target="_blank" rel="noopener" class="btn btn-outline btn-sm">
                  <Icon name="MessageSquare" size={14} /> Quote
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <a href="/dewa-approvals-dubai" class="dewa-strip">
        <div class="dewa-strip-copy">
          <span class="eyebrow light">Authority coordination</span>
          <h3>DEWA approvals, handled by the engineers who install the works.</h3>
        </div>
        <span class="dewa-strip-cta">Explore DEWA approvals <Icon name="ArrowUpRight" size={16} /></span>
      </a>
    </div>
  </section>

  <!-- SECTORS -->
  <section class="section section-ivory sectors-section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Proven experience</span>
        <h2>Technical integrity across every UAE sector.</h2>
      </div>

      <div class="sectors-mini-grid reveal-group">
        {sectors.map(sector => (
          <div class="s-card">
            <span class="s-icon"><Icon name={sector.icon} size={21} /></span>
            <h4>{sector.title}</h4>
            <p>{sector.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FAQSection
    title="Frequently asked questions about MEP contracting services"
    subtitle="Direct engineering answers regarding turnkey MEP scope, authority coordination, trade bundling, and testing."
    badge="Services & execution"
    faqs={servicesIndexFaqs}
  />

  <!-- CTA -->
  <section class="section section-ink">
    <div class="container">
      <div class="cta-inner-card">
        <span class="eyebrow light">Start with a survey</span>
        <h2>Need multi-disciplinary MEP contracting in Dubai?</h2>
        <p>From initial design load schedules to DEWA meter connection and testing, our senior project managers ensure your fit-out opens on time.</p>
        <div class="cta-btns">
          <a href="/contact" class="btn btn-primary">Book a free site survey <Icon name="ArrowUpRight" size={16} /></a>
          <a href="tel:+971505546943" class="btn btn-outline-white">Call +971 50 554 6943</a>
          <a href="/projects" class="btn btn-outline-white">Browse 1,000+ UAE projects</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .services-hub-hero {
    position: relative;
    background: var(--ink-deep);
    color: var(--white);
    padding: clamp(2.75rem, 5vw, 4.5rem) 0 clamp(3rem, 5vw, 4.5rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }

  .hero-inner-container { position: relative; z-index: 2; }

  .crumb {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-heading);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 2.25rem;
  }

  .crumb a:hover { color: var(--brass-soft); }

  .hero-split {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: end;
  }

  .hero-copy .eyebrow { color: var(--brass-soft); }

  .hero-copy h1 {
    color: var(--white);
    font-size: clamp(2.6rem, 5.4vw, 4.5rem);
    margin: 1rem 0 1.3rem;
    max-width: 19ch;
  }

  .hero-lead {
    font-size: clamp(1rem, 1.4vw, 1.1rem);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.62);
    max-width: 62ch;
    margin-bottom: 2rem;
  }

  .hero-cta-bar { display: flex; gap: 0.8rem; flex-wrap: wrap; }

  .hero-index { border-top: 1px solid rgba(255, 255, 255, 0.12); }

  .index-title {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
    padding: 0.9rem 0;
  }

  .index-row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.95rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--white);
    transition: padding 0.28s var(--ease-out), color 0.24s;
  }

  .index-row:hover { padding-left: 0.4rem; color: var(--brass-soft); }
  .index-num { font-family: var(--font-display); font-size: 0.85rem; color: var(--brass); width: 1.6rem; flex-shrink: 0; }
  .index-name { flex: 1; font-family: var(--font-heading); font-size: 0.9rem; font-weight: 500; }
  .index-row svg { color: var(--brass-soft); }

  .section-paper { background: var(--paper); }
  .section-ivory { background: var(--ivory); }

  .services-showcase-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }

  .service-feature-card {
    background: var(--ivory);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3vw, 2.4rem);
    display: flex;
    flex-direction: column;
    transition: transform 0.3s var(--ease-out), border-color 0.3s, box-shadow 0.3s;
  }

  .service-feature-card:hover { transform: translateY(-5px); border-color: var(--line-strong); box-shadow: var(--shadow-md); }

  .card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }

  .service-icon-box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 13px;
    border: 1px solid rgba(180, 134, 76, 0.3);
    background: var(--brass-wash);
    color: var(--brass-deep);
  }

  .service-num { font-family: var(--font-display); font-size: 2rem; color: var(--line-strong); line-height: 1; }

  .card-content h3 { font-family: var(--font-heading); font-size: clamp(1.3rem, 2vw, 1.6rem); font-weight: 600; color: var(--ink); margin-bottom: 0.3rem; }

  .tagline-text { font-family: var(--font-heading); font-size: 0.76rem; font-weight: 600; letter-spacing: 0.02em; color: var(--brass-deep); margin-bottom: 1rem; }

  .overview-text { font-size: 0.9rem; color: var(--stone); line-height: 1.7; margin-bottom: 1.4rem; }

  .key-deliverables-box { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-md); padding: 1.1rem 1.15rem; margin-bottom: 1.5rem; }
  .key-deliverables-box h4 { font-family: var(--font-heading); font-size: 0.6rem; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase; color: var(--stone-light); margin-bottom: 0.7rem; }
  .key-deliverables-box ul { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
  .key-deliverables-box li { position: relative; padding-left: 1.1rem; font-size: 0.82rem; line-height: 1.45; color: var(--stone); }
  .key-deliverables-box li::before { content: ''; position: absolute; left: 0; top: 0.4rem; width: 5px; height: 8px; border: solid var(--brass); border-width: 0 1.5px 1.5px 0; transform: rotate(45deg); }

  .card-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: auto; }

  .dewa-strip {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding: clamp(1.5rem, 3vw, 2.2rem);
    background: var(--ink);
    border-radius: var(--radius-lg);
    color: var(--white);
    transition: background 0.3s;
  }

  .dewa-strip:hover { background: var(--ink-2); }
  .dewa-strip h3 { font-family: var(--font-display); font-size: clamp(1.3rem, 2vw, 1.7rem); font-weight: 400; color: var(--white); margin-top: 0.5rem; max-width: 46ch; }
  .dewa-strip-cta { display: inline-flex; align-items: center; gap: 0.45rem; font-family: var(--font-heading); font-size: 0.82rem; font-weight: 600; color: var(--brass-soft); white-space: nowrap; }
  .dewa-strip:hover .dewa-strip-cta { color: var(--white); }

  .sectors-section { border-top: 1px solid var(--line); }
  .sectors-mini-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }

  .s-card { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-md); padding: 1.35rem; transition: transform 0.28s var(--ease-out), border-color 0.28s; }
  .s-card:hover { transform: translateY(-4px); border-color: var(--line-strong); }

  .s-icon { display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; border-radius: 10px; border: 1px solid var(--line); background: var(--ivory); color: var(--brass-deep); margin-bottom: 0.9rem; }
  .s-card h4 { font-family: var(--font-heading); font-size: 0.94rem; font-weight: 600; color: var(--ink); margin-bottom: 0.3rem; }
  .s-card p { font-size: 0.79rem; line-height: 1.5; color: var(--stone); }

  .section-ink { background: var(--ink); }

  .cta-inner-card {
    background: var(--ink-2);
    border: 1px solid var(--ink-line);
    border-radius: var(--radius-xl);
    padding: clamp(2rem, 5vw, 4rem);
    text-align: center;
  }

  .cta-inner-card .eyebrow { color: var(--brass-soft); }
  .cta-inner-card h2 { color: var(--white); font-size: clamp(2rem, 3.6vw, 3rem); margin: 1rem auto 0.9rem; max-width: 22ch; }
  .cta-inner-card p { color: rgba(255, 255, 255, 0.55); font-size: 0.95rem; line-height: 1.7; max-width: 66ch; margin: 0 auto 1.75rem; }
  .cta-btns { display: flex; justify-content: center; gap: 0.7rem; flex-wrap: wrap; }

  @media (max-width: 1024px) {
    .hero-split { grid-template-columns: 1fr; }
    .hero-index { max-width: 560px; }
    .services-showcase-grid { grid-template-columns: 1fr; }
    .sectors-mini-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 600px) {
    .hero-copy h1 { font-size: clamp(2.2rem, 10.5vw, 3rem); }
    .sectors-mini-grid { grid-template-columns: 1fr; }
    .dewa-strip { flex-direction: column; align-items: flex-start; }
  }
</style>
