---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import FAQSection from '../../components/FAQSection.astro';
import HeroAnimation from '../../components/HeroAnimation.astro';
import { servicesData } from '../../data/services';
import { servicesIndexFaqs } from '../../data/faq';

const pageTitle = "Electrical & Plumbing Contractors Dubai | Abbadi Tech LLC";
const pageDescription = "Explore Abbadi Tech's core contracting services in Dubai: DEWA electrical works, MDB panels, and commercial plumbing & drainage engineering.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.abbaditech.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Services",
      "item": "https://www.abbaditech.com/services"
    }
  ]
};
---

<Layout 
  title={pageTitle} 
  description={pageDescription} 
  currentPath="/services"
  jsonLd={breadcrumbSchema}
>
  <!-- SERVICES HUB HERO -->
  <section class="services-hub-hero">
    <HeroAnimation />
    <div class="container hero-inner-container">
      <div class="crumb">
        <a href="/">Home</a> <span>/</span> <span>Services</span>
      </div>

      <div class="hero-inner">
        <span class="badge badge-gold">Turnkey Engineering Capabilities</span>
        <h1>CERTIFIED ELECTRICAL &amp; PLUMBING SERVICES IN DUBAI &amp; THE UAE</h1>
        <p class="hero-lead">
          Trusted across Dubai since 2005, Abbadi Tech LLC provides end-to-end electrical and plumbing contracting and DEWA approval services for luxury retail, commercial dining, high-rise towers, and private villas.
        </p>

        <div class="hero-cta-bar">
          <a href="/contact" class="btn btn-primary">Request Free Technical Survey</a>
          <a href="https://wa.me/971505546943?text=Hi%20Abbadi%20Tech,%20I%20have%20an%20inquiry%20regarding%20electrical%20and%20plumbing%20services" target="_blank" rel="noopener" class="btn btn-secondary">
            <Icon name="MessageSquare" size={16} /> Instant WhatsApp Chat
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES SHOWCASE GRID -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-blue">Dedicated Disciplines</span>
        <h2>Explore Our Core Contracting Services</h2>
        <p class="section-sub">
          Each technical trade is engineered in-house by licensed technicians with full DEWA and Dubai Municipality compliance.
        </p>
      </div>

      <div class="services-showcase-grid">
        {servicesData.map((service, index) => (
          <div class="service-feature-card">
            <div class="card-top">
              <div class="service-icon-box">
                <Icon name={service.icon} size={28} />
              </div>
              <span class="service-num">0{index + 1}</span>
            </div>

            <div class="card-content">
              <h3>{service.title}</h3>
              <p class="tagline-text">{service.tagline}</p>
              <p class="overview-text">{service.overview}</p>

              <div class="key-deliverables-box">
                <h4>Key Capabilities:</h4>
                <ul>
                  {service.keyBenefits.slice(0, 4).map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </div>

              <div class="card-actions">
                <a href={`/services/${service.slug}`} class="btn btn-primary btn-sm">
                  View Full Service Details →
                </a>
                <a href={`https://wa.me/971505546943?text=Hi%20Abbadi%20Tech,%20I%20need%20a%20quote%20for%20${encodeURIComponent(service.title)}`} target="_blank" rel="noopener" class="btn btn-outline-white btn-sm">
                  <Icon name="MessageSquare" size={14} /> Quote
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTORS COVERED -->
  <section class="section bg-card-section">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-gold">Proven Experience</span>
        <h2>Delivering Technical Integrity Across All UAE Sectors</h2>
      </div>

      <div class="sectors-mini-grid">
        <div class="s-card">
          <span class="s-icon"><Icon name="ShoppingBag" size={24} color="#FF9500" /></span>
          <h4>Retail &amp; Boutiques</h4>
          <p>Dubai Mall, Marina Mall, high-CRI lighting, luxury washrooms.</p>
        </div>
        <div class="s-card">
          <span class="s-icon"><Icon name="UtensilsCrossed" size={24} color="#FF9500" /></span>
          <h4>F&amp;B Restaurants</h4>
          <p>Subway, Bianca, Leto Cafe, commercial gas &amp; grease interceptors.</p>
        </div>
        <div class="s-card">
          <span class="s-icon"><Icon name="Building2" size={24} color="#FF9500" /></span>
          <h4>Offices &amp; Banks</h4>
          <p>HSBC, ADCB, Pro League HQ, server dual-UPS &amp; power layouts.</p>
        </div>
        <div class="s-card">
          <span class="s-icon"><Icon name="Hotel" size={24} color="#FF9500" /></span>
          <h4>Hotels &amp; Hospitality</h4>
          <p>Shangri-La, Radisson Blu, Crowne Plaza, central heating &amp; booster sets.</p>
        </div>
        <div class="s-card">
          <span class="s-icon"><Icon name="Home" size={24} color="#FF9500" /></span>
          <h4>Luxury Villas</h4>
          <p>Palm Jumeirah, Emirates Hills, smart home panels &amp; solar hot water.</p>
        </div>
        <div class="s-card">
          <span class="s-icon"><Icon name="Factory" size={24} color="#FF9500" /></span>
          <h4>Industrial Warehouses</h4>
          <p>Al Quoz, DIP, Al Ramool 10-unit complex, heavy 3-phase busbars.</p>
        </div>
      </div>
    </div>
  </section>


  <!-- FAQ SECTION -->
  <FAQSection 
    title="Frequently Asked Questions About MEP Contracting Services" 
    subtitle="Direct engineering answers regarding turnkey MEP scope, authority coordination, trade bundling, and testing."
    badge="Services & Execution FAQ"
    faqs={servicesIndexFaqs}
  />

  <!-- CTA -->
  <section class="section section-cta">
    <div class="container">
      <div class="cta-inner-card">
        <h2>Need Multi-Disciplinary MEP Contracting in Dubai?</h2>
        <p>From initial design load schedules to DEWA meter connection and testing, our senior project managers ensure your fit-out opens on time.</p>
        <div class="cta-btns">
          <a href="/contact" class="btn btn-primary">Book Free Site Survey</a>
          <a href="tel:+971505546943" class="btn btn-secondary">Call +971 50 554 6943</a>
          <a href="/projects" class="btn btn-outline-white">Browse 1000+ UAE Projects</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .services-hub-hero {
    position: relative;
    padding: 5rem 0 4rem;
    background: var(--color-navy-dark);
    border-bottom: 1px solid var(--color-navy-border);
    overflow: hidden;
  }

  .hero-inner-container {
    position: relative;
    z-index: 2;
  }

  .crumb {
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-bottom: 1.25rem;
  }

  .crumb a {
    color: var(--text-muted);
  }

  .crumb a:hover {
    color: var(--primary);
  }

  .crumb span {
    margin: 0 0.35rem;
  }

  .hero-inner h1 {
    font-size: 2.4rem;
    color: #fff;
    margin-top: 0.8rem;
    margin-bottom: 1rem;
    max-width: 900px;
  }

  .hero-lead {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 820px;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .hero-cta-bar {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .services-showcase-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .service-feature-card {
    background: #111724;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .service-feature-card:hover {
    transform: translateY(-4px);
    border-color: var(--primary);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .service-icon-box {
    font-size: 2.5rem;
    width: 65px;
    height: 65px;
    background: #182030;
    border: 1px solid rgba(255, 149, 0, 0.3);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .service-num {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.12);
  }

  .card-content h3 {
    font-size: 1.5rem;
    color: #fff;
    margin-bottom: 0.35rem;
  }

  .tagline-text {
    font-size: 0.88rem;
    color: var(--primary);
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .overview-text {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .key-deliverables-box {
    background: #0d121d;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius-sm);
    padding: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .key-deliverables-box h4 {
    font-size: 0.85rem;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .key-deliverables-box ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .key-deliverables-box li {
    font-size: 0.85rem;
    color: var(--text-muted);
    position: relative;
    padding-left: 1.25rem;
    line-height: 1.4;
  }

  .key-deliverables-box li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.35rem;
    width: 5px;
    height: 8px;
    border: solid var(--primary);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .card-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: auto;
  }

  .btn-outline-white {
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #fff;
  }

  .btn-outline-white:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }

  .bg-card-section {
    background: #0b0f18;
  }

  .sectors-mini-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .s-card {
    background: #111724;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }

  .s-icon {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    display: block;
  }

  .s-card h4 {
    font-size: 1.1rem;
    color: #fff;
    margin-bottom: 0.4rem;
  }

  .s-card p {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .cta-inner-card {
    background: linear-gradient(135deg, #161e2e 0%, #1e1b18 100%);
    border: 1px solid rgba(255, 149, 0, 0.3);
    border-radius: var(--radius-lg);
    padding: 3.5rem;
    text-align: center;
  }

  .cta-inner-card h2 {
    font-size: 2.2rem;
    color: #fff;
    margin-bottom: 0.8rem;
  }

  .cta-inner-card p {
    font-size: 1.1rem;
    color: var(--text-muted);
    max-width: 650px;
    margin: 0 auto 2rem;
  }

  .cta-btns {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 992px) {
    .services-showcase-grid {
      grid-template-columns: 1fr;
    }

    .sectors-mini-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .hero-inner h1 {
      font-size: 1.85rem;
    }

    .sectors-mini-grid {
      grid-template-columns: 1fr;
    }

    .service-feature-card {
      padding: 1.75rem 1.25rem;
    }
  }
</style>
