---
import Layout from '../layouts/Layout.astro';
import FAQSection from '../components/FAQSection.astro';
import Icon from '../components/Icon.astro';
import HeroAnimation from '../components/HeroAnimation.astro';
import ElectricalCircuitDecor from '../components/ElectricalCircuitDecor.astro';
import { homeFaqs } from '../data/faq';
import { projectsList } from '../data/projects';
import { galleryItems } from '../data/gallery';

const pageTitle = "Abbadi Tech | Professional Electrical & Plumbing Services Dubai";
const pageDescription = "Reliable electrical and plumbing solutions built on trust. DEWA registered contractors in Dubai since 2005. Commercial fit-outs, MDB panels, piping, and 1,000+ completed projects.";

const featuredGallery = galleryItems.slice(0, 6);
const electricalProjects = projectsList.filter(p => p.scope === 'electrical').slice(0, 4);
const plumbingProjects = projectsList.filter(p => p.scope === 'plumbing' || p.scope === 'mep').slice(0, 4);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": homeFaqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};
---

<Layout 
  title={pageTitle} 
  description={pageDescription} 
  currentPath="/"
  jsonLd={faqSchema}
>
  <!-- ==========================================================================
       1. HERO SECTION: Split-Screen Editorial Image-Led Layout
       ========================================================================== -->
  <section class="hero-section">
    <HeroAnimation />
    <div class="container hero-container">
      <div class="hero-split">
        <!-- Left: Copy & Value Proposition -->
        <div class="hero-text-block">
          <!-- Trust Badge Row -->
          <div class="hero-badges reveal">
            <span class="live-status-pill"><span class="pulse-dot"></span> DEWA Registered Contractor</span>
            <span class="badge badge-amber"><Icon name="Zap" size={13} /> Lic. 571822</span>
            <span class="badge badge-white-on-navy"><Icon name="CheckCircle2" size={13} /> Established 2005</span>
          </div>

          <!-- Exact Headline Requested in Brief -->
          <h1 class="hero-title reveal stagger-1">
            Reliable Electrical &amp; Plumbing Solutions. <span class="hero-title-accent">Built on Trust.</span>
          </h1>

          <!-- Exact Supporting Copy Requested in Brief -->
          <p class="hero-lead reveal stagger-2">
            Professional electrical and plumbing services focused on quality workmanship, dependable solutions, and lasting customer confidence across Dubai and the UAE.
          </p>

          <!-- The 2 CTAs -->
          <div class="hero-cta-group reveal stagger-3">
            <a href="#quote-section" class="btn btn-primary btn-hero">
              Request a Quote
            </a>
            <a href="#services-pillars" class="btn btn-secondary btn-hero">
              Explore Our Services
            </a>
          </div>

          <!-- Trust Signals -->
          <div class="hero-trust-chips reveal stagger-4">
            <div class="trust-chip">
              <span class="chip-num">21+</span>
              <span class="chip-text">Years UAE Experience</span>
            </div>
            <div class="trust-chip-divider"></div>
            <div class="trust-chip">
              <span class="chip-num text-amber">DEWA</span>
              <span class="chip-text">Approved Contractor</span>
            </div>
            <div class="trust-chip-divider"></div>
            <div class="trust-chip">
              <span class="chip-num text-teal">1,000+</span>
              <span class="chip-text">Projects Completed</span>
            </div>
          </div>
        </div>

        <!-- Right: Editorial Image Composition with Authentic Field Work -->
        <div class="hero-media-block reveal stagger-2">
          <div class="hero-image-frame">
            <img 
              src="/images/gallery/electrical-panel-assembly.jpg" 
              alt="Professional electrical panel assembly and wiring by Abbadi Tech" 
              width="640" 
              height="480" 
              class="hero-primary-img" 
              loading="eager"
            />
            
            <!-- Floating Verified Craftsmanship Badge -->
            <div class="floating-field-card">
              <div class="ffc-icon">
                <Icon name="ShieldCheck" size={24} />
              </div>
              <div class="ffc-content">
                <strong>Certified In-House Engineers</strong>
                <span>DEWA &amp; DM Municipal Code Compliant</span>
              </div>
            </div>

            <!-- Floating Direct Callout -->
            <div class="floating-quote-pill">
              <span class="fqp-dot"></span>
              <span>Direct Estimations: <strong>+971 50 554 6943</strong></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================================================
       KEY TRUST BAR
       ========================================================================== -->
  <div class="trust-bar" aria-label="Key Trust Signals">
    <div class="container trust-bar-inner">
      <div class="trust-item">
        <span class="trust-icon"><Icon name="Calendar" size={20} /></span>
        <div>
          <strong>Since 2005</strong>
          <span>21+ Years Continuous UAE Operations</span>
        </div>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-item">
        <span class="trust-icon"><Icon name="Landmark" size={20} /></span>
        <div>
          <strong>DEWA Registered</strong>
          <span>Trade License No. 571822</span>
        </div>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-item">
        <span class="trust-icon"><Icon name="CheckCircle2" size={20} /></span>
        <div>
          <strong>1,000+ Projects Handed Over</strong>
          <span>Commercial, Residential &amp; Industrial</span>
        </div>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-item">
        <span class="trust-icon"><Icon name="MapPin" size={20} /></span>
        <div>
          <strong>Dubai &amp; UAE Coverage</strong>
          <span>Rapid Engineering Dispatch</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ==========================================================================
       2. SERVICES SECTION: Distinct but Visually Coordinated Pillars
       ========================================================================== -->
  <section class="section section-white" id="services-pillars" style="position: relative; overflow: hidden;">
    <ElectricalCircuitDecor variant="subtle" accent="blue" />
    <div class="container" style="position: relative; z-index: 1;">
      <div class="section-header">
        <span class="badge badge-navy">Our Specialized Disciplines</span>
        <h2>Core Technical Engineering Capabilities</h2>
        <p>
          We provide specialized electrical and plumbing services structured into two dedicated engineering divisions, delivering turnkey reliability from planning to testing and handover.
        </p>
      </div>

      <div class="service-pillars-grid">
        <!-- Pillar 1: Electrical Services (Amber Accent #F5A623) -->
        <div class="pillar-card electrical-pillar reveal">
          <div class="pillar-header">
            <div class="pillar-badge badge-amber">
              <Icon name="Zap" size={14} /> Electrical Services
            </div>
            <h3>Electrical Installations &amp; Power Infrastructure</h3>
            <p class="pillar-intro">
              Turnkey electrical engineering for commercial buildings, retail fit-outs, villas, and industrial facilities with complete DEWA compliance.
            </p>
          </div>

          <div class="pillar-image-wrap">
            <img 
              src="/images/gallery/abb-three-phase-db-panel-dressing.jpg" 
              alt="ABB Three Phase DB Panel Assembly by Abbadi Tech" 
              width="500" 
              height="300" 
              loading="lazy" 
              class="pillar-img"
            />
            <div class="pillar-img-overlay">
              <span>Authentic Project Photo: 3-Phase DB Panel Dressing</span>
            </div>
          </div>

          <ul class="pillar-services-list">
            <li>
              <strong>Electrical Installations &amp; Containment:</strong> Complete conduit runs, GI trunking, cable trays, and busbar trunking systems.
            </li>
            <li>
              <strong>Wiring &amp; Power Distribution:</strong> Safe circuit cabling, load balancing, sub-main feeder pulling, and industrial switchgear setup.
            </li>
            <li>
              <strong>Lighting Systems &amp; Controls:</strong> Architectural LED layouts, emergency lighting, central battery systems, and smart sensor zoning.
            </li>
            <li>
              <strong>MDB &amp; SMDB Panel Assembly:</strong> In-house panel dressing, ferruled wire numbering, breaker calibration, and busbar torque checks.
            </li>
            <li>
              <strong>Inspections &amp; Fault Diagnosis:</strong> Megger insulation resistance testing, thermal imaging, and short-circuit troubleshooting.
            </li>
            <li>
              <strong>DEWA Approvals &amp; Load Upgrades:</strong> Single Line Diagram (SLD) preparation, online portal submissions, and meter energization.
            </li>
          </ul>

          <div class="pillar-actions">
            <a href="/services/electrical-contractors-dubai" class="btn btn-outline-amber">
              Explore Electrical Services Details →
            </a>
            <a href="#quote-section" class="btn btn-primary">
              Request Electrical Quote
            </a>
          </div>
        </div>

        <!-- Pillar 2: Plumbing Services (Teal Accent #16A6A1) -->
        <div class="pillar-card plumbing-pillar reveal stagger-1">
          <div class="pillar-header">
            <div class="pillar-badge badge-teal">
              <Icon name="Droplets" size={14} /> Plumbing Services
            </div>
            <h3>Plumbing Installations &amp; Hydraulic Systems</h3>
            <p class="pillar-intro">
              Engineered sanitary, drainage, and water supply solutions ensuring zero leakage, high pressure stability, and hygiene code compliance.
            </p>
          </div>

          <div class="pillar-image-wrap">
            <img 
              src="/images/gallery/plumbing-ppr-pipework.jpg" 
              alt="High-pressure PPR and copper water distribution manifold by Abbadi Tech" 
              width="500" 
              height="300" 
              loading="lazy" 
              class="pillar-img"
            />
            <div class="pillar-img-overlay">
              <span>Authentic Project Photo: High-Pressure PPR Pipework</span>
            </div>
          </div>

          <ul class="pillar-services-list plumbing-list">
            <li>
              <strong>Water Supply &amp; Piping:</strong> Certified PPR hot/cold fusion welding, PEX manifolds, and copper piping for high durability.
            </li>
            <li>
              <strong>Drainage &amp; Waste Water Networks:</strong> UPVC and acoustic soil/waste pipes, grease trap installations, and vent line balancing.
            </li>
            <li>
              <strong>Leak Detection &amp; Pressure Testing:</strong> 10-bar hydrostatic line testing, ultrasonic acoustic detection, and pipe repairs.
            </li>
            <li>
              <strong>Booster &amp; Transfer Pump Stations:</strong> Dual-redundant variable frequency drive (VFD) pressure booster pumps and float controls.
            </li>
            <li>
              <strong>Sanitary Fixture Installation:</strong> Concealed cisterns, touchless faucets, commercial kitchen rough-ins, and luxury bathrooms.
            </li>
            <li>
              <strong>Preventive Maintenance &amp; Repairs:</strong> Annual maintenance contracts (AMC), periodic pipe flushing, and 24/7 emergency dispatch.
            </li>
          </ul>

          <div class="pillar-actions">
            <a href="/services/plumbing-contractors-dubai" class="btn btn-outline-teal">
              Explore Plumbing Services Details →
            </a>
            <a href="#quote-section" class="btn btn-teal">
              Request Plumbing Quote
            </a>
          </div>
        </div>
      </div>

      <!-- DEWA Approvals Dubai Subordinate Division Lead Callout -->
      <div class="dewa-portal-callout reveal">
        <div class="dpc-info">
          <div class="dpc-pill">
            <span class="pulse-dot"></span>
            <span>Lead Generation Division: dewaapprovalsdubai</span>
          </div>
          <h3>Fast-Track DEWA Approvals, Fit-Out NOCs &amp; Load Upgrades</h3>
          <p>
            Operating as our dedicated approvals division, <strong>DEWA Approvals Dubai</strong> manages online authority submissions, Single Line Diagram (SLD) engineering, and inspector handovers so your fit-out opens strictly on schedule.
          </p>
        </div>
        <div class="dpc-actions">
          <a href="/dewa-approvals-dubai" class="btn btn-primary">
            Visit DEWA Approvals Portal →
          </a>
          <a href="https://wa.me/971505546943?text=Hello%20DEWA%20Approvals%20Dubai,%20I%20need%20urgent%20approval%20support" target="_blank" rel="noopener" class="btn btn-secondary">
            <Icon name="MessageSquare" size={15} /> WhatsApp Approval Desk
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================================================
       3. ABOUT ABBADI TECH: Editorial-Style Company Introduction
       ========================================================================== -->
  <section class="section section-light" id="about-intro">
    <div class="container">
      <div class="about-editorial-grid">
        <div class="about-text-content reveal">
          <span class="badge badge-navy">About Abbadi Tech</span>
          <h2>Engineering Excellence Rooted in 21 Years of UAE Craftsmanship</h2>
          
          <p class="about-lead-p">
            Established in 2005 under Trade License No. 571822, <strong>Abbadi Tech Technical Solutions LLC</strong> was founded by Koyakutty Mohammed with a singular commitment: delivering uncompromised technical integrity in electrical and plumbing contracting.
          </p>
          
          <p>
            Over two decades in Dubai's demanding commercial and residential landscape, our reputation has been built on precision execution, strict adherence to DEWA regulations, and transparent engineering ethics. We never subcontract core MEP responsibilities—every cable pulled, panel dressed, and pipe welded is executed by our certified, in-house technical team.
          </p>

          <div class="about-pillars-row">
            <div class="apr-item">
              <Icon name="ShieldCheck" size={20} />
              <div>
                <strong>Uncompromising Safety</strong>
                <span>Civil Defence &amp; QHSE verified workflows</span>
              </div>
            </div>
            <div class="apr-item">
              <Icon name="Award" size={20} />
              <div>
                <strong>Authority Compliance</strong>
                <span>DEWA, ADDC, SEWA &amp; DM standards</span>
              </div>
            </div>
          </div>

          <div class="about-cta-row">
            <a href="/about" class="btn btn-navy">
              Read Our Full Company Story →
            </a>
            <a href="tel:+971505546943" class="btn btn-outline">
              <Icon name="Phone" size={15} /> Speak to Technical Director
            </a>
          </div>
        </div>

        <div class="about-visual-content reveal stagger-1">
          <div class="about-card-stack">
            <div class="stack-main-card">
              <img 
                src="/images/gallery/commercial-multi-tenant-water-meters.jpg" 
                alt="Multi-tenant water meter installation in Dubai by Abbadi Tech" 
                width="540" 
                height="380" 
                loading="lazy" 
                class="stack-img"
              />
              <div class="stack-caption">
                <strong>Certified Multi-Tenant Installation</strong>
                <span>Water meter manifolds and pressure regulation</span>
              </div>
            </div>

            <div class="stack-metric-card">
              <div class="smc-number">2005</div>
              <div class="smc-label">Established in Dubai</div>
              <div class="smc-sub">Over two decades of continuous delivery</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================================================
       4. WHY CHOOSE US: Verified Strengths
       ========================================================================== -->
  <section class="section section-white" id="why-choose-us">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-amber">Proven Advantages</span>
        <h2>Why Clients Trust Abbadi Tech</h2>
        <p>
          Our verified strengths reflect decades of practical site mastery, direct authority liaison, and transparent communication.
        </p>
      </div>

      <div class="why-us-grid">
        <div class="why-card reveal">
          <div class="why-icon-wrap amber"><Icon name="Zap" size={24} /></div>
          <h3>Registered DEWA Contractor</h3>
          <p>
            Direct authority portal access and verified relations with DEWA inspectors. We prepare, submit, and secure single-line diagram (SLD) approvals and load upgrades without red tape.
          </p>
        </div>

        <div class="why-card reveal stagger-1">
          <div class="why-icon-wrap teal"><Icon name="Droplets" size={24} /></div>
          <h3>Leak-Proof Hydraulic Standards</h3>
          <p>
            Every plumbing line undergoes mandatory 10-bar hydrostatic testing prior to handover. High-density PPR and copper pipework installed with meticulous thermal insulation.
          </p>
        </div>

        <div class="why-card reveal stagger-2">
          <div class="why-icon-wrap navy"><Icon name="Users" size={24} /></div>
          <h3>100% In-House Technical Teams</h3>
          <p>
            We do not subcontract critical works to unverified third parties. Our permanent team of certified electricians, wiremen, and master plumbers guarantees uniform quality.
          </p>
        </div>

        <div class="why-card reveal stagger-3">
          <div class="why-icon-wrap amber"><Icon name="FileText" size={24} /></div>
          <h3>Transparent Quotations &amp; BOQs</h3>
          <p>
            Clear line-item pricing detailing cable gauges, conduit brands, breaker ratings, and pipe specifications. No hidden extras or surprise variations.
          </p>
        </div>

        <div class="why-card reveal stagger-4">
          <div class="why-icon-wrap teal"><Icon name="Clock" size={24} /></div>
          <h3>Dependable Schedule Adherence</h3>
          <p>
            Commercial fit-outs and retail openings operate on strict calendar deadlines. We deploy night-shift operations and phased testing to protect your opening date.
          </p>
        </div>

        <div class="why-card reveal stagger-5">
          <div class="why-icon-wrap navy"><Icon name="Headphones" size={24} /></div>
          <h3>Responsive Service &amp; Support</h3>
          <p>
            Centrally stationed in the Oberoi Properties Building, Dubai. Rapid mobilization for site surveys, municipal inspections, and urgent fault rectifications.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================================================
       5. PROJECTS & WORK SHOWCASE: Authentic Real Gallery
       ========================================================================== -->
  <section class="section section-light" id="projects-showcase">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-navy">Authentic Portfolio</span>
        <h2>Work Showcase: Real Project Installations</h2>
        <p>
          Explore verified photographs from our electrical and plumbing installations across Dubai's commercial towers, luxury residences, and industrial hubs.
        </p>
      </div>

      <div class="gallery-cards-grid">
        {featuredGallery.map((item, index) => (
          <article class="gallery-card reveal" style={`transition-delay: ${index * 0.08}s`}>
            <div class="gc-media">
              <img 
                src={item.image} 
                alt={`${item.title} delivered by Abbadi Tech`} 
                width="600" 
                height="420" 
                loading="lazy" 
                class="gc-img"
              />
              <span class={item.trade === 'Electrical Technical Work' ? 'gc-trade-badge trade-amber' : 'gc-trade-badge trade-teal'}>
                {item.trade === 'Electrical Technical Work' ? 'Electrical' : 'Plumbing'}
              </span>
            </div>
            <div class="gc-info">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <div class="gc-meta">
                <span class="gc-loc"><Icon name="MapPin" size={12} /> {item.location}</span>
                <span class="gc-status"><Icon name="CheckCircle2" size={12} /> DEWA Approved</span>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="center-btn-row">
        <a href="/gallery" class="btn btn-navy">
          View Complete 16+ Work Photos Gallery →
        </a>
        <a href="/projects" class="btn btn-outline">
          Browse 1,000+ Completed Projects →
        </a>
      </div>
    </div>
  </section>

  <!-- ==========================================================================
       6. HOW IT WORKS: 4-Step Intuitive Service Journey
       ========================================================================== -->
  <section class="section section-white" id="how-it-works">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-amber">Streamlined Process</span>
        <h2>How It Works: Simple 4-Step Service Journey</h2>
        <p>
          A disciplined, predictable technical workflow from initial contact to certified handover.
        </p>
      </div>

      <div class="process-steps-grid">
        <div class="process-step-item reveal">
          <div class="step-badge">01</div>
          <h3>Submit an Enquiry</h3>
          <p>
            Share your project drawings, premise ID, or scope via our quote form, phone, or direct WhatsApp.
          </p>
        </div>

        <div class="process-step-item reveal stagger-1">
          <div class="step-badge">02</div>
          <h3>Discuss Your Requirements</h3>
          <p>
            Our senior engineer reviews load requirements, inspects existing feeder lines, and conducts an on-site survey.
          </p>
        </div>

        <div class="process-step-item reveal stagger-2">
          <div class="step-badge">03</div>
          <h3>Receive a Quotation</h3>
          <p>
            Receive a transparent, itemized quotation with clear material schedules, DEWA approval milestones, and timelines.
          </p>
        </div>

        <div class="process-step-item reveal stagger-3">
          <div class="step-badge">04</div>
          <h3>Schedule &amp; Complete the Work</h3>
          <p>
            Our certified in-house teams execute the installation, conduct Megger/pressure testing, and secure authority sign-off.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================================================
       7. TESTIMONIALS & TRUST: Authentic Client Feedback
       ========================================================================== -->
  <section class="section section-light" id="testimonials">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-navy">Client Feedback</span>
        <h2>Client Confidence Across the UAE</h2>
        <p>
          What facility directors, fit-out contractors, and property owners say about partnering with Abbadi Tech.
        </p>
      </div>

      <div class="testimonials-grid">
        <div class="testimonial-card reveal">
          <div class="testimonial-stars">★★★★★</div>
          <p class="testimonial-quote">
            “Abbadi Tech handled our entire restaurant fit-out electrical distribution and commercial plumbing rough-ins. Their familiarity with DEWA load schedules saved us at least two weeks on our opening timeline.”
          </p>
          <div class="testimonial-author">
            <strong>Tariq M.</strong>
            <span>F&amp;B Operations Director, Downtown Dubai</span>
          </div>
        </div>

        <div class="testimonial-card reveal stagger-1">
          <div class="testimonial-stars">★★★★★</div>
          <p class="testimonial-quote">
            “Clean MDB panel dressing and reliable water booster pump setup for our commercial warehouse. Transparent BOQ with zero hidden costs at final inspection.”
          </p>
          <div class="testimonial-author">
            <strong>Suresh K.</strong>
            <span>Logistics Facility Manager, Al Quoz</span>
          </div>
        </div>

        <div class="testimonial-card reveal stagger-2">
          <div class="testimonial-stars">★★★★★</div>
          <p class="testimonial-quote">
            “We hired Abbadi Tech for a comprehensive villa plumbing repiping and DB upgrade in Palm Jumeirah. High-pressure testing was conducted rigorously and with complete professionalism.”
          </p>
          <div class="testimonial-author">
            <strong>Mariam A.</strong>
            <span>Private Property Representative, Palm Jumeirah</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================================================
       8. CONTACT & CONVERSION EXPERIENCE: Interactive Quote Request Form
       ========================================================================== -->
  <section class="section section-navy" id="quote-section" style="position: relative; overflow: hidden;">
    <ElectricalCircuitDecor variant="vibrant" accent="dual" />
    <div class="container" style="position: relative; z-index: 1;">
      <div class="quote-conversion-wrap">
        <div class="qc-intro reveal">
          <span class="badge badge-gold">Let's Discuss Your Project</span>
          <h2>Request a Free Technical Quote</h2>
          <p>
            Provide your project details below to receive a line-item estimate from our engineering team. For immediate assistance or emergency dispatch, contact us directly.
          </p>

          <div class="qc-contact-points">
            <a href="tel:+971505546943" class="qcp-link">
              <div class="qcp-icon"><Icon name="Phone" size={18} /></div>
              <div>
                <span class="qcp-label">Phone Support</span>
                <strong>+971 50 554 6943</strong>
              </div>
            </a>
            <a href="https://wa.me/971505546943?text=Hello%20Abbadi%20Tech,%20I%20would%20like%20to%20request%20a%20quote" target="_blank" rel="noopener" class="qcp-link">
              <div class="qcp-icon teal"><Icon name="MessageSquare" size={18} /></div>
              <div>
                <span class="qcp-label">WhatsApp Quick Dispatch</span>
                <strong>Chat with Technical Estimator</strong>
              </div>
            </a>
            <a href="mailto:it.abbaditech@gmail.com" class="qcp-link">
              <div class="qcp-icon"><Icon name="Mail" size={18} /></div>
              <div>
                <span class="qcp-label">Email Drawings &amp; BOQs</span>
                <strong>it.abbaditech@gmail.com</strong>
              </div>
            </a>
          </div>
        </div>

        <!-- Interactive Form -->
        <div class="qc-form-card reveal stagger-1">
          <form id="home-quote-form" class="quote-form">
            <div class="form-row">
              <div class="form-group">
                <label for="q-name">Your Full Name *</label>
                <input type="text" id="q-name" name="name" required placeholder="e.g. Tariq Mohammed" />
              </div>
              <div class="form-group">
