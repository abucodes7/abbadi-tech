---
import Layout from '../layouts/Layout.astro';
import FAQSection from '../components/FAQSection.astro';
import Icon from '../components/Icon.astro';
import { homeFaqs } from '../data/faq';
import { projectsList, sectorsList } from '../data/projects';
import { servicesData } from '../data/services';
import { galleryItems } from '../data/gallery';
import HeroAnimation from '../components/HeroAnimation.astro';

const pageTitle = "Electrical & Plumbing Contractors Dubai | Abbadi Tech LLC";
const pageDescription = "DEWA-registered electrical and plumbing contractors in Dubai since 2005. Turnkey contracting for villas, malls, restaurants & commercial spaces. Get a free quote today.";

const featuredProjects = projectsList.filter(p => p.featured).slice(0, 6);
const featuredGallery = galleryItems.filter(item => item.featured).slice(0, 6);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": homeFaqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};
---

<Layout 
  title={pageTitle} 
  description={pageDescription} 
  currentPath="/"
  jsonLd={faqSchema}
>
  <!-- 1. HERO SECTION -->
  <section class="hero-section">
    <div class="hero-bg-glow"></div>
    <HeroAnimation />
    <div class="container hero-container">
      <div class="hero-content">
        <!-- Trust Badge Row -->
        <div class="hero-badges reveal">
          <span class="live-status-pill"><span class="pulse-dot"></span> DEWA Dispatch: Active</span>
          <span class="badge badge-gold"><Icon name="Zap" size={13} /> Registered DEWA Contractor</span>
          <span class="badge badge-blue"><Icon name="Droplets" size={13} /> Established 2005</span>
          <span class="badge badge-green"><Icon name="CheckCircle2" size={13} /> 21+ Years Experience</span>
        </div>

        <!-- H1 Heading -->
        <h1 class="hero-title reveal stagger-1">
          ELECTRICAL &amp; PLUMBING CONTRACTORS IN DUBAI: <span class="text-gradient">TRUSTED SINCE 2005</span>
        </h1>

        <!-- Subheadline / Value Proposition -->
        <p class="hero-lead reveal stagger-2">
          <strong>Abbadi Tech LLC</strong> delivers certified turnkey electrical and plumbing contracting across Dubai and Abu Dhabi. From high-capacity DEWA power infrastructure and luxury retail fit-outs to high-pressure plumbing, drainage networks, and booster pump systems—delivered strictly on schedule.
        </p>

        <!-- The 2 CTAs -->
        <div class="hero-cta-group reveal stagger-3">
          <a href="/contact" class="btn btn-primary btn-hero">
            Get Free Quote →
          </a>
          <a href="https://wa.me/971505546943?text=Hello%20Abbadi%20Tech,%20I%20would%20like%20to%20request%20a%20free%20quote%20for%20a%20project" target="_blank" rel="noopener" class="btn btn-secondary btn-hero">
            <Icon name="MessageSquare" size={16} /> WhatsApp (+971 50 554 6943)
          </a>
        </div>

        <!-- Metric Cards with Animated Counters -->
        <div class="hero-stats reveal stagger-4">
          <div class="stat-card card-interactive">
            <span class="stat-num text-gradient" data-counter="2005">2005</span>
            <span class="stat-label">Established in Dubai</span>
          </div>
          <div class="stat-card card-interactive">
            <span class="stat-num" style="color:var(--primary)">DEWA</span>
            <span class="stat-label">Registered Contractor</span>
          </div>
          <div class="stat-card card-interactive">
            <span class="stat-num" style="color:var(--plumbing-light)" data-counter="1000" data-suffix="+">1000+</span>
            <span class="stat-label">Delivered UAE Projects</span>
          </div>
          <div class="stat-card card-interactive">
            <span class="stat-num" style="color:#10b981" data-counter="100" data-suffix="%">100%</span>
            <span class="stat-label">On-Time Handover</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <div class="trust-bar" aria-label="Key Trust Signals">
    <div class="container trust-bar-inner">
      <div class="trust-item">
        <span class="trust-icon brand-emblem-wrap">
          <img src="/images/logo/logo-icon.png" alt="Abbadi Tech Official Brand Emblem" width="26" height="26" style="object-fit:contain;" />
        </span>
        <div>
          <strong>Since 2005</strong>
          <span>21+ Years in Dubai</span>
        </div>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-item">
        <span class="trust-icon"><Icon name="Landmark" size={22} color="#FF9500" /></span>
        <div>
          <strong>DEWA Registered</strong>
          <span>Direct Authority Approvals</span>
        </div>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-item">
        <span class="trust-icon"><Icon name="Trophy" size={22} color="#FF9500" /></span>
        <div>
          <strong>1000+ Projects Delivered</strong>
          <span>Malls, Banks, Hotels &amp; Villas</span>
        </div>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-item">
        <span class="trust-icon"><Icon name="MapPin" size={22} color="#FF9500" /></span>
        <div>
          <strong>Dubai &amp; Abu Dhabi</strong>
          <span>Dubai &amp; UAE Coverage</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 2. CORE SERVICES GRID (2 SERVICES) -->
  <section class="section section-services" id="services">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-gold">Turnkey Engineering Capabilities</span>
        <h2>Core Electrical &amp; Plumbing Contracting Services in Dubai</h2>
        <p class="section-sub">
          Every technical discipline is executed by our certified in-house engineers with complete compliance to DEWA, Dubai Municipality, and Civil Defence codes.
        </p>
      </div>

      <div class="services-five-grid">
        {servicesData.map((service, index) => (
          <div class="service-box-card">
            <div class="service-box-header">
              <span class="s-icon"><Icon name={service.icon} size={28} /></span>
              <span class="s-idx">0{index + 1}</span>
            </div>
            <h3>{service.title}</h3>
            <p class="service-tagline">{service.tagline}</p>
            <p class="service-brief">{service.overview}</p>

            <ul class="service-mini-points">
              {service.keyBenefits.slice(0, 3).map((pt) => (
                <li>{pt}</li>
              ))}
            </ul>

            <div class="service-box-actions">
              <a href={`/services/${service.slug}`} class="btn btn-primary btn-sm">
                Explore Service Details →
              </a>
              <a href={`https://wa.me/971505546943?text=Hi%20Abbadi%20Tech,%20I%20need%20a%20quote%20for%20${encodeURIComponent(service.title)}`} target="_blank" rel="noopener" class="btn btn-outline-white btn-sm">
                Quote
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. FEATURED PROJECTS -->
  <section class="section bg-card-section" id="featured-projects">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-blue">Proven Track Record</span>
        <h2>Featured Landmark Projects Across the UAE</h2>
        <p class="section-sub">
          From premier shopping malls and Michelin-level dining to private villas and banking institutions.
        </p>
      </div>

      <div class="featured-projects-grid">
        {featuredProjects.map((p) => (
          <div class="featured-project-card">
            <div class="fp-tags">
              <span class="badge badge-gold">{p.sectorLabel}</span>
              <span class="fp-scope">
                {p.scope === 'electrical' ? (
                  <span class="scope-inner"><Icon name="Zap" size={12} /> Electrical</span>
                ) : p.scope === 'plumbing' ? (
                  <span class="scope-inner"><Icon name="Droplets" size={12} /> Plumbing</span>
                ) : (
                  <span class="scope-inner"><Icon name="Zap" size={12} /><Icon name="Droplets" size={12} /> Combined MEP</span>
                )}
              </span>
            </div>

            <h3>{p.name}</h3>
            <p class="fp-client">{p.clientType}</p>
            <div class="fp-loc"><Icon name="MapPin" size={13} /> {p.location}</div>

            <div class="fp-delivered">
              <strong>Delivered:</strong> {p.delivered}
            </div>

            <div class="fp-footer">
              <span class="fp-dewa"><Icon name="CheckCircle2" size={12} /> DEWA Certified</span>
              <span class="fp-photo"><Icon name="Camera" size={12} /> Case Study Verified</span>
            </div>
          </div>
        ))}
      </div>

      <div class="center-btn" style="margin-top:2.5rem; text-align:center;">
        <a href="/projects" class="btn btn-secondary">
          View All 1000+ Completed UAE Projects →
        </a>
      </div>
    </div>
  </section>

  <!-- 4. SECTORS SERVED (6 SECTORS) -->
  <section class="section" id="sectors">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-gold">Broad Industry Expertise</span>
        <h2>Sectors We Serve in Dubai &amp; the UAE</h2>
        <p class="section-sub">
          Tailored engineering specifications engineered for high-demand commercial environments.
        </p>
      </div>

      <div class="sectors-display-grid">
        <div class="sector-tile">
          <span class="tile-icon"><Icon name="ShoppingBag" size={24} color="#FF9500" /></span>
          <h3>Retail &amp; Boutiques</h3>
          <p>The Dubai Mall, Marina Mall, City Centre Mirdif. Precision CRI 95+ track lighting, concealed luxury washrooms, fast-track mall approvals.</p>
          <span class="tile-client">Clients: Rolex, Rivoli, Marks &amp; Spencer, Pottery Barn</span>
        </div>

        <div class="sector-tile">
          <span class="tile-icon"><Icon name="UtensilsCrossed" size={24} color="#FF9500" /></span>
          <h3>Restaurants &amp; Cafes (F&amp;B)</h3>
          <p>Full commercial kitchen MEP rough-ins, heavy gas detection interlocks, municipal-approved grease traps, and dining atmospheric controls.</p>
          <span class="tile-client">Clients: Subway, Bianca, Leto Cafe, Caribou, Cafe Blanc</span>
        </div>

        <div class="sector-tile">
          <span class="tile-icon"><Icon name="Building2" size={24} color="#FF9500" /></span>
          <h3>Offices &amp; Banks</h3>
          <p>DIFC financial firms, banking halls, and commercial towers. Raised access flooring power boxes, dual-redundant UPS, meeting room zoning.</p>
          <span class="tile-client">Clients: HSBC Bank, ADCB, Pro League HQ, Driven Properties</span>
        </div>

        <div class="sector-tile">
          <span class="tile-icon"><Icon name="Hotel" size={24} color="#FF9500" /></span>
          <h3>Hotels &amp; Hospitality</h3>
          <p>5-star hotels, luxury beach clubs, and resorts. High-capacity booster pump panels, central solar boilers, acoustic soil stacks, guestroom AC.</p>
          <span class="tile-client">Clients: Shangri-La Hotel, Radisson Blu, Crowne Plaza, British Club</span>
        </div>

        <div class="sector-tile">
          <span class="tile-icon"><Icon name="Home" size={24} color="#FF9500" /></span>
          <h3>Luxury Villas &amp; Mansions</h3>
          <p>Palm Jumeirah beachfront mansions, Emirates Hills, and Al Barsha. Smart home automation panels, landscape lighting, and Italian sanitaryware.</p>
          <span class="tile-client">Deliveries: Palm Jumeirah Villa No. 7, Emirates Hills G+1</span>
        </div>

        <div class="sector-tile">
          <span class="tile-icon"><Icon name="Factory" size={24} color="#FF9500" /></span>
          <h3>Warehouses &amp; Industrial</h3>
          <p>Al Quoz and DIP industrial facilities. High-voltage transformers, heavy-duty busbar trunking, 3-phase machinery circuits, and pump stations.</p>
          <span class="tile-client">Deliveries: Al Ramool 10-Unit Complex, DECO Factory, Central Kitchen</span>
        </div>
      </div>
    </div>
  </section>

  <!-- VERIFIED ON-SITE WORK EXECUTION (ORGANIC PHOTOS SHOWCASE) -->
  <section class="section" id="verified-work">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-gold"><Icon name="Camera" size={13} /> Photographic Proof</span>
        <h2>Verified On-Site Work Execution</h2>
        <p class="section-sub">
          Genuine photographic proof of high-capacity DEWA meter cabinets, commercial EV charging pedestals, smart water manifolds, and distribution switchgear delivered across the UAE.
        </p>
      </div>

      <div class="home-gallery-grid">
        {featuredGallery.map((item) => (
          <article class="home-gallery-card">
            <div class="hg-img-wrap">
              <img 
                src={item.image} 
                alt={`${item.title} by Abbadi Tech LLC`} 
                loading="lazy" 
                width="600" 
                height="450" 
                class="hg-img"
              />
              <div class="hg-badges">
                <span class={item.trade === 'Electrical Technical Work' ? 'badge badge-gold hg-trade' : 'badge badge-blue hg-trade'}>
                  {item.trade === 'Electrical Technical Work' ? (
                    <Icon name="Zap" size={12} />
                  ) : (
                    <Icon name="Droplets" size={12} />
                  )}
                  <span>{item.trade === 'Electrical Technical Work' ? 'Electrical' : 'Plumbing'}</span>
                </span>
                <span class="hg-loc"><Icon name="MapPin" size={11} /> {item.location}</span>
              </div>
            </div>
            <div class="hg-body">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <div class="hg-tags">
                {item.tags.slice(0, 3).map(tag => (
                  <span class="hg-tag">{tag}</span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="center-btn" style="margin-top:2.75rem; text-align:center;">
        <a href="/gallery" class="btn btn-primary">
          <Icon name="Layers" size={16} /> View All 16+ Verified Work Photos in Gallery →
        </a>
      </div>
    </div>
  </section>

  <!-- 5. WHY CHOOSE US -->
  <section class="section bg-card-section" id="why-choose-us">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-gold">Competitive Advantage</span>
        <h2>Why Dubai Contractors &amp; Brands Choose Abbadi Tech</h2>
      </div>

      <div class="why-us-grid">
        <div class="why-card">
          <div class="why-icon"><Icon name="Zap" size={24} color="#FF9500" /></div>
          <h3>Registered DEWA Contractor</h3>
          <p>Direct portal access and established relations with DEWA inspectors. We prepare, submit, and secure single-line diagram approvals and load upgrades without red tape.</p>
        </div>

        <div class="why-card">
          <div class="why-icon"><Icon name="Calendar" size={24} color="#FF9500" /></div>
          <h3>Established 2005 (21+ Years)</h3>
          <p>Over two decades of continuous UAE contracting experience. We understand Dubai's soil, water chemistry, climate, and municipal building codes inside out.</p>
        </div>

        <div class="why-card">
          <div class="why-icon"><Icon name="HardHat" size={24} color="#FF9500" /></div>
          <h3>Certified In-House Workforce</h3>
          <p>We do not outsource critical engineering to unlicensed labor. Our permanent team of certified electrical technicians and master plumbers ensures high quality.</p>
        </div>

        <div class="why-card">
          <div class="why-icon"><Icon name="Clock" size={24} color="#FF9500" /></div>
          <h3>Guaranteed On-Time Handover</h3>
          <p>We know every day of retail or dining delay costs thousands in lost trade. We deploy structured night shifts and phased testing to meet opening deadlines.</p>
        </div>

        <div class="why-card">
          <div class="why-icon"><Icon name="SearchCheck" size={24} color="#FF9500" /></div>
          <h3>Rigorous Pre-Inspection Testing</h3>
          <p>Every electrical board undergoes Megger insulation resistance testing. Every plumbing network undergoes 10-bar hydrostatic testing before official inspection.</p>
        </div>

        <div class="why-card">
          <div class="why-icon"><Icon name="MapPin" size={24} color="#FF9500" /></div>
          <h3>Centrally Stationed in Dubai</h3>
          <p>Located in the Oberoi Properties Building behind Al Khail Mall. Fast access across Downtown, DIFC, JLT, Palm, and Abu Dhabi for rapid engineering response.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. PROVEN 6-STEP PROCESS -->
  <section class="section" id="process">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-blue">Proven Methodology</span>
        <h2>Our 6-Step Turnkey Execution Process</h2>
        <p class="section-sub">
          From first enquiry to final DEWA sign-off and ongoing maintenance.
        </p>
      </div>

      <div class="process-steps-track">
        <div class="step-card">
          <span class="step-num">01</span>
          <h3>Enquiry &amp; Brief</h3>
          <p>You share your project location, architectural drawings, or technical specifications for initial engineering assessment.</p>
        </div>

        <div class="step-card">
          <span class="step-num">02</span>
          <h3>Free Site Survey</h3>
          <p>Our senior engineer visits the premises to inspect existing electrical feeder cables, power distribution, and drainage connections.</p>
        </div>

        <div class="step-card">
          <span class="step-num">03</span>
          <h3>Transparent Quote</h3>
          <p>We provide a line-item bill of quantities (BOQ), DEWA load calculations, material brand schedules, and clear milestone dates.</p>
        </div>

        <div class="step-card">
          <span class="step-num">04</span>
          <h3>Site Execution</h3>
          <p>First-fix containment, cabling, piping, and panel installations executed under daily site engineer supervision adhering to QHSE standards.</p>
        </div>

        <div class="step-card">
          <span class="step-num">05</span>
          <h3>Testing &amp; Handover</h3>
          <p>Full pressure hold tests, electrical Megger checks, DEWA site inspection, meter energization, and As-Built handover documentation.</p>
        </div>

        <div class="step-card">
          <span class="step-num">06</span>
          <h3>Ongoing Maintenance</h3>
          <p>Post-handover warranty support and customized Annual Maintenance Contracts (AMC) with 24/7 priority emergency dispatch.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. FAQ SECTION -->
  <FAQSection 
    title="Frequently Asked Questions About MEP Contracting in Dubai" 
    subtitle="Direct answers from our senior engineering team regarding approvals, costs, and project timelines."
    faqs={homeFaqs}
  />

  <!-- 8. FINAL HIGH-CONVERTING CTA -->
  <section class="section section-cta">
    <div class="container">
      <div class="cta-inner-card">
        <span class="badge badge-gold" style="margin-bottom:1rem">Get In Touch Today</span>
        <h2>Ready to Power Your Next Project in Dubai?</h2>
        <p>Book a free technical site survey or consult with Founder &amp; Chairman Koyakutty Mohammed and our lead engineering estimators today.</p>
        
        <div class="cta-btns">
          <a href="/contact" class="btn btn-primary btn-hero">
            Get Free Quote →
          </a>
          <a href="https://wa.me/971505546943?text=Hi%20Abbadi%20Tech,%20I%20would%20like%20to%20request%20a%20free%20quote" target="_blank" rel="noopener" class="btn btn-secondary btn-hero">
            <Icon name="MessageSquare" size={16} /> WhatsApp Lead Engineer
          </a>
          <a href="tel:+971505546943" class="btn btn-outline-white btn-hero">
            <Icon name="Phone" size={16} /> Call: +971 50 554 6943
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* HERO SECTION */
  .hero-section {
    position: relative;
    padding: 5rem 0 4rem;
    overflow: hidden;
    background: linear-gradient(180deg, #0d121c 0%, #0a0e17 100%);
    border-bottom: 1px solid var(--border-subtle);
  }

  .hero-bg-glow {
    position: absolute;
    top: -100px;
    right: -100px;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(255, 149, 0, 0.15) 0%, transparent 70%);
    pointer-events: none;
    z-index: 1;
  }

  .hero-container {
    position: relative;
    z-index: 2;
  }

  .hero-badges {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .hero-title {
    font-size: 2.75rem;
    line-height: 1.15;
    color: #fff;
    margin-bottom: 1.25rem;
    max-width: 950px;
    letter-spacing: -0.02em;
  }

  .text-gradient {
    background: linear-gradient(135deg, #FF9500 0%, #ffaa33 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-lead {
    font-size: 1.2rem;
    color: var(--text-muted);
    max-width: 820px;
    line-height: 1.7;
    margin-bottom: 2.25rem;
  }

  .hero-cta-group {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  .btn-hero {
    padding: 1rem 2rem;
    font-size: 1.05rem;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    background: #111724;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    max-width: 900px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .stat-num {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 0.35rem;
  }

  .stat-label {
    font-size: 0.78rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* TRUST BAR */
  .trust-bar {
    background: #060910;
    border-bottom: 1px solid var(--border-subtle);
    padding: 1.25rem 0;
  }

  .trust-bar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .trust-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: rgba(255, 149, 0, 0.08);
    border: 1px solid rgba(255, 149, 0, 0.15);
    flex-shrink: 0;
  }

  .trust-item strong {
    display: block;
    font-size: 0.92rem;
    color: #fff;
    font-family: var(--font-heading);
  }

  .trust-item span {
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  .trust-divider {
    width: 1px;
    height: 35px;
    background: rgba(255, 255, 255, 0.08);
  }

  /* 5 SERVICES GRID */
  .services-five-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  .service-box-card {
    background: #111724;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .service-box-card:hover {
    transform: translateY(-4px);
    border-color: var(--primary);
  }

  .service-box-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .s-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    background: rgba(255, 149, 0, 0.1);
    border: 1px solid rgba(255, 149, 0, 0.25);
    color: var(--primary);
  }

