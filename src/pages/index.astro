<script>
  // Dynamic Quote Request Form Handling
  const quoteForm = document.getElementById('home-quote-form');
  if (quoteForm) {
    quoteForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('q-name') as HTMLInputElement)?.value || '';
      const phone = (document.getElementById('q-phone') as HTMLInputElement)?.value || '';
      const service = (document.getElementById('q-service') as HTMLSelectElement)?.value || '';
      const location = (document.getElementById('q-location') as HTMLSelectElement)?.value || '';
      const details = (document.getElementById('q-details') as HTMLTextAreaElement)?.value || '';

      const msg = `*Quote Request from Website*\n\n*Name:* ${name}\n*Phone:* ${phone}\n*Service Category:* ${service}\n*Location:* ${location}\n*Requirements:* ${details}`;
      const url = `https://wa.me/971505546943?text=${encodeURIComponent(msg)}`;
      window.open(url, '_blank');
    });
  }
</script>

