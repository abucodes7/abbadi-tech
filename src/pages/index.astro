---
import Layout from '../layouts/Layout.astro';
import FAQSection from '../components/FAQSection.astro';
import Icon from '../components/Icon.astro';
import HeroAnimation from '../components/HeroAnimation.astro';
import { siteConfig } from '../config/site';
import { homeFaqs } from '../data/faq';
import { galleryItems } from '../data/gallery';

const pageTitle = "Electrical & Plumbing Contractors Dubai | Abbadi Tech";
const pageDescription = "Licensed electrical & commercial plumbing contractors in Dubai since 2005. Turnkey fit-outs, DEWA approvals, SLD design & MDB panels. Call +971 50 554 6943.";

const featuredGallery = galleryItems.slice(0, 6);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": homeFaqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};

const electricalCapabilities = [
  "Electrical installations & containment",
  "Wiring & power distribution",
  "Architectural lighting & controls",
  "MDB & SMDB panel assembly",
  "Inspection & fault diagnosis",
  "DEWA approvals & load upgrades"
];

const plumbingCapabilities = [
  "Water supply & PPR piping",
  "Drainage & waste water networks",
  "Leak detection & pressure testing",
  "Booster & transfer pump stations",
  "Sanitary fixture installation",
  "Preventive maintenance & repairs"
];

const strengths = [
  {
    n: "01",
    title: "DEWA approval specialists",
    body: "Direct authority liaison and proven relations with DEWA inspectors. We prepare, submit, and secure single-line diagram approvals and load upgrades without red tape."
  },
  {
    n: "02",
    title: "Leak-proof hydraulic standards",
    body: "Every plumbing line undergoes mandatory 10-bar hydrostatic testing before handover. High-density PPR and copper pipework installed with meticulous insulation."
  },
  {
    n: "03",
    title: "100% in-house technical teams",
    body: "No critical works are subcontracted to unverified third parties. Our permanent electricians, wiremen, and master plumbers guarantee uniform quality."
  },
  {
    n: "04",
    title: "Transparent quotations & BOQs",
    body: "Clear line-item pricing detailing cable gauges, conduit brands, breaker ratings, and pipe specifications. No hidden extras or surprise variations."
  },
  {
    n: "05",
    title: "Dependable schedule adherence",
    body: "Commercial fit-outs and retail openings run on strict deadlines. We deploy phased operations and night shifts to protect your opening date."
  },
  {
    n: "06",
    title: "Responsive service & support",
    body: "Centrally stationed in the Oberoi Properties Building, Dubai. Rapid mobilisation for site surveys, municipal inspections, and urgent fault rectification."
  }
];

const process = [
  { n: "01", title: "Submit an enquiry", body: "Share your drawings, premise ID, or scope via the quote form, phone, or direct WhatsApp." },
  { n: "02", title: "Discuss requirements", body: "A senior engineer reviews load requirements, inspects existing feeder lines, and conducts an on-site survey." },
  { n: "03", title: "Receive a quotation", body: "An itemised quotation with material schedules, DEWA approval milestones, and clear timelines." },
  { n: "04", title: "Complete the work", body: "Certified in-house teams install, conduct Megger and pressure testing, and secure authority sign-off." }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  currentPath="/"
  arabicUrl={`${siteConfig.primaryDomain}/ar`}
  jsonLd={faqSchema}
>
  <!-- HERO -->
  <section class="hero">
    <HeroAnimation />
    <div class="container hero-inner">
      <div class="hero-copy">
        <div class="hero-meta reveal">
          <span class="live-status-pill"><span class="pulse-dot"></span> Established 2005 · Dubai, UAE</span>
          <span class="hero-meta-rule"></span>
          <span class="hero-meta-text">Electrical &amp; Plumbing Contracting</span>
        </div>

        <h1 class="hero-title reveal stagger-1">
          Reliable electrical &amp; plumbing.
          <em>Built on trust.</em>
        </h1>

        <p class="hero-lead reveal stagger-2">
          Professional electrical and plumbing services focused on quality workmanship, dependable solutions, and lasting customer confidence across Dubai and the UAE.
        </p>

        <div class="hero-actions reveal stagger-3">
          <a href="#quote-section" class="btn btn-primary btn-hero">
            Request a Quote
            <Icon name="ArrowUpRight" size={17} />
          </a>
          <a href="#services-pillars" class="btn btn-outline-white btn-hero">
            Explore Our Services
          </a>
        </div>

        <dl class="hero-figures reveal stagger-4">
          <div>
            <dt>21+</dt>
            <dd>Years in the UAE</dd>
          </div>
          <div>
            <dt>100%</dt>
            <dd>In-House Teams</dd>
          </div>
          <div>
            <dt>Licensed</dt>
            <dd>Certified engineers</dd>
          </div>
        </dl>
      </div>

      <div class="hero-media reveal stagger-2">
        <div class="hero-frame-main">
          <img
            src="/images/gallery/abb-three-phase-db-panel-dressing.jpg"
            alt="ABB three-phase distribution board panel dressing by Abbadi Tech"
            width="640"
            height="760"
            loading="eager"
            fetchpriority="high"
          />
          <span class="hero-frame-index">01 — Electrical execution</span>
        </div>

        <div class="hero-frame-secondary" data-parallax="0.05">
          <img
            src="/images/gallery/plumbing-ppr-pipework.jpg"
            alt="High-pressure PPR water distribution pipework installed by Abbadi Tech"
            width="420"
            height="320"
            loading="eager"
          />
        </div>

        <div class="hero-note">
          <Icon name="ShieldCheck" size={18} />
          <span>
            <strong>Certified in-house engineers</strong>
            DEWA &amp; DM municipal code compliant
          </span>
        </div>
      </div>
    </div>

    <div class="hero-scroll-hint">
      <span>Scroll</span>
      <span class="hero-scroll-line"></span>
    </div>
  </section>

  <!-- TRUST STRIP -->
  <section class="trust-band" aria-label="Key credentials">
    <div class="container trust-inner">
      <div class="trust-item">
        <span class="trust-label">Since 2005</span>
        <span class="trust-value">21+ years of continuous UAE operations</span>
      </div>
      <div class="trust-item">
        <span class="trust-label">Certified engineering</span>
        <span class="trust-value">Compliant technical execution</span>
      </div>
      <div class="trust-item">
        <span class="trust-label">Proven track record</span>
        <span class="trust-value">Commercial, residential &amp; industrial</span>
      </div>
      <div class="trust-item">
        <span class="trust-label">Dubai &amp; UAE coverage</span>
        <span class="trust-value">Rapid engineering dispatch</span>
      </div>
    </div>
  </section>

  <!-- INTRO / POSITIONING -->
  <section class="section section-ivory intro-section">
    <div class="container intro-grid">
      <div class="intro-heading reveal">
        <span class="eyebrow">The Abbadi standard</span>
        <h2>Engineering excellence, rooted in two decades of UAE craftsmanship.</h2>
      </div>

      <div class="intro-body reveal stagger-1">
        <p class="intro-lead">
          Established in 2005, <strong>Abbadi Tech Technical Solutions LLC</strong> was founded by Koyakutty Mohammed with a singular commitment: uncompromised technical integrity in electrical and plumbing contracting.
        </p>
        <p>
          Across Dubai's demanding commercial and residential landscape, our reputation has been built on precision execution, strict adherence to DEWA regulations, and transparent engineering ethics. We never subcontract core MEP responsibilities — every cable pulled, panel dressed, and pipe welded is executed by our certified, in-house team.
        </p>
        <div class="intro-signals">
          <div>
            <Icon name="ShieldCheck" size={19} />
            <span><strong>Uncompromising safety</strong>Civil Defence &amp; QHSE verified workflows</span>
          </div>
          <div>
            <Icon name="Landmark" size={19} />
            <span><strong>Authority compliance</strong>DEWA, ADDC, SEWA &amp; DM standards</span>
          </div>
        </div>
        <a href="/about" class="text-link">
          Read the Abbadi Tech story
          <Icon name="ArrowUpRight" size={15} />
        </a>
      </div>
    </div>

    <div class="container intro-media-grid">
      <figure class="intro-media intro-media-wide reveal-img">
        <img src="/images/gallery/dewa-meter-installation.jpg" alt="DEWA meter installation completed by Abbadi Tech" loading="lazy" width="760" height="480" />
        <figcaption class="img-caption"><Icon name="CheckCircle2" size={13} /> DEWA meter room handover</figcaption>
      </figure>
      <figure class="intro-media reveal-img stagger-1">
        <img src="/images/gallery/commercial-multi-tenant-water-meters.jpg" alt="Multi-tenant water meter manifold installation in Dubai" loading="lazy" width="520" height="480" />
        <figcaption class="img-caption"><Icon name="MapPin" size={13} /> Multi-tenant metering</figcaption>
      </figure>
      <div class="intro-year reveal">
        <span class="intro-year-num">2005</span>
        <span class="intro-year-label">Established in Dubai</span>
        <p>Over two decades of continuous delivery across the Emirates.</p>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section section-paper services-section" id="services-pillars">
    <div class="container">
      <div class="services-head">
        <div class="reveal">
          <span class="eyebrow">Core disciplines</span>
          <h2>Two specialist divisions.<br /><em>One accountable team.</em></h2>
        </div>
        <p class="lede reveal stagger-1">
          Turnkey electrical and plumbing services delivered in-house — from design and authority approvals to testing, commissioning, and certified handover.
        </p>
      </div>

      <article class="service-row reveal">
        <div class="service-visual">
          <div class="service-image img-frame">
            <img src="/images/gallery/electrical-panel-assembly.jpg" alt="Electrical panel assembly and wiring by Abbadi Tech" loading="lazy" width="680" height="540" />
            <span class="service-image-tag">Electrical services</span>
          </div>
          <span class="service-index">01</span>
        </div>

        <div class="service-content">
          <span class="service-kicker"><Icon name="Zap" size={15} /> Electrical installations &amp; power infrastructure</span>
          <h3>Power systems engineered for demanding buildings.</h3>
          <p>
            Turnkey electrical engineering for commercial buildings, retail fit-outs, villas, and industrial facilities — with complete DEWA compliance from first fix to energisation.
          </p>
          <ul class="service-list">
            {electricalCapabilities.map(item => (
              <li><Icon name="ArrowUpRight" size={14} /> {item}</li>
            ))}
          </ul>
          <div class="service-actions">
            <a href="/services/electrical-contractors-dubai" class="text-link">
              Electrical services in detail
              <Icon name="ArrowRight" size={15} />
            </a>
            <a href="#quote-section" class="btn btn-outline btn-sm">Request electrical quote</a>
          </div>
        </div>
      </article>

      <article class="service-row service-row-reverse reveal">
        <div class="service-visual">
          <div class="service-image img-frame">
            <img src="/images/gallery/booster-pump-drainage.jpg" alt="Automatic booster pump and drainage installation by Abbadi Tech" loading="lazy" width="680" height="540" />
            <span class="service-image-tag">Plumbing services</span>
          </div>
          <span class="service-index">02</span>
        </div>

        <div class="service-content">
          <span class="service-kicker"><Icon name="Droplets" size={15} /> Plumbing installations &amp; hydraulic systems</span>
          <h3>Hydraulics that stay silent, stable, and leak-free.</h3>
          <p>
            Engineered sanitary, drainage, and water supply solutions ensuring zero leakage, high pressure stability, and hygiene code compliance across every floor.
          </p>
          <ul class="service-list">
            {plumbingCapabilities.map(item => (
              <li><Icon name="ArrowUpRight" size={14} /> {item}</li>
            ))}
          </ul>
          <div class="service-actions">
            <a href="/services/plumbing-contractors-dubai" class="text-link">
              Plumbing services in detail
              <Icon name="ArrowRight" size={15} />
            </a>
            <a href="#quote-section" class="btn btn-outline btn-sm">Request plumbing quote</a>
          </div>
        </div>
      </article>
    </div>

    <!-- DEWA DIVISION -->
    <div class="container">
      <div class="dewa-band reveal">
        <div class="dewa-copy">
          <span class="badge badge-white-on-navy"><span class="pulse-dot"></span> Approvals division</span>
          <h3>Fast-track DEWA approvals, fit-out NOCs &amp; load upgrades.</h3>
          <p>
            Operating as our dedicated approvals division, <strong>DEWA Approvals Dubai</strong> manages online authority submissions, Single Line Diagram engineering, and inspector handovers so your fit-out opens strictly on schedule.
          </p>
        </div>
        <div class="dewa-actions">
          <a href="/dewa-approvals-dubai" class="btn btn-primary">
            Visit DEWA approvals
            <Icon name="ArrowUpRight" size={15} />
          </a>
          <a href="https://wa.me/971505546943?text=Hello%20DEWA%20Approvals%20Dubai,%20I%20need%20urgent%20approval%20support" target="_blank" rel="noopener" class="btn btn-outline-white">
            <Icon name="MessageSquare" size={15} /> WhatsApp approval desk
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY ABBADI -->
  <section class="section section-ink why-section" id="why-choose-us">
    <div class="container why-grid">
      <div class="why-aside reveal">
        <span class="eyebrow">Why Abbadi Tech</span>
        <h2>Trust is earned on site, <em>not in a brochure.</em></h2>
        <p>
          Our strengths reflect decades of practical site mastery, direct authority liaison, and transparent communication with the people who own the outcome.
        </p>
        <a href="/about" class="text-link light">
          Meet the team behind the work
          <Icon name="ArrowUpRight" size={15} />
        </a>
      </div>

      <div class="why-list reveal-group">
        {strengths.map(item => (
          <div class="why-item">
            <span class="why-number">{item.n}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WORK SHOWCASE -->
  <section class="section section-ivory work-section" id="projects-showcase">
    <div class="container">
      <div class="work-head">
        <div class="reveal">
          <span class="eyebrow">Selected work</span>
          <h2>Real installations,<br /><em>documented on site.</em></h2>
        </div>
        <div class="work-head-actions reveal stagger-1">
          <p class="lede">Verified photographs from electrical and plumbing installations across Dubai's commercial towers, residences, and industrial hubs.</p>
          <a href="/gallery" class="text-link">
            View the complete gallery
            <Icon name="ArrowRight" size={15} />
          </a>
        </div>
      </div>

      <div class="work-grid reveal-group">
        {featuredGallery.map((item, index) => (
          <a href="/gallery" class:list={['work-card', { 'work-card-feature': index === 0 }]}>
            <div class="work-media">
              <img
                src={item.image}
                alt={`${item.title} delivered by Abbadi Tech`}
                width="640"
                height="460"
                loading="lazy"
              />
              <span class="work-tag">{item.trade === 'Electrical Technical Work' ? 'Electrical' : 'Plumbing'}</span>
              <span class="work-open"><Icon name="ArrowUpRight" size={16} /></span>
            </div>
            <div class="work-caption">
              <h3>{item.title}</h3>
              <span><Icon name="MapPin" size={12} /> {item.location}</span>
            </div>
          </a>
        ))}
      </div>

      <div class="work-footer reveal">
        <a href="/projects" class="btn btn-secondary">
          Browse verified project handovers
          <Icon name="ArrowUpRight" size={15} />
        </a>
        <span class="work-note">Photographs from live Abbadi Tech project sites.</span>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section section-paper process-section" id="how-it-works">
    <div class="container">
      <div class="process-head reveal">
        <span class="eyebrow">How we work</span>
        <h2>A disciplined path from enquiry to <em>certified handover.</em></h2>
      </div>

      <ol class="process-grid reveal-group">
        {process.map(step => (
          <li class="process-step">
            <span class="process-number">{step.n}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section section-ivory testimonials-section" id="testimonials">
    <div class="container testimonials-grid">
      <div class="testimonial-heading reveal">
        <span class="eyebrow">Client confidence</span>
        <h2>Quietly relied on <em>across the UAE.</em></h2>
        <p>Facility directors, fit-out contractors, and property owners on partnering with Abbadi Tech.</p>
      </div>

      <figure class="testimonial-feature reveal stagger-1">
        <div class="testimonial-stars" aria-label="Five out of five">★★★★★</div>
        <blockquote>
          “Abbadi Tech handled our entire restaurant fit-out electrical distribution and commercial plumbing rough-ins. Their familiarity with DEWA load schedules saved us at least two weeks on our opening timeline.”
        </blockquote>
        <figcaption>
          <span class="testimonial-avatar">TM</span>
          <span><strong>Tariq M.</strong>F&amp;B Operations Director, Downtown Dubai</span>
        </figcaption>
      </figure>

      <div class="testimonial-stack reveal stagger-2">
        <figure class="testimonial-small">
          <div class="testimonial-stars" aria-label="Five out of five">★★★★★</div>
          <blockquote>“Clean MDB panel dressing and a reliable water booster pump setup for our commercial warehouse. Transparent BOQ with zero hidden costs at final inspection.”</blockquote>
          <figcaption><strong>Suresh K.</strong>Logistics Facility Manager, Al Quoz</figcaption>
        </figure>
        <figure class="testimonial-small">
          <div class="testimonial-stars" aria-label="Five out of five">★★★★★</div>
          <blockquote>“We hired Abbadi Tech for villa plumbing repiping and a DB upgrade in Palm Jumeirah. High-pressure testing was conducted rigorously and with complete professionalism.”</blockquote>
          <figcaption><strong>Mariam A.</strong>Private Property Representative, Palm Jumeirah</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- QUOTE / CONTACT -->
  <section class="section section-ink quote-section" id="quote-section">
    <div class="container quote-grid">
      <div class="quote-copy reveal">
        <span class="eyebrow">Let's discuss your project</span>
        <h2>Request a free <em>technical quote.</em></h2>
        <p>
          Provide your project details to receive a line-item estimate from our engineering team. For immediate assistance or emergency dispatch, contact us directly.
        </p>

        <div class="quote-contact-list">
          <a href="tel:+971505546943" class="quote-contact">
            <span class="quote-contact-icon"><Icon name="Phone" size={17} /></span>
            <span><small>Phone support</small><strong>+971 50 554 6943</strong></span>
            <Icon name="ArrowUpRight" size={15} class="quote-contact-arrow" />
          </a>
          <a href="https://wa.me/971505546943?text=Hello%20Abbadi%20Tech,%20I%20would%20like%20to%20request%20a%20quote" target="_blank" rel="noopener" class="quote-contact">
            <span class="quote-contact-icon"><Icon name="MessageSquare" size={17} /></span>
            <span><small>WhatsApp quick dispatch</small><strong>Chat with a technical estimator</strong></span>
            <Icon name="ArrowUpRight" size={15} class="quote-contact-arrow" />
          </a>
          <a href="mailto:it.abbaditech@gmail.com" class="quote-contact">
            <span class="quote-contact-icon"><Icon name="Mail" size={17} /></span>
            <span><small>Email drawings &amp; BOQs</small><strong>it.abbaditech@gmail.com</strong></span>
            <Icon name="ArrowUpRight" size={15} class="quote-contact-arrow" />
          </a>
        </div>
      </div>

      <div class="quote-form-card reveal stagger-1">
        <form id="home-quote-form" class="quote-form">
          <div class="form-row">
            <div class="form-group">
              <label for="q-name">Your full name *</label>
              <input type="text" id="q-name" name="name" required placeholder="e.g. Tariq Mohammed" />
            </div>
            <div class="form-group">
              <label for="q-phone">Phone / WhatsApp *</label>
              <input type="tel" id="q-phone" name="phone" required placeholder="+971 50 123 4567" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="q-service">Service category *</label>
              <select id="q-service" name="service" required>
                <option value="Electrical Services">Electrical services</option>
                <option value="Plumbing Services">Plumbing services</option>
                <option value="Combined MEP Services">Combined electrical &amp; plumbing</option>
                <option value="DEWA Approvals Only">DEWA approvals &amp; fit-out NOC</option>
              </select>
            </div>
            <div class="form-group">
              <label for="q-location">Project location *</label>
              <select id="q-location" name="location" required>
                <option value="Dubai">Dubai</option>
                <option value="Abu Dhabi">Abu Dhabi</option>
                <option value="Sharjah / Northern Emirates">Sharjah / Northern Emirates</option>
                <option value="Other UAE Location">Other UAE location</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="q-details">Project requirements *</label>
            <textarea id="q-details" name="details" rows="3" required placeholder="Describe your project — e.g. restaurant fit-out in Downtown, 45kW DEWA load upgrade and drainage rough-in…"></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-hero submit-btn">
            Send quote request via WhatsApp
            <Icon name="ArrowRight" size={16} />
          </button>
          <p class="form-disclaimer">Direct dispatch to a lead engineer. Your information is used strictly for technical estimation.</p>
        </form>
      </div>
    </div>
  </section>

  <FAQSection
    title="Frequently asked questions"
    subtitle="Direct answers from our senior engineering team on DEWA approvals, load calculations, plumbing standards, and warranty."
    badge="Engineering FAQ"
    faqs={homeFaqs}
  />
</Layout>

<script>
  const quoteForm = document.getElementById('home-quote-form');
  if (quoteForm) {
    quoteForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const val = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement)?.value || '';
      const msg = `*Quote Request from Website*\n\n*Name:* ${val('q-name')}\n*Phone:* ${val('q-phone')}\n*Service Category:* ${val('q-service')}\n*Location:* ${val('q-location')}\n*Requirements:* ${val('q-details')}`;
      window.open(`https://wa.me/971505546943?text=${encodeURIComponent(msg)}`, '_blank');
    });
  }
</script>

<style>
  /* ==========================================================================
     HERO
     ========================================================================== */
  .hero {
    position: relative;
    background: var(--ink-deep);
    color: var(--white);
    overflow: hidden;
    padding: clamp(3.5rem, 7vw, 6.5rem) 0 clamp(3rem, 5vw, 4.5rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin-bottom: 1.6rem;
  }

  .hero-meta-rule { width: 32px; height: 1px; background: rgba(255, 255, 255, 0.22); }

  .hero-meta-text {
    font-family: var(--font-heading);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 6.2vw, 5.4rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.018em;
    color: var(--white);
    margin-bottom: 1.6rem;
  }

  .hero-title em {
    display: block;
    font-style: italic;
    color: var(--brass-soft);
  }

  .hero-lead {
    font-size: clamp(1.02rem, 1.4vw, 1.16rem);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.66);
    max-width: 52ch;
    margin-bottom: 2.1rem;
  }

