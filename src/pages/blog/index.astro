---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import FAQSection from '../../components/FAQSection.astro';
import HeroAnimation from '../../components/HeroAnimation.astro';
import { blogPosts } from '../../data/blog';
import { dewaWorksFaqs } from '../../data/faq';

const pageTitle = "Engineering Insights & DEWA Regulatory Blog | Abbadi Tech Dubai";
const pageDescription = "Authoritative technical guides and regulatory insights for Dubai MEP engineering: DEWA fit-out NOCs, Red Notice rectifications, Shams Dubai solar net metering, and plumbing codes.";

const featuredPost = blogPosts.find(p => p.featured) || blogPosts[0];
const regularPosts = blogPosts.filter(p => p.slug !== featuredPost.slug);

const categories = ['All Guides', 'DEWA Approvals', 'Electrical Engineering', 'Plumbing & Hydraulics', 'Regulatory & Compliance'];

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": "https://www.abbaditech.com/blog#blog",
  "name": "Abbadi Tech Engineering Insights & Regulatory Hub",
  "description": pageDescription,
  "url": "https://www.abbaditech.com/blog",
  "publisher": {
    "@type": "Organization",
    "name": "Abbadi Tech Technical Solutions LLC",
    "logo": "https://www.abbaditech.com/logo.png"
  },
  "blogPost": blogPosts.map(p => ({
    "@type": "BlogPosting",
    "headline": p.title,
    "description": p.metaDescription,
    "url": `https://www.abbaditech.com/blog/${p.slug}`,
    "datePublished": "2026-10-01",
    "author": {
      "@type": "Person",
      "name": p.author.name
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  currentPath="/blog"
  jsonLd={blogSchema}
>
  <!-- HERO -->
  <section class="blog-hero">
    <HeroAnimation />
    <div class="container hero-inner-container">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><span>Insights</span>
      </nav>

      <div class="hero-content">
        <div class="hero-badge-row">
          <span class="live-status-pill"><span class="pulse-dot"></span> Active engineering journal</span>
          <span class="badge badge-gold">21+ years UAE practice</span>
        </div>

        <h1>Dubai MEP &amp; DEWA regulatory insights.</h1>
        <p class="hero-lead">
          In-depth technical guides, code compliance walkthroughs, and practical engineering advice published by Abbadi Tech Technical Solutions LLC. Written by certified UAE electrical and plumbing engineers.
        </p>
      </div>
    </div>
  </section>

  <!-- FILTERS -->
  <section class="blog-filter-section">
    <div class="container">
      <div class="filter-controls-wrap">
        <div class="category-tabs" id="category-tabs">
          {categories.map((cat, idx) => (
            <button class:list={['cat-tab-btn', { active: idx === 0 }]} data-cat={cat === 'All Guides' ? 'all' : cat}>
              {cat}
            </button>
          ))}
        </div>

        <div class="blog-search-box">
          <Icon name="Search" size={15} />
          <input
            type="search"
            id="blog-search-input"
            placeholder="Search guides (SLD, Red Notice, Shams Dubai…)"
            aria-label="Search technical blog articles"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURED -->
  <section class="section section-featured-post">
    <div class="container">
      <div class="featured-article-card" id="featured-article" data-category={featuredPost.category}>
        <div class="fac-media">
          <img src={featuredPost.image} alt={featuredPost.title} width="640" height="420" class="fac-img" />
          <span class="fac-badge">{featuredPost.category}</span>
        </div>
        <div class="fac-content">
          <div class="fac-meta-row">
            <span class="meta-item"><Icon name="Calendar" size={13} /> {featuredPost.publishDate}</span>
            <span class="meta-item"><Icon name="Clock" size={13} /> {featuredPost.readTime}</span>
            <span class="meta-item author-tag"><Icon name="ShieldCheck" size={13} /> Verified expert review</span>
          </div>
          <span class="eyebrow">Featured guide</span>
          <h2><a href={`/blog/${featuredPost.slug}`}>{featuredPost.title}</a></h2>
          <p class="fac-summary">{featuredPost.summary}</p>

          <div class="fac-author-box">
            <div class="author-info">
              <strong>{featuredPost.author.name}</strong>
              <span>{featuredPost.author.role}</span>
            </div>
            <a href={`/blog/${featuredPost.slug}`} class="btn btn-primary">Read the complete guide <Icon name="ArrowRight" size={15} /></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ARCHIVE -->
  <section class="section section-paper" id="articles-grid-section">
    <div class="container">
      <div class="section-header section-header-left">
        <span class="eyebrow">Technical guides archive</span>
        <h2>Explore specialist topics.</h2>
        <p>Curated engineering intelligence covering electrical substations, municipal plumbing codes, and authority approvals.</p>
      </div>

      <div class="blog-grid" id="blog-articles-grid">
        {regularPosts.map((post) => (
          <article class="blog-card" data-category={post.category}>
            <div class="bc-media">
              <img src={post.image} alt={post.title} width="500" height="320" loading="lazy" class="bc-img" />
              <span class="bc-cat-tag">{post.category}</span>
            </div>

            <div class="bc-body">
              <div class="bc-meta">
                <span><Icon name="Calendar" size={12} /> {post.publishDate}</span>
                <span><Icon name="Clock" size={12} /> {post.readTime}</span>
              </div>

              <h3><a href={`/blog/${post.slug}`}>{post.title}</a></h3>
              <p class="bc-summary">{post.summary}</p>

              <div class="bc-footer">
                <span class="bc-author">{post.author.name}</span>
                <a href={`/blog/${post.slug}`} class="bc-read-link">Read article <Icon name="ArrowUpRight" size={13} /></a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div id="no-results-msg" class="no-results-box" style="display: none;">
        <Icon name="SearchX" size={28} />
        <p>No technical guides match your search term. Try searching for "DEWA", "SLD", "PPR", or "load".</p>
      </div>
    </div>
  </section>

  <FAQSection
    title="Frequently asked authority & regulatory questions"
    subtitle="Direct answers from our senior MEP engineers regarding DEWA Red Notices, Trakhees Free Zone jurisdiction, Shams Dubai net metering, and load upgrades."
    badge="DEWA authority FAQ"
    faqs={dewaWorksFaqs}
  />

  <!-- CTA -->
  <section class="section section-ink">
    <div class="container">
      <div class="blog-cta-box">
        <div class="bcb-text">
          <span class="eyebrow light">Direct engineering assistance</span>
          <h2>Have an upcoming fit-out or complex DEWA approval?</h2>
          <p>Avoid costly application rejections and project delays. Speak directly with Founder &amp; Chairman Koyakutty Mohammed and our lead engineering estimators today.</p>
        </div>
        <div class="bcb-actions">
          <a href="/contact" class="btn btn-primary">Request an engineering review <Icon name="ArrowUpRight" size={16} /></a>
          <a href="https://wa.me/971505546943?text=Hello%20Abbadi%20Tech,%20I%20have%20an%20inquiry%20regarding%20DEWA%20approvals%20and%20contracting" target="_blank" rel="noopener" class="btn btn-outline-white"><Icon name="MessageSquare" size={16} /> WhatsApp +971 50 554 6943</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const tabBtns = document.querySelectorAll('.cat-tab-btn');
  const searchInput = document.getElementById('blog-search-input') as HTMLInputElement;
  const cards = document.querySelectorAll<HTMLElement>('.blog-card');
  const featuredCard = document.getElementById('featured-article');
  const noResults = document.getElementById('no-results-msg');

  let activeCat = 'all';
  let searchTerm = '';

  function filterPosts() {
    let visibleCount = 0;

    cards.forEach(card => {
      const cardCat = card.dataset.category || '';
      const cardText = card.textContent?.toLowerCase() || '';

      const matchesCat = activeCat === 'all' || cardCat.toLowerCase() === activeCat.toLowerCase();
      const matchesSearch = !searchTerm || cardText.includes(searchTerm);

      if (matchesCat && matchesSearch) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (featuredCard) {
      const featCat = featuredCard.dataset.category || '';
      const featText = featuredCard.textContent?.toLowerCase() || '';
      const matchesCat = activeCat === 'all' || featCat.toLowerCase() === activeCat.toLowerCase();
      const matchesSearch = !searchTerm || featText.includes(searchTerm);

      if (matchesCat && matchesSearch) {
        featuredCard.style.display = 'grid';
        visibleCount++;
      } else {
        featuredCard.style.display = 'none';
      }
    }

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      tabBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeCat = btn.getAttribute('data-cat') || 'all';
      filterPosts();
    });
  });

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      searchTerm = (e.target as HTMLInputElement).value.toLowerCase().trim();
      filterPosts();
    });
  }
</script>

<style>
  .blog-hero {
    position: relative;
    background: var(--ink-deep);
    color: var(--white);
    padding: clamp(2.75rem, 5vw, 4.5rem) 0 clamp(3rem, 5vw, 4.5rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }

  .hero-inner-container { position: relative; z-index: 2; }

  .crumb {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-heading);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 2.25rem;
  }

  .crumb a:hover { color: var(--brass-soft); }

  .hero-badge-row { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 1rem; }

  .live-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-heading);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--brass-soft);
    border: 1px solid rgba(180, 134, 76, 0.3);
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
  }

  .pulse-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--brass-soft); animation: pulseDot 2.4s ease-in-out infinite; }
  @keyframes pulseDot { 0%, 100% { opacity: 0.35; } 50% { opacity: 1; } }

  .blog-hero h1 {
    color: var(--white);
    font-size: clamp(2.6rem, 5.4vw, 4.4rem);
    margin: 0.9rem 0 1.15rem;
    max-width: 17ch;
  }

  .hero-lead {
    font-size: clamp(1rem, 1.4vw, 1.08rem);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.62);
    max-width: 68ch;
  }

  .blog-filter-section { background: var(--ivory); border-bottom: 1px solid var(--line); padding: 1rem 0; }
  .filter-controls-wrap { display: flex; justify-content: space-between; align-items: center; gap: 1.25rem; flex-wrap: wrap; }
  .category-tabs { display: flex; gap: 0.4rem; flex-wrap: wrap; }

  .cat-tab-btn {
    background: transparent;
    border: 1px solid var(--line-strong);
    color: var(--stone);
    padding: 0.42rem 0.85rem;
    border-radius: 9px;
    font-family: var(--font-heading);
    font-size: 0.74rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.24s, color 0.24s, border-color 0.24s;
  }

  .cat-tab-btn:hover { color: var(--ink); border-color: var(--ink); }
  .cat-tab-btn.active { background: var(--ink); color: var(--white); border-color: var(--ink); }

  .blog-search-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--white);
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    padding: 0 0.85rem;
  }

  .blog-search-box svg { color: var(--stone-light); flex-shrink: 0; }
  .blog-search-box input { border: 0; background: transparent; padding: 0.62rem 0; font-size: 0.82rem; width: 250px; box-shadow: none; }
  .blog-search-box input:focus { outline: none; box-shadow: none; border: 0; }
  .blog-search-box:focus-within { border-color: var(--brass); box-shadow: 0 0 0 4px rgba(180, 134, 76, 0.1); }

  .section-featured-post { background: var(--paper); }
  .section-paper { background: var(--paper); }

  .featured-article-card {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-subtle);
    transition: box-shadow 0.3s;
  }

  .featured-article-card:hover { box-shadow: var(--shadow-md); }

  .fac-media { position: relative; min-height: 360px; background: var(--ink-2); }
  .fac-img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .fac-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    background: rgba(8, 18, 23, 0.7);
    color: var(--brass-soft);
    border: 1px solid rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(6px);
    font-family: var(--font-heading);
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.6rem;
    border-radius: 6px;
  }

  .fac-content { padding: clamp(1.5rem, 3vw, 2.5rem); display: flex; flex-direction: column; }
  .fac-meta-row { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; font-size: 0.72rem; color: var(--stone-light); margin-bottom: 0.75rem; }
  .meta-item { display: inline-flex; align-items: center; gap: 0.3rem; }
  .author-tag { color: var(--teal); font-weight: 600; }

  .fac-content h2 { font-family: var(--font-display); font-size: clamp(1.6rem, 2.6vw, 2.1rem); font-weight: 400; line-height: 1.16; color: var(--ink); margin: 0.5rem 0 0.9rem; }
  .fac-content h2 a:hover { color: var(--brass-deep); }
  .fac-summary { font-size: 0.9rem; color: var(--stone); line-height: 1.7; margin-bottom: 1.75rem; flex-grow: 1; }

  .fac-author-box { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; border-top: 1px solid var(--line); padding-top: 1.1rem; }
  .author-info strong { display: block; font-family: var(--font-heading); font-size: 0.84rem; font-weight: 600; color: var(--ink); }
  .author-info span { font-size: 0.72rem; color: var(--stone-light); }

  .blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }

  .blog-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.28s var(--ease-out), border-color 0.28s, box-shadow 0.28s;
  }

  .blog-card:hover { transform: translateY(-4px); border-color: var(--line-strong); box-shadow: var(--shadow-md); }

  .bc-media { position: relative; height: 190px; background: var(--ink-2); }
  .bc-img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .bc-cat-tag {
    position: absolute;
    bottom: 10px;
    left: 10px;
    background: rgba(8, 18, 23, 0.7);
    color: var(--brass-soft);
    border: 1px solid rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(6px);
    font-family: var(--font-heading);
    font-size: 0.56rem;
    font-weight: 600;
    padding: 0.24rem 0.5rem;
    border-radius: 5px;
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  .bc-body { padding: 1.2rem; display: flex; flex-direction: column; flex-grow: 1; }
  .bc-meta { display: flex; gap: 0.7rem; font-size: 0.66rem; color: var(--stone-light); margin-bottom: 0.55rem; }
  .bc-meta span { display: inline-flex; align-items: center; gap: 0.25rem; }

  .bc-body h3 { font-family: var(--font-heading); font-size: 1rem; font-weight: 600; color: var(--ink); line-height: 1.4; margin-bottom: 0.5rem; }
  .bc-body h3 a:hover { color: var(--brass-deep); }
  .bc-summary { font-size: 0.8rem; color: var(--stone); line-height: 1.6; margin-bottom: 1rem; flex-grow: 1; }

  .bc-footer { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; border-top: 1px solid var(--line); padding-top: 0.8rem; font-size: 0.72rem; }
  .bc-author { color: var(--ink); font-weight: 500; }
  .bc-read-link { display: inline-flex; align-items: center; gap: 0.25rem; color: var(--brass-deep); font-weight: 600; }
  .bc-read-link:hover { color: var(--ink); }

  .no-results-box { text-align: center; padding: 3rem 1rem; color: var(--stone); }
  .no-results-box svg { color: var(--stone-light); margin-bottom: 0.75rem; }
  .no-results-box p { font-size: 0.88rem; }

  .section-ink { background: var(--ink); }
  .blog-cta-box { display: flex; justify-content: space-between; align-items: center; gap: 2.5rem; }
  .bcb-text h2 { font-family: var(--font-display); font-size: clamp(1.9rem, 3.4vw, 2.7rem); font-weight: 400; color: var(--white); margin: 0.8rem 0 0.65rem; max-width: 24ch; }
  .bcb-text p { font-size: 0.92rem; color: rgba(255, 255, 255, 0.55); max-width: 62ch; line-height: 1.7; }
  .bcb-actions { display: flex; flex-direction: column; gap: 0.6rem; flex-shrink: 0; }

  @media (max-width: 1024px) {
    .featured-article-card { grid-template-columns: 1fr; }
    .fac-media { min-height: 260px; }
    .blog-grid { grid-template-columns: 1fr 1fr; }
    .blog-cta-box { flex-direction: column; align-items: flex-start; }
    .bcb-actions { width: 100%; }
    .bcb-actions .btn { width: 100%; }
  }

  @media (max-width: 640px) {
    .blog-hero h1 { font-size: clamp(2.2rem, 10.5vw, 3rem); }
    .blog-grid { grid-template-columns: 1fr; }
    .filter-controls-wrap { flex-direction: column; align-items: stretch; }
    .blog-search-box input { width: 100%; }
    .fac-content { padding: 1.35rem; }
  }
</style>
