---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
import HeroAnimation from '../../../components/HeroAnimation.astro';
import { siteConfig } from '../../../config/site';

const pageTitle = "مقاول كهرباء في دبي | تمديدات ولوحات MDB وتراخيص ديوا | عبادي تك";
const pageDescription = "مقاول كهرباء معتمد في دبي منذ 2005. تجميع لوحات التوزيع MDB/SMDB، تمديدات كهربائية تجارية وسكنية، فحص ميجر واعتمادات ديوا. هاتف: 971505546943+";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": `${siteConfig.primaryDomain}/ar` },
    { "@type": "ListItem", "position": 2, "name": "خدمات المقاولات", "item": `${siteConfig.primaryDomain}/ar` },
    { "@type": "ListItem", "position": 3, "name": "مقاول كهرباء دبي", "item": `${siteConfig.primaryDomain}/ar/services/electrical-contractors-dubai` }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "مقاولات كهربائية في دبي",
  "serviceType": "Commercial & Residential Electrical Contracting, MDB Panel Assembly",
  "provider": {
    "@type": "LocalBusiness",
    "name": siteConfig.legalName,
    "telephone": siteConfig.phoneRaw,
    "email": siteConfig.email,
    "url": `${siteConfig.primaryDomain}/ar/services/electrical-contractors-dubai`
  },
  "areaServed": "Dubai",
  "description": "خدمات المقاولات الكهربائية المعتمدة في دبي: تجميع لوحات التوزيع MDB و SMDB، تمديدات الكابلات وتغذية المشاريع التجارية والسكنية، اختبارات العزل والتأريض."
};

const electricalCapabilitiesAr = [
  {
    title: "تجميع وتركيب لوحات التوزيع (MDB / SMDB / DB)",
    desc: "تصنيع وتجميع لوحات التوزيع الرئيسية والفرعية وفق معايير ديوا، واختبار قواطع التيار ACB و MCCB و ELCB للحماية من زيادة الحمل والتسريب الأرضي.",
    link: "/services/mdb-smdb-panel-assembly-dubai"
  },
  {
    title: "تمديدات الكهرباء التجارية والمكتبية (Commercial Fit-Out)",
    desc: "تنفيذ مسارات الكابلات (Cable Trays / Trunking)، وتوزيع وحدات الإنارة، ونقاط القوى، وتغذية خوادم البيانات وغرف السيرفر والمعدات الحساسة.",
    link: "/services/commercial-electrical-contractor-dubai"
  },
  {
    title: "مقاولات كهرباء الفلل السكنية (Villa Electrical Works)",
    desc: "تأسيس التمديدات الكهربائية للفلل الفاخرة، والإنارة الذكية، والمناظر الطبيعية والمسابح، وترقية قواطع التغذية الرئيسية للأحمال الإضافية.",
    link: "/services/villa-electrical-contractor-dubai"
  },
  {
    title: "محطات شحن السيارات الكهربائية (EV Charger Installation)",
    desc: "تركيب شواحن المركبات الكهربائية المنزلية والتجارية مع موازنة الأحمال الكهربائية واعتماد ديوا للسلامة ومنع التحميل الزائد.",
    link: "/services/ev-charger-installation-dubai"
  },
  {
    title: "عقود الصيانة الكهربائية الوقائية (Electrical AMC)",
    desc: "فحص دوري بالكاميرات الحرارية (Thermal Imaging) للكشف عن ارتفاع حرارة القواطع والبارات النحاسية، واختبارات العزل والتأريض الشاملة.",
    link: "/services/electrical-maintenance-amc-dubai"
  },
  {
    title: "طوارئ الأعطال الكهربائية على مدار الساعة (24/7 Emergency)",
    desc: "فريق طوارئ ميداني متنقل للتعامل مع انقطاع التيار الكهربائي المفاجئ، احتراق القواطع، والالتماس الكهربائي في مختلف مناطق دبي.",
    link: "/services/emergency-electrician-dubai"
  }
];

const faqsAr = [
  {
    q: "ما هي شروط ديوا للوحات التوزيع الكهربائية (MDB & SMDB) في دبي؟",
    a: "تشترط ديوا استخدام لوحات وقواطع مصنفة طبقاً لمعايير IEC، ومعتمدة من جهات تفتيش مستقلة، ومزودة بقواطع حماية تسريب أرضي ملائمة، مع توفير عزل كافٍ وحماية حرارية ومساحات تخديم مطابقة لكود ديوا للكهرباء."
  },
  {
    q: "هل تقومون بتنفيذ مشاريع تشطيب الديكور الداخلي (Fit-Out) للشركات والمطاعم؟",
    a: "نعم، نتولى كافة الأعمال الكهربائية لمشاريع الديكور التجاري والمطاعم والمحلات، بدءاً من مد القنوات ومجاري الكابلات وحسابات الإضاءة ودوائر الطوارئ، وصولاً إلى الفحص النهائي وتوصيل التيار."
  },
  {
    q: "ما هي اختبارات الفحص الكهربائي الميداني قبل إطلاق التيار؟",
    a: "نقوم بإجراء اختبار مقاومة العزل (Megger Test)، واختبار استمرارية التأريض (Earth Loop Impedance)، وفحص أزمنة فصل قواطع التسريب الأرضي (RCD Testing)، واختبار توازن الأحمال بين الفازات الثلاث."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqsAr.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  currentPath="/ar/services/electrical-contractors-dubai"
  englishUrl={`${siteConfig.primaryDomain}/services/electrical-contractors-dubai`}
  isArabic={true}
  canonicalUrl={`${siteConfig.primaryDomain}/ar/services/electrical-contractors-dubai`}
  jsonLd={[breadcrumbSchema, serviceSchema, faqSchema]}
>
  <!-- HERO -->
  <section class="sp-hero ar-hero">
    <HeroAnimation />
    <div class="container hero-inner-container">
      <div class="hero-split">
        <div class="hero-content">
          <span class="badge badge-amber">مقاولات كهربائية معتمدة · دبي منذ 2005</span>
          <h1 class="hero-title">مقاول كهرباء معتمد في دبي للأعمال التجارية والسكنية</h1>
          
          <div class="answer-box">
            <div class="answer-header">
              <Icon name="CheckCircle" size={18} color="var(--brass)" />
              <strong>إجابة مباشرة: نطاق الأعمال الكهربائية والتنفيذ الهندسي</strong>
            </div>
            <p class="answer-text">
              تقدم شركة عبادي تك للحلول الفنية ش.ذ.م.م خدمات المقاولات الكهربائية المتكاملة في دبي للمشاريع التجارية، والمباني الصناعية، والفلل السكنية. نلتزم التزاماً كاملاً بدليل تمديدات هيئة كهرباء ومياه دبي (DEWA Wiring Regulations)، بدءاً من تجميع واختبار لوحات MDB/SMDB، وتمديد كابلات التغذية المسلحة، وصولاً إلى إصدار شهادات الفحص الهندسي المعتمدة.
            </p>
          </div>

          <div class="hero-meta-row">
            <div class="hm-item">
              <span class="hm-label">خبرة الميدان</span>
              <strong class="hm-val">+20 عاماً في مشاريع دبي</strong>
            </div>
            <div class="hm-divider"></div>
            <div class="hm-item">
              <span class="hm-label">الفحص والاختبار</span>
              <strong class="hm-val">100% اختبارات Megger معتمدة</strong>
            </div>
            <div class="hm-divider"></div>
            <div class="hm-item">
              <span class="hm-label">الاعتماد الهندسي</span>
              <strong class="hm-val">مهندسون معتمدون ومؤهلون</strong>
            </div>
          </div>
        </div>

        <!-- RFQ Card -->
        <div class="hero-card">
          <div class="rfq-header">
            <h3>طلب تسعير ومعاينة كهربائية</h3>
            <p>أرسل مخططاتك أو متطلبات موقعك وسيتواصل معك مهندس كهرباء مختص.</p>
          </div>

          <form class="rfq-form" action="/contact" method="GET">
            <div class="form-group">
              <label for="scope-ar">نوع المشروع الكهربائي</label>
              <select id="scope-ar" name="scope" class="form-select">
                <option value="commercial">مشروع ديكور تجاري / مكتبي</option>
                <option value="mdb">تجميع وتركيب لوحة MDB / SMDB</option>
                <option value="villa">تمديدات كهرباء فيلا سكنية</option>
                <option value="amc">عقد صيانة كهربائية وقائية</option>
                <option value="ev">تركيب شاحن سيارة كهربائية EV</option>
              </select>
            </div>

            <div class="form-group">
              <label for="location-ar">موقع المشروع في دبي</label>
              <input type="text" id="location-ar" name="location" placeholder="مثال: القوز، الخليج التجاري، ديرة" required />
            </div>

            <div class="form-group">
              <label for="phone-ar">رقم الهاتف أو الواتساب</label>
              <input type="tel" id="phone-ar" name="phone" placeholder="+971 50 XXX XXXX" required />
            </div>

            <button type="submit" class="btn btn-primary btn-block">
              طلب تسعير ومخطط أولي <Icon name="ArrowUpRight" size={16} />
            </button>
          </form>

          <div class="hotline-strip">
            <Icon name="PhoneCall" size={16} color="var(--brass)" />
            <span>للاستفسار الفوري: <a href={`tel:${siteConfig.phoneRaw}`}>{siteConfig.phone}</a></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CAPABILITIES -->
  <section class="section section-paper">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">خدماتنا الكهربائية التخصصية</span>
        <h2>حلول هندسية متكاملة لجميع المنشآت في إمارة دبي</h2>
        <p class="section-desc">تنفيذ هندسي دقيق بأيدي فنيين ومهندسين دائمين وبأعلى معايير السلامة والجودة.</p>
      </div>

      <div class="ar-services-grid">
        {electricalCapabilitiesAr.map((item) => (
          <div class="ar-card">
            <h3 class="card-title">{item.title}</h3>
            <p class="card-desc">{item.desc}</p>
            <a href={item.link} class="card-link">
              التفاصيل والمواصفات <Icon name="ArrowUpRight" size={15} />
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ENGINEERING QUALITY PILLARS -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">معايير الجودة والسلامة</span>
        <h2>لماذا يعتمد المقاولون والملاك على عبادي تك في دبي؟</h2>
      </div>

      <div class="process-grid">
        <div class="step-card">
          <span class="step-num">01</span>
          <h4>تنسيق هندسي مباشر</h4>
          <p>إعداد واعتماد مخططات SLD ومطابقة متطلبات ديوا لتجنب أي تعارضات أو رفض أثناء التفتيش.</p>
        </div>
        <div class="step-card">
          <span class="step-num">02</span>
          <h4>مواد مطابقة للمواصفات</h4>
          <p>استخدام كابلات معتمدة من دوكاب (Ducab)، وقواطع شنايدر أو ABB، وتمديدات مقاومة للحريق.</p>
        </div>
        <div class="step-card">
          <span class="step-num">03</span>
          <h4>اختبارات عزل دقيقة</h4>
          <p>إجراء اختبارات Megger وفحص مقاومة الأرضي قبل إغلاق الأسقف وإطلاق التيار الكهربائي.</p>
        </div>
        <div class="step-card">
          <span class="step-num">04</span>
          <h4>التزام بالجداول الزمنية</h4>
          <p>فريق فني متمرس يعمل وفق مراحل تنفيذية منضبطة لضمان افتتاح مشروعك دون تأخير.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ SECTION ARABIC -->
  <section class="section section-paper">
    <div class="container" style="max-width: 860px;">
      <div class="section-header">
        <span class="eyebrow">الأسئلة الشائعة</span>
        <h2>إجابات مهندسينا حول المقاولات الكهربائية في دبي</h2>
      </div>

      <div class="ar-faq-list">
        {faqsAr.map((faq) => (
          <div class="ar-faq-item">
            <h3 class="ar-faq-q">{faq.q}</h3>
            <p class="ar-faq-a">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA STRIP -->
  <section class="section-cta">
    <div class="container text-center">
      <h2>هل تبحث عن مقاول كهرباء موثوق لمشروعك في دبي؟</h2>
      <p>مهندسونا جاهزون للمعاينة الفنية ومراجعة المخططات وتقديم عروض أسعار تفصيلية.</p>
      <div class="cta-actions">
        <a href={`tel:${siteConfig.phoneRaw}`} class="btn btn-primary">
          <Icon name="PhoneCall" size={16} /> اتصل الآن: {siteConfig.phone}
        </a>
        <a href={`https://wa.me/${siteConfig.whatsappRaw}?text=${encodeURIComponent('مرحباً، أود استشارة حول مقاولات كهربائية في دبي')}`} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
          <Icon name="MessageSquare" size={16} /> استشارة فورية واتساب
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .ar-hero { text-align: right; }
  .sp-hero {
    background: var(--ink);
    color: var(--white);
    padding: clamp(3rem, 6vw, 5rem) 0 clamp(2.5rem, 5vw, 4rem);
    position: relative;
    overflow: hidden;
  }
  .hero-split {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  .badge-amber {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: rgba(180, 134, 76, 0.2);
    border: 1px solid rgba(180, 134, 76, 0.4);
    color: var(--brass-soft);
    font-size: 0.75rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    line-height: 1.25;
    color: var(--white);
    margin-bottom: 1.5rem;
  }
  .answer-box {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(180, 134, 76, 0.3);
    border-right: 4px solid var(--brass);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
  }
  .answer-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--brass-soft);
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
  }
  .answer-text {
    font-size: 0.95rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
  }
  .hero-meta-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .hm-item { display: flex; flex-direction: column; gap: 0.2rem; }
  .hm-label { font-size: 0.72rem; color: rgba(255, 255, 255, 0.5); }
  .hm-val { font-size: 0.92rem; color: var(--white); font-weight: 600; }
  .hm-divider { width: 1px; height: 28px; background: rgba(255, 255, 255, 0.1); }

  .hero-card {
    background: var(--white);
    color: var(--ink);
    border-radius: var(--radius-lg);
    padding: 2rem;
    box-shadow: var(--shadow-lg);
    text-align: right;
  }
  .rfq-header h3 { font-family: var(--font-heading); font-size: 1.25rem; color: var(--ink); margin-bottom: 0.35rem; }
  .rfq-header p { font-size: 0.82rem; color: var(--stone); margin-bottom: 1.25rem; }
  .form-group { margin-bottom: 1rem; display: flex; flex-direction: column; gap: 0.35rem; }
  .form-group label { font-size: 0.8rem; font-weight: 600; color: var(--ink); }
  .form-group input, .form-select {
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
    font-family: inherit;
    background: var(--white);
    color: var(--ink);
  }
  .hotline-strip { display: flex; align-items: center; justify-content: center; gap: 0.5rem; margin-top: 1.25rem; font-size: 0.82rem; color: var(--stone); }
  .hotline-strip a { color: var(--ink); font-weight: 600; text-decoration: none; }

  .ar-services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    text-align: right;
  }
  .ar-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }
  .ar-card:hover {
    transform: translateY(-3px);
    border-color: var(--brass);
  }
  .card-title { font-family: var(--font-heading); font-size: 1.15rem; color: var(--ink); margin-bottom: 0.6rem; }
  .card-desc { font-size: 0.88rem; line-height: 1.6; color: var(--stone); margin-bottom: 1.25rem; }
  .card-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--navy);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
  }
  .card-link:hover { color: var(--brass); }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    text-align: right;
  }
  .step-card {
    background: var(--paper-warm);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }
  .step-num {
    font-family: var(--font-mono);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--brass);
    display: block;
    margin-bottom: 0.5rem;
  }
  .step-card h4 { font-size: 1rem; color: var(--ink); margin-bottom: 0.5rem; }
  .step-card p { font-size: 0.85rem; color: var(--stone); line-height: 1.6; margin: 0; }

  .ar-faq-list { display: flex; flex-direction: column; gap: 1rem; text-align: right; }
  .ar-faq-item {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }
  .ar-faq-q { font-size: 1.05rem; font-weight: 600; color: var(--ink); margin-bottom: 0.6rem; }
  .ar-faq-a { font-size: 0.9rem; line-height: 1.7; color: var(--stone); margin: 0; }

  .section-cta {
    background: var(--ink);
    color: var(--white);
    padding: clamp(3rem, 5vw, 4.5rem) 0;
    text-align: center;
  }
  .section-cta h2 { font-family: var(--font-heading); font-size: clamp(1.8rem, 3.5vw, 2.5rem); margin-bottom: 0.75rem; color: var(--white); }
  .section-cta p { font-size: 1rem; color: rgba(255, 255, 255, 0.8); max-width: 650px; margin: 0 auto 2rem; }
  .cta-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 900px) {
    .hero-split { grid-template-columns: 1fr; gap: 2rem; }
    .hero-meta-row { flex-wrap: wrap; }
  }
</style>