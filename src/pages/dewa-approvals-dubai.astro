---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import FAQSection from '../components/FAQSection.astro';
import HeroAnimation from '../components/HeroAnimation.astro';
import { dewaWorksFaqs } from '../data/faq';
import { projectsList } from '../data/projects';

const pageTitle = "DEWA Approval Services Dubai | Stamped SLD, NOCs & Meter Energization | Abbadi Tech";
const pageDescription = "Specialized DEWA electrical contractor services in Dubai since 2005. Fast-track fit-out NOCs, stamped Single-Line Diagrams (SLD), power load upgrades & 100% first-pass inspection target.";

const dewaProjects = projectsList
  .filter(p => p.scope === 'electrical' || p.scope === 'both')
  .slice(0, 6);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.abbaditech.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "DEWA Approval Services",
      "item": "https://www.abbaditech.com/dewa-approvals-dubai"
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "DEWA Approval Services",
  "serviceType": "DEWA Electrical & Water Approvals, SLD Design & Meter Energization",
  "provider": {
    "@type": "LocalBusiness",
    "name": "DEWA Approvals Dubai - Division of Abbadi Tech Technical Solutions LLC",
    "telephone": "+971505546943",
    "email": "it.abbaditech@gmail.com",
    "url": "https://www.abbaditech.com/dewa-approvals-dubai"
  },
  "areaServed": "Dubai",
  "description": "Specialized division of Abbadi Tech Technical Solutions LLC providing fast-track DEWA approvals, load enhancement, electrical drawing design, and meter installation across Dubai."
};
---

<Layout 
  title={pageTitle} 
  description={pageDescription} 
  currentPath="/dewa-approvals-dubai"
  jsonLd={[breadcrumbSchema, serviceSchema]}
>
  <!-- HERO WITH LEAD CAPTURE FORM -->
  <section class="dewa-hero" style="position: relative; overflow: hidden;">
    <HeroAnimation />
    <div class="container dewa-hero-container" style="position: relative; z-index: 2;">
      <div class="dewa-hero-text">
        <div class="crumb">
          <a href="/">Home</a> <span>/</span> <span>DEWA Approval Services</span>
        </div>

        <div class="lead-division-badge">
          <span class="pulse-dot"></span>
          <span>Official Technical Division of Abbadi Tech Technical Solutions LLC</span>
        </div>

        <h1>DEWA APPROVAL <span class="text-gradient">SERVICES</span></h1>
        
        <p class="lead-desc">
          Accelerate your commercial fit-out, retail shop, restaurant, or villa with certified DEWA approvals. We engineer stamped Single-Line Diagrams (SLD), calculate connected load schedules, and manage authority submissions directly to live meter energization with a 100% first-pass pass rate.
        </p>

        <!-- Trust stats -->
        <div class="dewa-trust-row">
          <div class="dt-item">
            <strong>21+ Years</strong>
            <span>UAE Experience</span>
          </div>
          <div class="dt-divider"></div>
          <div class="dt-item">
            <strong>3 - 5 Days</strong>
            <span>Typical NOC Turnaround</span>
          </div>
          <div class="dt-divider"></div>
          <div class="dt-item">
            <strong>100%</strong>
            <span>First-Pass Inspection Target</span>
          </div>
        </div>

        <div class="direct-hotline-box">
          <div class="dh-icon"><Icon name="PhoneCall" size={24} color="#FF9500" /></div>
          <div>
            <span class="dh-label">Urgent Approval Hotline (24/7):</span>
            <a href="tel:+971505546943" class="dh-num">+971 50 554 6943</a>
          </div>
        </div>
      </div>

      <!-- Lead Capture Card -->
      <div class="dewa-lead-card" id="lead-form-section">
        <div class="dlc-header">
          <span class="badge badge-gold">Fast Response</span>
          <h3>Request Fast-Track DEWA Approval</h3>
          <p>Submit your site requirements below for same-day engineering review.</p>
        </div>

        <form class="dewa-form" id="dewa-lead-form">
          <div class="form-group">
            <label for="lead-name">Your Full Name *</label>
            <input type="text" id="lead-name" name="name" required placeholder="e.g. Tariq Al Mansoori" class="form-input" />
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="lead-phone">Mobile / WhatsApp *</label>
              <input type="tel" id="lead-phone" name="phone" required placeholder="+971 50 000 0000" class="form-input" />
            </div>
            <div class="form-group">
              <label for="lead-email">Business Email</label>
              <input type="email" id="lead-email" name="email" placeholder="name@company.com" class="form-input" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="lead-type">Property Category *</label>
              <select id="lead-type" name="property_type" required class="form-input">
                <option value="Retail Mall Boutique">Retail Mall Boutique / Shop</option>
                <option value="Restaurant / F&B Cafe">Restaurant / F&B Cafe</option>
                <option value="Corporate Office Tower">Corporate Office Tower</option>
                <option value="Luxury Private Villa">Luxury Private Villa</option>
                <option value="Industrial Warehouse">Industrial Warehouse / Factory</option>
                <option value="Other Commercial Unit">Other Commercial Unit</option>
              </select>
            </div>
            <div class="form-group">
              <label for="lead-scope">Required DEWA Service *</label>
              <select id="lead-scope" name="service_scope" required class="form-input">
                <option value="DEWA Fit-Out NOC">DEWA Fit-Out NOC (Decoration)</option>
                <option value="Power Load Upgrade">Power Load Upgrade (Enhancement)</option>
                <option value="SLD & Load Schedule Design">Single-Line Diagram (SLD) Design</option>
                <option value="Smart Meter Release & Energization">Smart Meter Release &amp; Energization</option>
                <option value="Inspection Red Notice Rectification">Inspection Rejection Rectification</option>
                <option value="DEWA Water Connection">DEWA Water Connection NOC</option>
                <option value="Temporary Builder Power">Temporary Construction Power</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="lead-details">Unit Location / Premise ID / Connected Load (kW)</label>
            <textarea id="lead-details" name="details" rows="3" placeholder="Mention building/mall name (e.g. Dubai Mall, Business Bay, JLT), premise ID, or existing load..." class="form-input"></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-block btn-shimmer" id="lead-submit-btn">
            ⚡ Submit For Fast-Track DEWA Approval →
          </button>

          <p class="form-privacy-note">
            <Icon name="ShieldCheck" size={14} color="#10B981" /> 100% Confidential. Directly handled by Abbadi Tech Technical Solutions LLC.
          </p>
        </form>
      </div>
    </div>
  </section>

  <!-- ACCREDITATIONS & AUTHORITY TRUST BAR -->
  <div class="authority-trust-bar">
    <div class="container atb-inner">
      <span class="atb-title">Accreditations &amp; Quality Compliance:</span>
      <div class="atb-badges">
        <span class="atb-item">✓ 21+ Years Continuous UAE Operations</span>
        <span class="atb-item">✓ Dubai Municipality Compliant</span>
        <span class="atb-item">✓ Dubai Civil Defence Compliant</span>
        <span class="atb-item">✓ ISO 9001:2015 Certified Protocols</span>
        <span class="atb-item highlight">✓ 100% First-Pass Inspection Target</span>
      </div>
    </div>
  </div>

  <!-- INTERACTIVE LOAD & COST ESTIMATOR -->
  <section class="section section-estimator" id="estimator-section">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-gold">Interactive Project Estimator</span>
        <h2>Estimate Your DEWA Approval Scope &amp; Timeline</h2>
        <p class="section-sub">Configure your property category and electrical load to view required authority documentation, turnaround timelines, and request a tailored quote.</p>
      </div>

      <div class="estimator-box">
        <div class="estimator-grid">
          <div class="estimator-inputs">
            <div class="input-block">
              <div class="slider-header">
                <label><strong>Connected Electrical Load (kW):</strong></label>
                <span id="load-display" class="load-display-tag">35 kW</span>
              </div>
              <input type="range" id="load-slider" min="5" max="300" step="5" value="35" class="load-range-slider" />
              <div class="slider-markers">
                <span>5 kW (Kiosk)</span>
                <span>50 kW (Boutique)</span>
                <span>150 kW (Restaurant)</span>
                <span>300+ kW (Industrial)</span>
              </div>
            </div>

            <div class="input-row">
              <div class="input-block">
                <label for="calc-prop">Property Category:</label>
                <select id="calc-prop" class="form-input">
                  <option value="retail">Retail Shop / Mall Store</option>
                  <option value="restaurant">Restaurant / Commercial Kitchen</option>
                  <option value="office">Corporate Office Tower</option>
                  <option value="warehouse">Industrial Warehouse</option>
                  <option value="villa">Luxury Villa / Residential</option>
                </select>
              </div>
              <div class="input-block">
                <label for="calc-scope">Required Authority Scope:</label>
                <select id="calc-scope" class="form-input">
                  <option value="fitout">DEWA Fit-Out NOC (Decoration)</option>
                  <option value="load_upgrade">Power Load Upgrade (Enhancement)</option>
                  <option value="meter">Smart Meter Release &amp; Energization</option>
                  <option value="rectification">Inspection Red Notice Rectification</option>
                </select>
              </div>
            </div>
          </div>

          <div class="estimator-result">
            <span class="er-title">Project Engineering Estimate</span>
            <div class="er-price" id="calc-price" style="font-size: 1.85rem; color: #E8A85C; font-weight: 700;">Custom Quote</div>
            <div class="er-days" id="calc-days">Flexible Pricing &bull; Turnaround: 3 - 5 Days</div>

            <div class="er-details">
              <div><span>Inspection Standard:</span> <strong style="color: #10B981;">100% First-Pass Target</strong></div>
              <div><span>Deliverables:</span> <strong id="calc-docs" style="color: #FFFFFF;">SLD + DEWA NOC</strong></div>
              <div><span>Pricing Policy:</span> <strong style="color: #38BDF8;">Tailored to Scope &amp; Client</strong></div>
            </div>

            <button type="button" class="btn btn-primary btn-block" id="calc-whatsapp-btn">
              <span>Request Tailored Quote via WhatsApp →</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 8 CORE DEWA APPROVAL LEAD SERVICES -->
  <section class="section" id="services-section">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-gold">Core Capabilities</span>
        <h2>Comprehensive DEWA Approval Services in Dubai</h2>
        <p class="section-sub">
          With over 21 years of specialized Dubai engineering practice, we manage every phase of authority documentation, technical calculation, and physical site coordination.
        </p>
      </div>

      <div class="dewa-services-grid">
        <!-- 1 -->
        <div class="dewa-service-card card-interactive">
          <div class="dsc-top">
            <div class="dsc-icon"><Icon name="FileCheck" size={26} color="#FF9500" /></div>
            <span class="dsc-time">3 - 5 Days</span>
          </div>
          <h3>1. DEWA Fit-Out NOC (Decoration)</h3>
          <p>Complete engineering documentation and E-Services portal submission for retail shops, offices, and restaurants to secure fast DEWA No Objection Certificates without delay.</p>
          <ul class="dsc-points">
            <li>Review tenancy manuals &amp; landlord permits</li>
            <li>Submission of approved layouts &amp; electrical load</li>
            <li>Fast 3 to 5 business day approval turnaround</li>
          </ul>
        </div>

        <!-- 2 -->
        <div class="dewa-service-card card-interactive">
          <div class="dsc-top">
            <div class="dsc-icon"><Icon name="Zap" size={26} color="#FF9500" /></div>
            <span class="dsc-time">7 - 14 Days</span>
          </div>
          <h3>2. Power Load Upgrades &amp; Enhancements</h3>
          <p>Need extra electrical power for heavy commercial ovens, chillers, or EV charging stations? We conduct connected load audits and secure DEWA sanctions for increased kilowatt capacity.</p>
          <ul class="dsc-points">
            <li>Assessment of building transformer margin</li>
            <li>Load schedule revision &amp; breaker enhancement</li>
            <li>Substation upgrade coordination with DEWA</li>
          </ul>
        </div>

        <!-- 3 -->
        <div class="dewa-service-card card-interactive">
          <div class="dsc-top">
            <div class="dsc-icon"><Icon name="Layers" size={26} color="#FF9500" /></div>
            <span class="dsc-time">24 - 48 Hours</span>
          </div>
          <h3>3. Certified Single-Line Diagrams (SLD)</h3>
          <p>Under Dubai law, qualified electrical engineering specialists draft and stamp electrical schematics. We calculate diversified maximum demand and engineer compliant SLDs matching DEWA regulations.</p>
          <ul class="dsc-points">
            <li>Precise cable sizing &amp; voltage drop formulas</li>
            <li>Phase balancing (Red, Yellow, Blue)</li>
            <li>RCD, MCCB, and MCB protection calibration</li>
          </ul>
        </div>

        <!-- 4 -->
        <div class="dewa-service-card card-interactive">
          <div class="dsc-top">
            <div class="dsc-icon"><Icon name="Landmark" size={26} color="#FF9500" /></div>
            <span class="dsc-time">Turnkey</span>
          </div>
          <h3>4. MDB Panel Assembly &amp; Intake Rooms</h3>
          <p>We supply, build, and test Main Distribution Boards (MDB), Sub-Main Boards (SMDB), and meter cabinets in strict accordance with DEWA spatial and safety regulations.</p>
          <ul class="dsc-points">
            <li>Factory-tested busbars and ferruled wiring</li>
            <li>DEWA-compliant rubber floor mats &amp; directories</li>
            <li>Adequate ventilation &amp; spatial clearances</li>
          </ul>
        </div>

        <!-- 5 -->
        <div class="dewa-service-card card-interactive">
          <div class="dsc-top">
            <div class="dsc-icon"><Icon name="CheckCircle2" size={26} color="#FF9500" /></div>
            <span class="dsc-time">2 - 3 Days</span>
          </div>
          <h3>5. Smart Meter Fixing &amp; Energization</h3>
          <p>Following successful field inspection pass, we coordinate with DEWA technicians to mount and commission the smart kilowatt-hour meter, releasing live electrical power to your premises.</p>
          <ul class="dsc-points">
            <li>CT chamber wiring for loads exceeding 100A</li>
            <li>Communication conduit verification</li>
            <li>Immediate live power turn-on</li>
          </ul>
        </div>

        <!-- 6 -->
        <div class="dewa-service-card card-interactive">
          <div class="dsc-top">
            <div class="dsc-icon"><Icon name="AlertTriangle" size={26} color="#FF9500" /></div>
            <span class="dsc-time">Emergency 48h</span>
          </div>
          <h3>6. Inspection Rejection Rectification</h3>
          <p>Did an uncertified fit-out contractor fail your DEWA inspection? We conduct urgent diagnostic site audits, rectify all wiring/earthing non-compliances, and secure re-inspection clearance.</p>
          <ul class="dsc-points">
            <li>Correction of cable gauge &amp; earthing resistance (&lt;1.0Ω)</li>
            <li>Resolution of phase imbalance &amp; labeling faults</li>
            <li>Rapid re-scheduling of DEWA inspectors</li>
          </ul>
        </div>

        <!-- 7 -->
        <div class="dewa-service-card card-interactive">
          <div class="dsc-top">
            <div class="dsc-icon"><Icon name="Droplets" size={26} color="#FF9500" /></div>
            <span class="dsc-time">5 - 7 Days</span>
          </div>
          <h3>7. DEWA Water Connection &amp; Meter Manifolds</h3>
          <p>Turnkey approvals for commercial potable water connections, water meter cabinets, grease interceptors, and high-pressure booster pump stations.</p>
          <ul class="dsc-points">
            <li>Water schematic drawings &amp; piping calculation</li>
            <li>Multi-tenant water meter manifold installation</li>
            <li>Hydrostatic pressure hold test certification</li>
          </ul>
        </div>

        <!-- 8 -->
        <div class="dewa-service-card card-interactive">
          <div class="dsc-top">
            <div class="dsc-icon"><Icon name="Cpu" size={26} color="#FF9500" /></div>
            <span class="dsc-time">Fast-Track</span>
          </div>
          <h3>8. Temporary Construction Power Supply</h3>
          <p>Fast-track builder temporary power supply for construction sites, villa developments, and major civil contractor projects across Dubai.</p>
          <ul class="dsc-points">
            <li>Temporary builder supply kiosk &amp; metering</li>
            <li>Earth leakage protection &amp; site transformers</li>
            <li>Conversion to permanent supply upon completion</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- COMPARISON TABLE: ABBADI TECH VS GENERIC CONTRACTORS -->
  <section class="section section-comparison">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-gold">Transparent Comparison</span>
        <h2>Why Choose Abbadi Tech DEWA Division Over Generic Contractors?</h2>
        <p class="section-sub">Don't risk project opening delays, failed inspections, or landlord fines. See how our certified engineering approach outperforms general market competitors.</p>
      </div>

      <div class="comp-table-container">
        <table class="comp-table">
          <thead>
            <tr>
              <th style="width: 34%;">Technical Standard</th>
              <th class="th-prime" style="width: 36%;">Abbadi Tech DEWA Division</th>
              <th style="width: 30%;">Generic Contractors / Freelancers</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>DEWA Engineering Capability</strong></td>
              <td class="td-prime"><span class="c-tick">✓</span> Dedicated In-House Specialists Since 2005</td>
              <td><span class="c-cross">✗</span> Subcontracted or inexperienced personnel</td>
            </tr>
            <tr>
              <td><strong>First-Pass Inspection Pass Rate</strong></td>
              <td class="td-prime"><span class="c-tick">✓</span> 100% Guaranteed First-Pass Inspection</td>
              <td><span class="c-cross">✗</span> High failure rate (undersized cables, earthing faults)</td>
            </tr>
            <tr>
              <td><strong>Pre-Inspection Megger &amp; Earth Testing</strong></td>
              <td class="td-prime"><span class="c-tick">✓</span> Calibrated Insulation &amp; Earth Testing (&lt;1.0Ω)</td>
              <td><span class="c-cross">✗</span> Skipped or performed with uncalibrated equipment</td>
            </tr>
            <tr>
              <td><strong>SLD Drafting &amp; Stamping</strong></td>
              <td class="td-prime"><span class="c-tick">✓</span> In-House Licensed Electrical Engineers (24-48h)</td>
              <td><span class="c-cross">✗</span> Outsourced to external draftsmen with long delays</td>
            </tr>
            <tr>
              <td><strong>DEWA Portal Direct Access</strong></td>
              <td class="td-prime"><span class="c-tick">✓</span> Direct E-Services Corporate Portal Tracking</td>
              <td><span class="c-cross">✗</span> Middleman delays &amp; lack of authority liaison</td>
            </tr>
            <tr>
              <td><strong>MDB / Panel Assembly Capabilities</strong></td>
              <td class="td-prime"><span class="c-tick">✓</span> In-House Assembly, Ferruled Wiring &amp; Busbar Testing</td>
              <td><span class="c-cross">✗</span> Sourced from cheap third-party fabricators</td>
            </tr>
            <tr>
              <td><strong>Inspection Presence</strong></td>
              <td class="td-prime"><span class="c-tick">✓</span> Senior Licensed Engineer on Site with Inspector</td>
              <td><span class="c-cross">✗</span> Junior labor on site with no authority communication</td>
            </tr>
            <tr>
              <td><strong>Emergency Rectification Turnaround</strong></td>
              <td class="td-prime"><span class="c-tick">✓</span> 24 to 48 Hours for Red Notice Clearance</td>
              <td><span class="c-cross">✗</span> 2 to 4 weeks, risking commercial rent penalties</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- TAILORED APPROVAL SERVICE PACKAGES -->
  <section class="section section-pricing">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-gold">Tailored Solutions</span>
        <h2>Flexible DEWA Approval Service Packages</h2>
        <p class="section-sub">Flexible engineering solutions tailored specifically to your project requirements, client scope, and connected load. Contact us for a competitive, project-specific quotation.</p>
      </div>

      <div class="pricing-cards-grid">
        <div class="pkg-card">
          <h4>Fit-Out NOC Fast-Track</h4>
          <p class="pkg-desc">Ideal for retail shops, cafes, and offices needing quick tenancy approval.</p>
          <div class="pkg-price" style="font-size: 1.75rem; color: #E8A85C;">Custom Quote <span style="font-size: 0.85rem; color: #94A3B8;">/ Project-Based</span></div>
          <span class="pkg-time">Flexible Pricing &bull; Turnaround: 3 - 5 Business Days</span>
          <ul class="pkg-list">
            <li>Single-Line Diagram (SLD) Design</li>
            <li>Connected Load Schedule Calculation</li>
            <li>DEWA E-Services Portal Submission</li>
            <li>Landlord Tenancy NOC Coordination</li>
            <li>Tracking until formal NOC issuance</li>
          </ul>
          <a href="https://wa.me/971505546943?text=Hello%20Abbadi%20Tech,%20I%20would%20like%20a%20custom%20quote%20for%20the%20Fit-Out%20NOC%20Fast-Track%20Package" target="_blank" rel="noopener" class="btn btn-outline-white btn-block">Get Custom Quote →</a>
        </div>

        <div class="pkg-card pkg-featured">
          <span class="pkg-badge">Comprehensive</span>
          <h4>Turnkey Meter Energization</h4>
          <p class="pkg-desc">Full end-to-end service from drawing approval to live meter power turn-on.</p>
          <div class="pkg-price" style="font-size: 1.75rem; color: #E8A85C;">Custom Quote <span style="font-size: 0.85rem; color: #94A3B8;">/ Turnkey Scope</span></div>
          <span class="pkg-time">Flexible Pricing &bull; Turnaround: 5 - 10 Business Days</span>
          <ul class="pkg-list">
            <li>All items in Fit-Out NOC Package</li>
            <li>Pre-Inspection Site Megger &amp; Earth Test</li>
            <li>DEWA Inspection Booking &amp; Coordination</li>
            <li>Senior Engineer on Site with Inspector</li>
            <li>Smart Meter Release &amp; Energization</li>
            <li>100% First-Pass Pass Guarantee</li>
          </ul>
          <a href="https://wa.me/971505546943?text=Hello%20Abbadi%20Tech,%20I%20would%20like%20a%20custom%20quote%20for%20the%20Turnkey%20Meter%20Energization%20Package" target="_blank" rel="noopener" class="btn btn-primary btn-block">Get Custom Quote →</a>
        </div>

        <div class="pkg-card">
          <h4>Power Load Upgrade</h4>
          <p class="pkg-desc">For commercial kitchens, restaurants, bakeries, or EV charging stations.</p>
          <div class="pkg-price" style="font-size: 1.75rem; color: #E8A85C;">Custom Quote <span style="font-size: 0.85rem; color: #94A3B8;">/ Based on Additional Load</span></div>
          <span class="pkg-time">Flexible Pricing &bull; Turnaround: 7 - 14 Business Days</span>
          <ul class="pkg-list">
            <li>Transformer &amp; Substation Capacity Audit</li>
            <li>Upgraded SLD &amp; Cable Sizing Calculation</li>
            <li>DEWA Load Addition Sanction Application</li>
            <li>Main Breaker &amp; Busbar Enhancement</li>
            <li>Coordination with DEWA distribution division</li>
          </ul>
          <a href="https://wa.me/971505546943?text=Hello%20Abbadi%20Tech,%20I%20would%20like%20a%20custom%20quote%20for%20the%20Power%20Load%20Upgrade%20Package" target="_blank" rel="noopener" class="btn btn-outline-white btn-block">Get Custom Quote →</a>
        </div>

        <div class="pkg-card">
          <h4>Emergency Rectification</h4>
          <p class="pkg-desc">Did another contractor fail your DEWA site inspection? We fix it rapidly.</p>
          <div class="pkg-price" style="font-size: 1.75rem; color: #E8A85C;">Custom Quote <span style="font-size: 0.85rem; color: #94A3B8;">/ Rapid Diagnostic</span></div>
