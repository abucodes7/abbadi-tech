<script>
  // 1. WhatsApp Lead Form Submission
  const leadForm = document.getElementById('dewa-lead-form') as HTMLFormElement;
  if (leadForm) {
    leadForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('lead-name') as HTMLInputElement)?.value || '';
      const phone = (document.getElementById('lead-phone') as HTMLInputElement)?.value || '';
      const email = (document.getElementById('lead-email') as HTMLInputElement)?.value || '';
      const type = (document.getElementById('lead-type') as HTMLSelectElement)?.value || '';
      const scope = (document.getElementById('lead-scope') as HTMLSelectElement)?.value || '';
      const details = (document.getElementById('lead-details') as HTMLTextAreaElement)?.value || '';

      const waMsg = `Hello Abbadi Tech (DEWA Approvals Dubai), I am requesting an approval assessment:%0A%0A*Name:* ${encodeURIComponent(name)}%0A*Phone:* ${encodeURIComponent(phone)}%0A*Email:* ${encodeURIComponent(email)}%0A*Property Type:* ${encodeURIComponent(type)}%0A*Required Service:* ${encodeURIComponent(scope)}%0A*Details:* ${encodeURIComponent(details)}`;

      window.open(`https://wa.me/971505546943?text=${waMsg}`, '_blank');
    });
  }

  // 2. Interactive Load & Cost Calculator
  const loadSlider = document.getElementById('load-slider') as HTMLInputElement;
  const loadDisplay = document.getElementById('load-display');
  const calcProp = document.getElementById('calc-prop') as HTMLSelectElement;
  const calcScope = document.getElementById('calc-scope') as HTMLSelectElement;
  const calcPrice = document.getElementById('calc-price');
  const calcDays = document.getElementById('calc-days');
  const calcDocs = document.getElementById('calc-docs');
  const calcWaBtn = document.getElementById('calc-whatsapp-btn');

  function updateCalculator() {
    if (!loadSlider || !calcPrice) return;
    const loadKW = parseInt(loadSlider.value) || 35;
    if (loadDisplay) loadDisplay.textContent = `${loadKW} kW`;

    const prop = calcProp ? calcProp.value : 'retail';
    const scope = calcScope ? calcScope.value : 'fitout';

    let basePrice = 2800;
    let days = '3 - 5 Days';
    let docs = 'SLD + Tenancy NOC + Load Schedule';

    if (scope === 'load_upgrade') {
      basePrice = 4500 + (loadKW * 35);
      days = '7 - 14 Days';
      docs = 'Substation Audit + New SLD + DEWA Sanction';
    } else if (scope === 'meter') {
      basePrice = 3200 + (loadKW * 20);
      days = '4 - 7 Days';
      docs = 'Inspection Clearance + Meter Requisition';
    } else if (scope === 'rectification') {
      basePrice = 2500;
      days = '2 - 4 Days';
      docs = 'Notice Audit + Megger Test + Re-inspection';
    } else {
      basePrice = 2800 + (loadKW * 15);
      days = '3 - 5 Days';
      docs = 'Architectural Layout + SLD + DEWA NOC';
    }

    if (prop === 'restaurant') basePrice *= 1.25;
    if (prop === 'warehouse') basePrice *= 1.35;
    if (prop === 'villa') basePrice *= 1.15;

    calcPrice.innerHTML = `<span style="font-size: 1.6rem; color: #E8A85C; font-weight: 700;">Custom Quote</span>`;
    if (calcDays) calcDays.textContent = `Flexible Pricing • Turnaround: ${days}`;
    if (calcDocs) calcDocs.textContent = docs;
  }

  if (loadSlider) loadSlider.addEventListener('input', updateCalculator);
  if (calcProp) calcProp.addEventListener('change', updateCalculator);
  if (calcScope) calcScope.addEventListener('change', updateCalculator);
  updateCalculator();

  if (calcWaBtn) {
    calcWaBtn.addEventListener('click', () => {
      const loadKW = loadSlider ? loadSlider.value : '35';
      const propText = calcProp ? calcProp.options[calcProp.selectedIndex].text : 'Retail';
      const scopeText = calcScope ? calcScope.options[calcScope.selectedIndex].text : 'DEWA Fit-Out NOC';

      const waMsg = `Hello Abbadi Tech DEWA Desk, I am requesting a project-specific quote:%0A%0A*Scope:* ${encodeURIComponent(scopeText)}%0A*Property:* ${encodeURIComponent(propText)}%0A*Load:* ${loadKW} kW%0A*Pricing:* Tailored to project requirements%0A%0APlease provide your competitive quotation.`;

      window.open(`https://wa.me/971505546943?text=${waMsg}`, '_blank');
    });
  }

  // 3. Floating WhatsApp Widget Toggle
  const waTrigger = document.getElementById('wa-trigger-bubble');
  const waPopup = document.getElementById('wa-popup-box');
  const waClose = document.getElementById('wa-popup-close');

  if (waTrigger && waPopup) {
    waTrigger.addEventListener('click', () => {
      waPopup.classList.toggle('active');
    });
  }

  if (waClose && waPopup) {
    waClose.addEventListener('click', () => {
      waPopup.classList.remove('active');
    });
  }

  document.querySelectorAll('.wa-quick-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const text = btn.getAttribute('data-text') || 'Hello DEWA Approvals Dubai, I need consultation.';
      window.open(`https://wa.me/971505546943?text=${encodeURIComponent(text)}`, '_blank');
    });
  });
</script>

