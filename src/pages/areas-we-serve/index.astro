---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import FAQSection from '../../components/FAQSection.astro';
import HeroAnimation from '../../components/HeroAnimation.astro';
import { areasData } from '../../data/areas';
import { projectsList } from '../../data/projects';
import { areasFaqs } from '../../data/faq';

const pageTitle = "Areas We Serve in Dubai & UAE | MEP Contractors | Abbadi Tech";
const pageDescription = "Explore Abbadi Tech's MEP contracting coverage across Dubai and the UAE: Dubai Central HQ, Downtown, DIFC, Palm Jumeirah, JLT, Dubai Marina, DIP, and Abu Dhabi.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.abbaditech.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Areas We Serve",
      "item": "https://www.abbaditech.com/areas-we-serve"
    }
  ]
};
---

<Layout 
  title={pageTitle} 
  description={pageDescription} 
  currentPath="/areas-we-serve"
  jsonLd={breadcrumbSchema}
>
  <!-- AREAS HERO -->
  <section class="areas-hero">
    <HeroAnimation />
    <div class="container hero-inner-container">
      <div class="crumb">
        <a href="/">Home</a> <span>/</span> <span>Areas We Serve</span>
      </div>

      <div class="hero-inner">
        <span class="badge badge-gold">Strategic UAE Coverage</span>
        <h1>AREAS WE SERVE: DUBAI, ABU DHABI &amp; AJMAN</h1>
        <p class="hero-lead">
          Headquartered in Dubai behind Al Khail Mall, Abbadi Tech LLC deploys rapid-response MEP engineering teams across Dubai's prime commercial corridors, financial free zones, luxury waterfronts, and industrial logistics parks.
        </p>

        <div class="hero-stats">
          <div class="stat-card">
            <span class="stat-num text-gradient">Dubai</span>
            <span class="stat-label">Central UAE HQ</span>
          </div>
          <div class="stat-card">
            <span class="stat-num" style="color:var(--primary)">15-45m</span>
            <span class="stat-label">Average Site Dispatch</span>
          </div>
          <div class="stat-card">
            <span class="stat-num" style="color:var(--plumbing-light)">3</span>
            <span class="stat-label">Emirates Covered</span>
          </div>
          <div class="stat-card">
            <span class="stat-num" style="color:#10b981">1000+</span>
            <span class="stat-label">Delivered Projects</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- REGIONAL HUBS SHOWCASE -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-blue">Local Engineering Hubs</span>
        <h2>Key Districts &amp; Coverage Zones</h2>
        <p class="section-sub">
          Click any area to review dedicated technical capabilities, landmark projects, and response guarantees.
        </p>
      </div>

      <div class="areas-list-grid">
        {areasData.map((area) => {
          const areaProjects = projectsList.filter(p => p.area.toLowerCase().includes(area.id.replace('-', '')) || p.location.toLowerCase().includes(area.name.toLowerCase().split(' ')[0])).slice(0, 4);

          return (
            <div class="area-detail-card" id={area.slug}>
              <div class="area-card-header">
                <div>
                  <span class="badge badge-gold">{area.responseTime} Dispatch</span>
                  <h3>{area.name}</h3>
                </div>
                <span class="projects-count-pill">{area.projectsCount}</span>
              </div>

              <h4 class="area-subhead">{area.headline}</h4>
              <p class="area-desc">{area.description}</p>

              <div class="area-specs-grid">
                <div class="spec-block">
                  <h5>Key Landmarks Covered:</h5>
                  <div class="tags-row">
                    {area.keyLandmarks.map((lm) => (
                      <span class="tag-chip">{lm}</span>
                    ))}
                  </div>
                </div>

                <div class="spec-block">
                  <h5>Primary Services Deployed:</h5>
                  <ul class="check-list">
                    {area.servicesOffered.map((srv) => (
                      <li>{srv}</li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class="area-cta-row">
                <a href="/contact" class="btn btn-primary btn-sm">
                  Request Site Survey in {area.name.split('&')[0]} <Icon name="ArrowRight" size={14} />
                </a>
                <a href={`https://wa.me/971505546943?text=Hi%20Abbadi%20Tech,%20I%20need%20an%20engineer%20in%20${encodeURIComponent(area.name)}`} target="_blank" rel="noopener" class="btn btn-outline-white btn-sm">
                  <Icon name="MessageSquare" size={14} /> WhatsApp Local Dispatch
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- FAQ SECTION -->
  <FAQSection 
    title="Frequently Asked Questions: Dubai & UAE Regional Contracting" 
    subtitle="Direct answers on jurisdiction approvals: Dubai Municipality, DDA, DMCC, Trakhees, Nakheel, and Abu Dhabi."
    badge="Jurisdiction & Coverage FAQ"
    faqs={areasFaqs}
  />

  <!-- CTA -->
  <section class="section section-cta">
    <div class="container">
      <div class="cta-inner-card">
        <h2>Operating Anywhere in Dubai, Abu Dhabi, or Ajman?</h2>
        <p>Our mobile technical estimator teams are ready to inspect your site, evaluate existing load schedules, and provide an official quotation within 24 hours.</p>
        <div class="cta-btns">
          <a href="/contact" class="btn btn-primary">
            Book Free Site Survey <Icon name="ArrowRight" size={16} />
          </a>
          <a href="tel:+971505546943" class="btn btn-secondary">
            <Icon name="Phone" size={16} /> Call Dispatch: +971 50 554 6943
          </a>
          <a href="mailto:it.abbaditech@gmail.com" class="btn btn-outline-white">
            <Icon name="Mail" size={16} /> it.abbaditech@gmail.com
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .areas-hero {
    position: relative;
    padding: 5rem 0 4rem;
    background: var(--color-navy-dark);
    border-bottom: 1px solid var(--color-navy-border);
    overflow: hidden;
  }

  .hero-inner-container {
    position: relative;
    z-index: 2;
  }

  .crumb {
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-bottom: 1.25rem;
  }

  .crumb a {
    color: var(--text-muted);
  }

  .crumb a:hover {
    color: var(--primary);
  }

  .crumb span {
    margin: 0 0.35rem;
  }

  .hero-inner h1 {
    font-size: 2.4rem;
    color: #fff;
    margin-top: 0.8rem;
    margin-bottom: 1rem;
    max-width: 900px;
  }

  .hero-lead {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 820px;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    background: #111724;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    max-width: 900px;
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .stat-num {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 0.35rem;
  }

  .stat-label {
    font-size: 0.78rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .areas-list-grid {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .area-detail-card {
    background: #111724;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    transition: border-color 0.2s ease;
  }

  .area-detail-card:hover {
    border-color: var(--primary);
  }

  .area-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .area-card-header h3 {
    font-size: 1.75rem;
    color: #fff;
    margin-top: 0.4rem;
  }

  .projects-count-pill {
    background: #182030;
    border: 1px solid rgba(255, 149, 0, 0.4);
    color: var(--primary);
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-full);
  }

  .area-subhead {
    font-size: 1.15rem;
    color: var(--primary);
    margin-bottom: 0.75rem;
  }

  .area-desc {
    font-size: 0.98rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 1.75rem;
    max-width: 950px;
  }

  .area-specs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    background: #0d121d;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    margin-bottom: 1.75rem;
  }

  .spec-block h5 {
    font-size: 0.85rem;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.8rem;
  }

  .tags-row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag-chip {
    background: #172033;
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-muted);
    font-size: 0.8rem;
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-sm);
  }

  .check-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .check-list li {
    position: relative;
    padding-left: 1.25rem;
  }

  .check-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.45rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--primary);
  }

  .area-cta-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .btn-outline-white {
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #fff;
  }

  .btn-outline-white:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }

  .cta-inner-card {
    background: linear-gradient(135deg, #161e2e 0%, #1e1b18 100%);
    border: 1px solid rgba(255, 149, 0, 0.3);
    border-radius: var(--radius-lg);
    padding: 3.5rem;
    text-align: center;
  }

  .cta-inner-card h2 {
    font-size: 2.2rem;
    color: #fff;
    margin-bottom: 0.8rem;
  }

  .cta-inner-card p {
    font-size: 1.1rem;
    color: var(--text-muted);
    max-width: 650px;
    margin: 0 auto 2rem;
  }

  .cta-btns {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 992px) {
    .area-specs-grid {
      grid-template-columns: 1fr;
    }

    .hero-stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .hero-inner h1 {
      font-size: 1.85rem;
    }

    .area-detail-card {
      padding: 1.5rem;
    }
  }
</style>
