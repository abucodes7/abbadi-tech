---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import FAQSection from '../../components/FAQSection.astro';
import HeroAnimation from '../../components/HeroAnimation.astro';
import { areasData } from '../../data/areas';
import { areasFaqs } from '../../data/faq';

const pageTitle = "Areas We Serve in Dubai & UAE | MEP Contractors | Abbadi Tech";
const pageDescription = "Abbadi Tech provides MEP contracting & DEWA approvals across Business Bay, Downtown, DIFC, Marina, JLT & Palm Jumeirah. Fast dispatch: +971 50 554 6943.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.abbaditech.com/" },
    { "@type": "ListItem", "position": 2, "name": "Areas We Serve", "item": "https://www.abbaditech.com/areas-we-serve" }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  currentPath="/areas-we-serve"
  jsonLd={breadcrumbSchema}
>
  <!-- HERO -->
  <section class="areas-hero">
    <HeroAnimation />
    <div class="container hero-inner-container">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><span>Areas we serve</span>
      </nav>

      <div class="hero-inner">
        <span class="eyebrow">Strategic UAE coverage</span>
        <h1>Dubai, Abu Dhabi &amp; Ajman — covered from our Dubai base.</h1>
        <p class="hero-lead">
          Headquartered in Dubai behind Al Khail Mall, Abbadi Tech LLC deploys rapid-response MEP engineering teams across Dubai's prime commercial corridors, financial free zones, luxury waterfronts, and industrial logistics parks.
        </p>

        <div class="hero-stats">
          <div class="stat-card">
            <span class="stat-num">Dubai</span>
            <span class="stat-label">Central UAE HQ</span>
          </div>
          <div class="stat-card">
            <span class="stat-num">15–45m</span>
            <span class="stat-label">Average site dispatch</span>
          </div>
          <div class="stat-card">
            <span class="stat-num">3</span>
            <span class="stat-label">Emirates covered</span>
          </div>
          <div class="stat-card">
            <span class="stat-num">1000+</span>
            <span class="stat-label">Delivered projects</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- AREAS -->
  <section class="section section-paper">
    <div class="container">
      <div class="section-header section-header-left">
        <span class="eyebrow">Local engineering hubs</span>
        <h2>Key districts &amp; coverage zones.</h2>
        <p>Review dedicated technical capabilities, landmark projects, and response guarantees for each area we serve.</p>
      </div>

      <div class="areas-list-grid">
        {areasData.map((area) => (
            <article class="area-detail-card" id={area.slug}>
              <div class="area-card-header">
                <div>
                  <span class="area-response"><span class="pulse-dot"></span> {area.responseTime}</span>
                  <h3>{area.name}</h3>
                </div>
                <span class="projects-count-pill">{area.projectsCount}</span>
              </div>

              <h4 class="area-subhead">{area.headline}</h4>
              <p class="area-desc">{area.description}</p>

              <div class="area-specs-grid">
                <div class="spec-block">
                  <h5>Key landmarks covered</h5>
                  <div class="tags-row">
                    {area.keyLandmarks.map((lm) => (<span class="tag-chip">{lm}</span>))}
                  </div>
                </div>

                <div class="spec-block">
                  <h5>Primary services deployed</h5>
                  <ul class="check-list">
                    {area.servicesOffered.map((srv) => (<li>{srv}</li>))}
                  </ul>
                </div>
              </div>

              <div class="area-cta-row">
                <a href="/contact" class="btn btn-primary btn-sm">Request a site survey <Icon name="ArrowRight" size={14} /></a>
                <a href={`https://wa.me/971505546943?text=Hi%20Abbadi%20Tech,%20I%20need%20an%20engineer%20in%20${encodeURIComponent(area.name)}`} target="_blank" rel="noopener" class="btn btn-outline btn-sm"><Icon name="MessageSquare" size={14} /> WhatsApp local dispatch</a>
              </div>
            </article>
        ))}
      </div>
    </div>
  </section>

  <FAQSection
    title="Frequently asked questions: Dubai & UAE regional contracting"
    subtitle="Direct answers on jurisdiction approvals: Dubai Municipality, DDA, DMCC, Trakhees, Nakheel, and Abu Dhabi."
    badge="Jurisdiction & coverage"
    faqs={areasFaqs}
  />

  <!-- CTA -->
  <section class="section section-ink">
    <div class="container">
      <div class="cta-inner-card">
        <span class="eyebrow light">Mobile estimation teams</span>
        <h2>Operating anywhere in Dubai, Abu Dhabi, or Ajman?</h2>
        <p>Our mobile technical estimator teams are ready to inspect your site, evaluate existing load schedules, and provide an official quotation within 24 hours.</p>
        <div class="cta-btns">
          <a href="/contact" class="btn btn-primary">Book a free site survey <Icon name="ArrowUpRight" size={16} /></a>
          <a href="tel:+971505546943" class="btn btn-outline-white"><Icon name="Phone" size={15} /> Call dispatch: +971 50 554 6943</a>
          <a href="mailto:it.abbaditech@gmail.com" class="btn btn-outline-white"><Icon name="Mail" size={15} /> Email estimation</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .areas-hero {
    position: relative;
    background: var(--ink-deep);
    color: var(--white);
    padding: clamp(2.75rem, 5vw, 4.5rem) 0 clamp(3rem, 5vw, 4.5rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }

  .hero-inner-container { position: relative; z-index: 2; }

  .crumb {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-heading);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 2.25rem;
  }

  .crumb a:hover { color: var(--brass-soft); }

  .hero-inner .eyebrow { color: var(--brass-soft); }

  .hero-inner h1 {
    color: var(--white);
    font-size: clamp(2.6rem, 5.4vw, 4.4rem);
    margin: 0.9rem 0 1.2rem;
    max-width: 19ch;
  }

  .hero-lead {
    font-size: clamp(1rem, 1.4vw, 1.08rem);
    color: rgba(255, 255, 255, 0.62);
    max-width: 66ch;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    border-left: 1px solid rgba(255, 255, 255, 0.12);
    max-width: 760px;
  }

  .stat-card { display: flex; flex-direction: column; gap: 0.3rem; padding: 1.1rem 1.2rem; border-right: 1px solid rgba(255, 255, 255, 0.12); border-bottom: 1px solid rgba(255, 255, 255, 0.12); }
  .stat-num { font-family: var(--font-display); font-size: clamp(1.5rem, 2.4vw, 2.1rem); line-height: 1; color: var(--brass-soft); }
  .stat-label { font-family: var(--font-heading); font-size: 0.58rem; font-weight: 600; letter-spacing: 0.09em; text-transform: uppercase; color: rgba(255, 255, 255, 0.4); }

  .section-paper { background: var(--paper); }
  .areas-list-grid { display: flex; flex-direction: column; gap: 1.25rem; }

  .area-detail-card {
    background: var(--ivory);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(1.4rem, 3vw, 2.2rem);
    transition: border-color 0.3s, box-shadow 0.3s;
  }

  .area-detail-card:hover { border-color: var(--line-strong); box-shadow: var(--shadow-subtle); }

  .area-card-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.9rem; }

  .area-response {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-heading);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brass-deep);
    margin-bottom: 0.4rem;
  }

  .pulse-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--brass); animation: pulseDot 2.4s ease-in-out infinite; }
  @keyframes pulseDot { 0%, 100% { opacity: 0.35; } 50% { opacity: 1; } }

  .area-card-header h3 { font-family: var(--font-display); font-size: clamp(1.6rem, 2.8vw, 2.1rem); font-weight: 400; color: var(--ink); margin: 0; }

  .projects-count-pill { background: var(--white); border: 1px solid var(--line-strong); color: var(--stone); font-family: var(--font-heading); font-size: 0.68rem; font-weight: 600; padding: 0.35rem 0.7rem; border-radius: 8px; }

  .area-subhead { font-family: var(--font-heading); font-size: 0.9rem; font-weight: 600; color: var(--brass-deep); margin-bottom: 0.5rem; }
  .area-desc { font-size: 0.88rem; color: var(--stone); line-height: 1.7; margin-bottom: 1.4rem; max-width: 95ch; }

  .area-specs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 1.2rem;
    margin-bottom: 1.4rem;
  }

  .spec-block h5 { font-family: var(--font-heading); font-size: 0.58rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--stone-light); margin-bottom: 0.65rem; }
  .tags-row { display: flex; gap: 0.35rem; flex-wrap: wrap; }
  .tag-chip { background: var(--white); border: 1px solid var(--line); color: var(--stone); font-size: 0.72rem; padding: 0.24rem 0.5rem; border-radius: 6px; }

  .check-list { list-style: none; display: flex; flex-direction: column; gap: 0.4rem; }
  .check-list li { position: relative; padding-left: 1rem; font-size: 0.78rem; color: var(--stone); line-height: 1.5; }
  .check-list li::before { content: ''; position: absolute; left: 0; top: 0.45rem; width: 5px; height: 5px; border-radius: 50%; background: var(--brass); }

  .area-cta-row { display: flex; gap: 0.6rem; flex-wrap: wrap; }

  .section-ink { background: var(--ink); }

  .cta-inner-card {
    background: var(--ink-2);
    border: 1px solid var(--ink-line);
    border-radius: var(--radius-xl);
    padding: clamp(2rem, 5vw, 4rem);
    text-align: center;
  }

  .cta-inner-card .eyebrow { color: var(--brass-soft); }
  .cta-inner-card h2 { color: var(--white); font-size: clamp(2rem, 3.6vw, 3rem); margin: 1rem auto 0.9rem; max-width: 22ch; }
  .cta-inner-card p { color: rgba(255, 255, 255, 0.55); font-size: 0.95rem; line-height: 1.7; max-width: 64ch; margin: 0 auto 1.75rem; }
  .cta-btns { display: flex; justify-content: center; gap: 0.7rem; flex-wrap: wrap; }

  @media (max-width: 992px) {
    .hero-stats { grid-template-columns: 1fr 1fr; }
    .area-specs-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 600px) {
    .hero-inner h1 { font-size: clamp(2.2rem, 10.5vw, 3rem); }
    .cta-btns .btn { width: 100%; }
  }
</style>
