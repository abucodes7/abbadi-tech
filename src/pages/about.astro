---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const pageTitle = "About Abbadi Tech | MEP Contractors in Dubai Since 2005";
const pageDescription = "20+ years of electrical, plumbing, HVAC and MEP contracting in the UAE. Meet Founder and Chairman Koyakutty Mohammed and the team behind 57+ delivered projects.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.abbaditech.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "About Us",
      "item": "https://www.abbaditech.com/about"
    }
  ]
};
---

<Layout 
  title={pageTitle} 
  description={pageDescription} 
  currentPath="/about"
  jsonLd={breadcrumbSchema}
>
  <!-- ABOUT HERO -->
  <section class="about-hero">
    <div class="container">
      <div class="crumb">
        <a href="/">Home</a> <span>/</span> <span>About Us</span>
      </div>

      <div class="hero-text-wrap">
        <span class="badge badge-gold">Established 2005 • Dubai, UAE</span>
        <h1>OVER 20 YEARS OF MEP ENGINEERING EXCELLENCE IN DUBAI</h1>
        <p class="hero-lead">
          From complex DEWA electrical substations and luxury boutique fit-outs in The Dubai Mall to high-pressure plumbing for 5-star hotels, Abbadi Tech LLC has delivered engineering integrity and strict time-bound execution for over two decades.
        </p>

        <div class="stats-ribbon">
          <div class="stat-item">
            <span class="stat-val text-gradient">2005</span>
            <span class="stat-lbl">Year Established</span>
          </div>
          <div class="stat-item">
            <span class="stat-val" style="color:var(--primary)">DEWA</span>
            <span class="stat-lbl">Registered Contractor</span>
          </div>
          <div class="stat-item">
            <span class="stat-val" style="color:var(--plumbing-light)">57+</span>
            <span class="stat-lbl">Landmark Deliveries</span>
          </div>
          <div class="stat-item">
            <span class="stat-val" style="color:#10b981">100%</span>
            <span class="stat-lbl">On-Time Handover</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CHAIRMAN'S MESSAGE (E-E-A-T REWRITE) -->
  <section class="section chairman-section">
    <div class="container">
      <div class="chairman-card">
        <div class="chairman-portrait-col">
          <div class="portrait-frame">
            <div class="portrait-avatar">KM</div>
            <div class="portrait-caption">
              <h3>Koyakutty Mohammed</h3>
              <p>Founder &amp; Chairman</p>
              <span class="tenure">Guiding Abbadi Tech since 2005</span>
            </div>
          </div>

          <div class="credentials-box">
            <h4>Verified Compliance</h4>
            <ul>
              <li><strong>DEWA Reg No:</strong> <span>[DEWA-M-4892 / Placeholder]</span></li>
              <li><strong>Trade Licence:</strong> <span>[571822 / UAE / Placeholder]</span></li>
              <li><strong>Comprehensive Liability:</strong> <span>[Insured to AED 10M / Placeholder]</span></li>
              <li><strong>QHSE Certification:</strong> <span>[ISO 9001:2015 / Placeholder]</span></li>
            </ul>
          </div>
        </div>

        <div class="chairman-quote-col">
          <span class="badge badge-gold">Leadership Perspective</span>
          <h2>A Message From Our Founder &amp; Chairman</h2>
          <blockquote class="lead-quote">
            "When we established Abbadi Tech in Dubai in 2005, we committed to a single foundational principle: engineering excellence without compromise, delivered strictly on time."
          </blockquote>

          <div class="quote-body">
            <p>
              Over the past two decades, Dubai has evolved into one of the most technologically advanced and architecturally ambitious cities on Earth. We have grown alongside this remarkable nation from an agile MEP specialist into a trusted partner for global luxury retail brands, international dining franchises, financial institutions, and government entities.
            </p>
            <p>
              In our industry, promises mean nothing without execution. Whether we are engineering a 400-ampere MDB panel for an industrial facility, running acoustic HDPE drainage stacks in a signature Palm Jumeirah residence, or coordinating night-shift mall tenancy approvals inside The Dubai Mall, our clients rely on our direct technical accountability.
            </p>
            <p>
              The credit for our 20-year unblemished record belongs entirely to our workforce—our certified electrical engineers, master plumbers, HVAC specialists, and site supervisors. They bring relentless dedication, honesty, and problem-solving critical thinking to every project.
            </p>
            <p>
              As the UAE moves into its next era of sustainable infrastructure, Abbadi Tech stands ready to power, cool, and plumb your most demanding commercial and residential investments.
            </p>
          </div>

          <div class="chairman-signoff">
            <div class="sig-name">Koyakutty Mohammed</div>
            <div class="sig-title">Founder &amp; Chairman, Abbadi Tech Electrical &amp; Mechanical Cont. Co. L.L.C</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- COMPANY STORY & CORE VALUES -->
  <section class="section values-section">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-gold">Why Abbadi Tech Endures</span>
        <h2>Our Engineering Pillars: Built on Integrity Since 2005</h2>
        <p class="section-sub">
          We operate with strict ethics and transparent project governance across every tier of MEP contracting.
        </p>
      </div>

      <div class="values-grid">
        <div class="value-card">
          <div class="value-icon"><Icon name="Zap" size={24} color="#FF9500" /></div>
          <h3>DEWA Regulatory Mastery</h3>
          <p>
            Registered directly with the Dubai Electricity and Water Authority. We eliminate bureaucratic delays by engineering every drawing, load schedule, and cable run to pass municipal audits on the first inspection.
          </p>
        </div>

        <div class="value-card">
          <div class="value-icon"><Icon name="Clock" size={24} color="#FF9500" /></div>
          <h3>Strict Time-Bound Completion</h3>
          <p>
            Commercial fit-out delays cost tenants thousands in lost revenue and mall penalties. We operate structured double shifts, rigorous procurement timelines, and proactive site supervision to hit promised handover dates.
          </p>
        </div>

        <div class="value-card">
          <div class="value-icon"><Icon name="ShieldCheck" size={24} color="#FF9500" /></div>
          <h3>Uncompromising Quality &amp; Safety</h3>
          <p>
            From certified fusion-welded PPR and Type L copper to fire-rated cabling and certified switchgear, we never substitute inferior materials. Every install undergoes 10-bar hydrostatic testing and insulation resistance verification.
          </p>
        </div>

        <div class="value-card">
          <div class="value-icon"><Icon name="Handshake" size={24} color="#FF9500" /></div>
          <h3>Direct Engineering Accountability</h3>
          <p>
            No hidden sub-contractor markups or evasive middle management. When you partner with Abbadi Tech, you liaise directly with experienced project engineers who take personal ownership of your site.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTORS WE SERVE -->
  <section class="section sectors-section">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-blue">Broad Industrial Capability</span>
        <h2>Sectors We Serve Across Dubai &amp; the UAE</h2>
      </div>

      <div class="sectors-grid">
        <div class="sector-badge-card">
          <span class="sec-icon"><Icon name="ShoppingBag" size={24} color="#FF9500" /></span>
          <h4>Shops &amp; Boutiques</h4>
          <p>Dubai Mall, Marina Mall, Mirdif</p>
        </div>
        <div class="sector-badge-card">
          <span class="sec-icon"><Icon name="UtensilsCrossed" size={24} color="#FF9500" /></span>
          <h4>Restaurants &amp; Cafes</h4>
          <p>Commercial kitchens, gas &amp; grease traps</p>
        </div>
        <div class="sector-badge-card">
          <span class="sec-icon"><Icon name="Building2" size={24} color="#FF9500" /></span>
          <h4>Offices &amp; Banks</h4>
          <p>DIFC, Business Bay, Sheikh Zayed Rd</p>
        </div>
        <div class="sector-badge-card">
          <span class="sec-icon"><Icon name="Hotel" size={24} color="#FF9500" /></span>
          <h4>Hotels &amp; Hospitality</h4>
          <p>5-Star resorts, spas, central boilers</p>
        </div>
        <div class="sector-badge-card">
          <span class="sec-icon"><Icon name="Home" size={24} color="#FF9500" /></span>
          <h4>Villas &amp; Mansions</h4>
          <p>Palm Jumeirah, Emirates Hills, Al Barsha</p>
        </div>
        <div class="sector-badge-card">
          <span class="sec-icon"><Icon name="Factory" size={24} color="#FF9500" /></span>
          <h4>Warehouses &amp; Industrial</h4>
          <p>Al Quoz, DIP, Al Ramool complex</p>
        </div>
      </div>
    </div>
  </section>

  <!-- BOTTOM CTA -->
  <section class="section section-cta">
    <div class="container">
      <div class="cta-inner-card">
        <h2>Partner with Dubai's Trusted MEP Contractors</h2>
        <p>Book a free technical site survey or consult with our senior estimation team regarding your upcoming electrical, plumbing, or fit-out project.</p>
        <div class="cta-btns">
          <a href="/contact" class="btn btn-primary">Schedule Free Site Survey</a>
          <a href="https://wa.me/971551313403?text=Hi%20Abbadi%20Tech,%20I%20would%20like%20to%20discuss%20a%20new%20project" target="_blank" rel="noopener" class="btn btn-secondary">
            <Icon name="MessageSquare" size={16} /> Chat on WhatsApp
          </a>
          <a href="tel:+97143805683" class="btn btn-outline-white">
            <Icon name="Phone" size={16} /> Call Office: +971 4 380 5683
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-hero {
    padding: 3.5rem 0 3rem;
    background: radial-gradient(circle at top right, rgba(255, 149, 0, 0.12) 0%, transparent 60%);
    border-bottom: 1px solid var(--border-subtle);
  }

  .crumb {
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-bottom: 1.25rem;
  }

  .crumb a {
    color: var(--text-muted);
  }

  .crumb a:hover {
    color: var(--primary);
  }

  .crumb span {
    margin: 0 0.35rem;
  }

  .hero-text-wrap h1 {
    font-size: 2.5rem;
    color: #fff;
    margin-top: 0.8rem;
    margin-bottom: 1rem;
    max-width: 900px;
  }

  .hero-lead {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 820px;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .stats-ribbon {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    background: #111724;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    max-width: 900px;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .stat-val {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 0.35rem;
  }

  .stat-lbl {
    font-size: 0.78rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .chairman-section {
    background: #0b0f18;
  }

  .chairman-card {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 3.5rem;
    align-items: start;
    background: #111827;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 3rem;
  }

  .portrait-frame {
    background: #182030;
    border: 1px solid rgba(255, 149, 0, 0.3);
    border-radius: var(--radius-md);
    padding: 2rem 1.5rem;
    text-align: center;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
  }

  .portrait-avatar {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    background: linear-gradient(135deg, #FF9500 0%, #3C3C3C 100%);
    color: #fff;
    font-family: var(--font-heading);
    font-size: 2.2rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.2rem;
    box-shadow: 0 4px 20px rgba(255, 149, 0, 0.3);
  }

  .portrait-caption h3 {
    font-size: 1.35rem;
    color: #fff;
    margin-bottom: 0.2rem;
  }

  .portrait-caption p {
    color: var(--primary);
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 0.3rem;
  }

  .portrait-caption .tenure {
    font-size: 0.78rem;
    color: var(--text-dim);
  }

  .credentials-box {
    margin-top: 1.5rem;
    background: #0d121d;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-sm);
    padding: 1.25rem;
  }

  .credentials-box h4 {
    font-size: 0.88rem;
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .credentials-box ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.82rem;
  }

  .credentials-box li {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .credentials-box strong {
    color: var(--text-muted);
  }

  .credentials-box span {
    color: #fff;
    font-family: monospace;
    font-size: 0.8rem;
  }

  .lead-quote {
    font-size: 1.35rem;
    font-style: italic;
    color: #fff;
    border-left: 3px solid var(--primary);
    padding-left: 1.25rem;
    margin: 1.25rem 0 1.75rem;
    line-height: 1.5;
  }

  .quote-body p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-muted);
    margin-bottom: 1.2rem;
  }

  .chairman-signoff {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .sig-name {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 700;
    color: #fff;
  }

  .sig-title {
    font-size: 0.85rem;
    color: var(--primary);
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .value-card {
    background: #111724;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 2rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .value-card:hover {
    transform: translateY(-4px);
    border-color: var(--primary);
  }

  .value-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-sm);
    background: rgba(255, 149, 0, 0.08);
    border: 1px solid rgba(255, 149, 0, 0.2);
    margin-bottom: 1rem;
  }

  .value-card h3 {
    font-size: 1.25rem;
    color: #fff;
    margin-bottom: 0.6rem;
  }

  .value-card p {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .sectors-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.25rem;
  }

  .sector-badge-card {
    background: #111724;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.5rem 1rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .sec-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: rgba(255, 149, 0, 0.08);
    border: 1px solid rgba(255, 149, 0, 0.2);
    margin-bottom: 0.75rem;
  }

  .sector-badge-card h4 {
    font-size: 0.95rem;
    color: #fff;
    margin-bottom: 0.35rem;
  }

  .sector-badge-card p {
    font-size: 0.74rem;
    color: var(--text-dim);
    line-height: 1.3;
  }

  .cta-inner-card {
    background: linear-gradient(135deg, #161e2e 0%, #1e1b18 100%);
    border: 1px solid rgba(255, 149, 0, 0.3);
    border-radius: var(--radius-lg);
    padding: 3.5rem;
    text-align: center;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.4);
  }

  .cta-inner-card h2 {
    font-size: 2.2rem;
    color: #fff;
    margin-bottom: 0.8rem;
  }

  .cta-inner-card p {
    font-size: 1.1rem;
    color: var(--text-muted);
    max-width: 650px;
    margin: 0 auto 2rem;
  }

  .cta-btns {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-outline-white {
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #fff;
  }

  .btn-outline-white:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 992px) {
    .chairman-card {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding: 2rem;
    }

    .stats-ribbon {
      grid-template-columns: repeat(2, 1fr);
    }

    .values-grid {
      grid-template-columns: 1fr;
    }

    .sectors-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 600px) {
    .hero-text-wrap h1 {
      font-size: 1.85rem;
    }

    .stats-ribbon {
      grid-template-columns: 1fr 1fr;
    }

    .sectors-grid {
      grid-template-columns: 1fr 1fr;
    }

    .cta-inner-card {
      padding: 2rem 1.5rem;
    }
  }
</style>
