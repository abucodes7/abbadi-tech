---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import FAQSection from '../components/FAQSection.astro';
import HeroAnimation from '../components/HeroAnimation.astro';
import { aboutFaqs } from '../data/faq';

const pageTitle = "About Abbadi Tech | MEP Contractors in Dubai Since 2005";
const pageDescription = "Over two decades of MEP contracting in Dubai. Meet Founder Koyakutty Mohammed and the certified technical team behind our UAE track record.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.abbaditech.com/" },
    { "@type": "ListItem", "position": 2, "name": "About Us", "item": "https://www.abbaditech.com/about" }
  ]
};

const values = [
  { icon: "Zap", title: "DEWA regulatory mastery", body: "Specialized engineering compliance for Dubai Electricity and Water Authority standards. We eliminate bureaucratic delays by engineering every drawing, load schedule, and cable run to pass municipal audits on the first inspection." },
  { icon: "Clock", title: "Strict time-bound completion", body: "Commercial fit-out delays cost tenants thousands in lost revenue and mall penalties. We operate structured double shifts, rigorous procurement timelines, and proactive site supervision to hit promised handover dates." },
  { icon: "ShieldCheck", title: "Uncompromising quality & safety", body: "From certified fusion-welded PPR and Type L copper to fire-rated cabling and certified switchgear, we never substitute inferior materials. Every install undergoes 10-bar hydrostatic testing and insulation resistance verification." },
  { icon: "Handshake", title: "Direct engineering accountability", body: "No hidden sub-contractor markups or evasive middle management. When you partner with Abbadi Tech, you liaise directly with experienced project engineers who take personal ownership of your site." }
];

const sectors = [
  { icon: "ShoppingBag", title: "Shops & boutiques", body: "Dubai Mall, Marina Mall, Mirdif" },
  { icon: "UtensilsCrossed", title: "Restaurants & cafés", body: "Commercial kitchens, gas & grease traps" },
  { icon: "Building2", title: "Offices & banks", body: "DIFC, Business Bay, Sheikh Zayed Road" },
  { icon: "Hotel", title: "Hotels & hospitality", body: "5-star resorts, spas, central boilers" },
  { icon: "Home", title: "Villas & mansions", body: "Palm Jumeirah, Emirates Hills, Al Barsha" },
  { icon: "Factory", title: "Warehouses & industrial", body: "Al Quoz, DIP, Al Ramool complex" }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  currentPath="/about"
  jsonLd={breadcrumbSchema}
>
  <!-- HERO -->
  <section class="about-hero">
    <HeroAnimation />
    <div class="container hero-inner">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><span>About</span>
      </nav>

      <div class="hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">Established 2005 · Dubai, UAE</span>
          <h1>Over two decades of MEP engineering, built on accountability.</h1>
          <p class="hero-lead">
            From complex DEWA electrical substations and luxury boutique fit-outs in The Dubai Mall to high-pressure plumbing for 5-star hotels, Abbadi Tech LLC has delivered engineering integrity and strict time-bound execution for over 21 years across the UAE.
          </p>
          <div class="hero-actions">
            <a href="/contact" class="btn btn-primary">Schedule a site survey <Icon name="ArrowUpRight" size={16} /></a>
            <a href="#chairman" class="btn btn-outline-white">Read the founder's message</a>
          </div>
        </div>

        <div class="hero-stats">
          <div class="hero-stat">
            <span class="hero-stat-value">2005</span>
            <span class="hero-stat-label">Year established</span>
          </div>
          <div class="hero-stat">
            <span class="hero-stat-value">21+</span>
            <span class="hero-stat-label">Years in the UAE</span>
          </div>
          <div class="hero-stat">
            <span class="hero-stat-value">20+</span>
            <span class="hero-stat-label">Years continuous practice</span>
          </div>
          <div class="hero-stat">
            <span class="hero-stat-value">100%</span>
            <span class="hero-stat-label">In-house execution</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CHAIRMAN -->
  <section class="section section-ivory chairman-section" id="chairman">
    <div class="container">
      <div class="chairman-grid">
        <aside class="chairman-aside reveal">
          <div class="portrait-card">
            <div class="portrait-mark">KM</div>
            <h3>Koyakutty Mohammed</h3>
            <p>Founder &amp; Chairman</p>
            <span>Guiding Abbadi Tech since 2005</span>
          </div>

          <div class="credentials-card">
            <img src="/images/logo/logo-dark.png" alt="Abbadi Tech LLC corporate logo" width="140" />
            <h4>Verified standards</h4>
            <ul>
              <li><span>Track record</span><strong>Documented UAE execution</strong></li>
              <li><span>Experience</span><strong>21+ years continuous practice</strong></li>
              <li><span>Liability</span><strong>Fully insured commercial operations</strong></li>
              <li><span>QHSE</span><strong>Structured QA &amp; safety protocols</strong></li>
            </ul>
          </div>
        </aside>

        <div class="chairman-body reveal stagger-1">
          <span class="eyebrow">Leadership perspective</span>
          <h2>A message from our founder &amp; chairman.</h2>
          <blockquote class="lead-quote">
            “When we established Abbadi Tech in Dubai in 2005, we committed to a single foundational principle: engineering excellence without compromise, delivered strictly on time.”
          </blockquote>

          <div class="quote-body">
            <p>Over the past two decades, Dubai has evolved into one of the most technologically advanced and architecturally ambitious cities on Earth. We have grown alongside this remarkable nation from an agile MEP specialist into a trusted partner for global luxury retail brands, international dining franchises, financial institutions, and government entities.</p>
            <p>In our industry, promises mean nothing without execution. Whether we are engineering a 400-ampere MDB panel for an industrial facility, running acoustic HDPE drainage stacks in a signature Palm Jumeirah residence, or coordinating night-shift mall tenancy approvals inside The Dubai Mall, our clients rely on our direct technical accountability.</p>
            <p>The credit for our 20-year reputation belongs entirely to our workforce — our certified electrical engineers, master plumbers, and site supervisors. They bring relentless dedication, honesty, and problem-solving critical thinking to every project.</p>
            <p>As the UAE moves into its next era of sustainable infrastructure, Abbadi Tech stands ready to power and plumb your most demanding commercial and residential investments.</p>
          </div>

          <div class="signoff">
            <span class="signature">Koyakutty Mohammed</span>
            <span class="signature-role">Founder &amp; Chairman, Abbadi Tech Technical Solutions LLC</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- VALUES -->
  <section class="section section-paper values-section">
    <div class="container">
      <div class="section-header section-header-left">
        <span class="eyebrow">Why Abbadi Tech endures</span>
        <h2>Engineering pillars, built on integrity.</h2>
        <p>We operate with strict ethics and transparent project governance across every tier of MEP contracting.</p>
      </div>

      <div class="values-list reveal-group">
        {values.map((value, i) => (
          <article class="value-row">
            <span class="value-index">{String(i + 1).padStart(2, '0')}</span>
            <div class="value-icon"><Icon name={value.icon} size={22} /></div>
            <div class="value-copy">
              <h3>{value.title}</h3>
              <p>{value.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTORS -->
  <section class="section section-ivory sectors-section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Broad industrial capability</span>
        <h2>Sectors we serve across Dubai &amp; the UAE.</h2>
      </div>

      <div class="sectors-grid reveal-group">
        {sectors.map(sector => (
          <div class="sector-card">
            <span class="sector-icon"><Icon name={sector.icon} size={21} /></span>
            <h3>{sector.title}</h3>
            <p>{sector.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FAQSection
    title="Frequently asked questions about Abbadi Tech"
    subtitle="Direct answers on our 21+ years of UAE licensing, compliance, in-house engineers, and warranties."
    badge="Corporate & Standards"
    faqs={aboutFaqs}
  />

  <!-- CTA -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-card reveal">
        <span class="eyebrow light">Partner with our team</span>
        <h2>Bring us your most demanding MEP scope.</h2>
        <p>Book a free technical site survey or consult our senior estimation team about your upcoming electrical, plumbing, or fit-out project.</p>
        <div class="cta-actions">
          <a href="/contact" class="btn btn-primary">Schedule a free site survey <Icon name="ArrowUpRight" size={16} /></a>
          <a href="https://wa.me/971505546943?text=Hi%20Abbadi%20Tech,%20I%20would%20like%20to%20discuss%20a%20new%20project" target="_blank" rel="noopener" class="btn btn-outline-white"><Icon name="MessageSquare" size={16} /> Chat on WhatsApp</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-hero {
    position: relative;
    background: var(--ink-deep);
    color: var(--white);
    padding: clamp(2.75rem, 5vw, 4.5rem) 0 clamp(3rem, 5vw, 4.5rem);
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .hero-inner { position: relative; z-index: 2; }

  .crumb {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-heading);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 2.25rem;
  }

  .crumb a:hover { color: var(--brass-soft); }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: end;
  }

  .hero-copy .eyebrow { color: var(--brass-soft); }

  .hero-copy h1 {
    color: var(--white);
    font-size: clamp(2.7rem, 5.6vw, 4.6rem);
    margin: 1rem 0 1.35rem;
    max-width: 18ch;
  }

  .hero-lead {
    font-size: clamp(1rem, 1.4vw, 1.12rem);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.62);
    max-width: 62ch;
    margin-bottom: 2rem;
  }

  .hero-actions { display: flex; gap: 0.8rem; flex-wrap: wrap; }

  .hero-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    border-left: 1px solid rgba(255, 255, 255, 0.12);
  }

  .hero-stat {
    padding: 1.4rem 1.25rem;
    border-right: 1px solid rgba(255, 255, 255, 0.12);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .hero-stat-value {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 2.6vw, 2.4rem);
    line-height: 1;
    color: var(--brass-soft);
  }

  .hero-stat-label {
    font-family: var(--font-heading);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
  }

  .section-ivory { background: var(--ivory); }
  .section-paper { background: var(--paper); }

  .chairman-grid {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: start;
  }

  .chairman-aside { position: sticky; top: 130px; }

  .portrait-card {
    background: var(--ink);
    border-radius: var(--radius-lg);
    padding: 2rem 1.5rem;
    text-align: center;
    color: var(--white);
    border: 1px solid var(--ink-line);
  }

  .portrait-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 96px;
    height: 96px;
    margin: 0 auto 1.25rem;
    border-radius: 50%;
    border: 1px solid rgba(180, 134, 76, 0.45);
    background: rgba(180, 134, 76, 0.1);
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--brass-soft);
  }

  .portrait-card h3 { font-family: var(--font-heading); font-size: 1.1rem; color: var(--white); margin-bottom: 0.2rem; }
  .portrait-card p { font-size: 0.78rem; color: var(--brass-soft); font-weight: 600; }
  .portrait-card > span { font-size: 0.7rem; color: rgba(255, 255, 255, 0.4); }

  .credentials-card {
    margin-top: 1rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 1.4rem;
  }

  .credentials-card img { margin: 0 auto 1rem; max-height: 58px; object-fit: contain; }
  .credentials-card h4 { font-family: var(--font-heading); font-size: 0.64rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--brass-deep); text-align: center; margin-bottom: 0.9rem; }
  .credentials-card ul { list-style: none; display: flex; flex-direction: column; gap: 0.65rem; }
  .credentials-card li { display: flex; flex-direction: column; gap: 0.1rem; padding-bottom: 0.6rem; border-bottom: 1px solid var(--line); }
  .credentials-card li:last-child { border-bottom: 0; padding-bottom: 0; }
  .credentials-card li span { font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--stone-light); }
  .credentials-card li strong { font-size: 0.78rem; font-weight: 500; color: var(--ink); }

  .chairman-body h2 { font-size: clamp(2.1rem, 3.7vw, 3.2rem); margin: 1rem 0 1.5rem; }
  .chairman-body .eyebrow { margin-bottom: 0.25rem; }

  .lead-quote {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.3vw, 1.9rem);
    line-height: 1.35;
    color: var(--ink);
    border-left: 2px solid var(--brass);
    padding-left: 1.5rem;
    margin-bottom: 1.75rem;
  }

  .quote-body p { font-size: 0.95rem; line-height: 1.8; color: var(--stone); margin-bottom: 1.1rem; }

  .signoff { margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 0.15rem; }
  .signature { font-family: var(--font-display); font-size: 1.4rem; color: var(--ink); }
  .signature-role { font-size: 0.72rem; color: var(--stone-light); }

  .values-list { display: flex; flex-direction: column; border-top: 1px solid var(--line); }

  .value-row {
    display: grid;
    grid-template-columns: 3rem 3.2rem 1fr;
    gap: 1.25rem;
    align-items: start;
    padding: 1.85rem 0;
    border-bottom: 1px solid var(--line);
  }

  .value-index { font-family: var(--font-display); font-size: 1rem; color: var(--brass); padding-top: 0.5rem; }

  .value-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    border: 1px solid var(--line-strong);
    color: var(--brass-deep);
    background: var(--ivory);
  }

  .value-copy h3 { font-family: var(--font-heading); font-size: 1.05rem; font-weight: 600; color: var(--ink); margin-bottom: 0.4rem; }
  .value-copy p { font-size: 0.88rem; line-height: 1.7; color: var(--stone); max-width: 74ch; }

  .sectors-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }

  .sector-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 1.4rem;
    transition: transform 0.28s var(--ease-out), border-color 0.28s, box-shadow 0.28s;
  }

  .sector-card:hover { transform: translateY(-4px); border-color: var(--line-strong); box-shadow: var(--shadow-md); }

  .sector-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--ivory);
    color: var(--brass-deep);
    margin-bottom: 0.9rem;
  }

  .sector-card h3 { font-family: var(--font-heading); font-size: 0.94rem; font-weight: 600; color: var(--ink); margin-bottom: 0.25rem; }
  .sector-card p { font-size: 0.78rem; color: var(--stone); line-height: 1.45; }

  .cta-section { background: var(--ink); }

  .cta-card {
    background: var(--ink-2);
    border: 1px solid var(--ink-line);
    border-radius: var(--radius-xl);
    padding: clamp(2rem, 5vw, 4rem);
    text-align: center;
    color: var(--white);
    position: relative;
    overflow: hidden;
  }

  .cta-card .eyebrow { color: var(--brass-soft); }
  .cta-card h2 { color: var(--white); font-size: clamp(2rem, 3.6vw, 3rem); margin: 1rem auto 0.9rem; max-width: 20ch; }
  .cta-card p { color: rgba(255, 255, 255, 0.55); font-size: 0.95rem; line-height: 1.7; max-width: 62ch; margin: 0 auto 1.75rem; }
  .cta-actions { display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap; }

  @media (max-width: 1024px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-stats { max-width: 520px; }
    .chairman-grid { grid-template-columns: 1fr; }
    .chairman-aside { position: static; display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .credentials-card { margin-top: 0; }
  }

  @media (max-width: 820px) {
    .sectors-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 600px) {
    .chairman-aside { grid-template-columns: 1fr; }
    .hero-copy h1 { font-size: clamp(2.3rem, 11vw, 3rem); }
    .sectors-grid { grid-template-columns: 1fr; }
    .value-row { grid-template-columns: 2.2rem 1fr; }
    .value-index { display: none; }
    .value-icon { width: 38px; height: 38px; }
  }
</style>
