---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import FAQSection from '../../components/FAQSection.astro';
import HeroAnimation from '../../components/HeroAnimation.astro';
import { resourcesData } from '../../data/resources';
import { resourcesFaqs } from '../../data/faq';

const pageTitle = "Technical Resources & Guides | DEWA & MEP Dubai | Abbadi Tech";
const pageDescription = "Authoritative technical guides for Dubai MEP projects: step-by-step DEWA electrical approval processes, commercial fit-out cost benchmarks, and UAE plumbing standards.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.abbaditech.com/" },
    { "@type": "ListItem", "position": 2, "name": "Resources & Guides", "item": "https://www.abbaditech.com/resources" }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  currentPath="/resources"
  jsonLd={breadcrumbSchema}
>
  <!-- HERO -->
  <section class="resources-hero">
    <HeroAnimation />
    <div class="container hero-inner-container">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><span>Resources</span>
      </nav>

      <div class="hero-inner">
        <span class="eyebrow">Engineering knowledge base</span>
        <h1>Technical guides &amp; regulatory insight for Dubai MEP.</h1>
        <p class="hero-lead">
          Practical, engineering-grade advice compiled by Abbadi Tech's licensed project managers to help retail operators, F&amp;B managers, architects, and property owners navigate Dubai regulations, load schedules, and technical costs.
        </p>
      </div>
    </div>
  </section>

  <!-- ARTICLES -->
  <section class="section section-paper">
    <div class="container">
      <div class="articles-layout">
        {resourcesData.map((res) => (
          <article class="resource-article-card" id={res.slug}>
            <div class="article-meta-row">
              <span class="res-cat">{res.category}</span>
              <div class="meta-right">
                <span class="read-time"><Icon name="Clock" size={13} /> {res.readTime}</span>
                <span class="divider">·</span>
                <span class="pub-date"><Icon name="Calendar" size={13} /> {res.publishDate}</span>
              </div>
            </div>

            <h2>{res.title}</h2>
            <p class="article-summary">{res.summary}</p>

            <div class="article-body-content" set:html={res.contentHtml} />
          </article>
        ))}
      </div>
    </div>
  </section>

  <FAQSection
    title="Frequently asked questions: costs, permits & approvals"
    subtitle="Direct answers regarding DEWA approval steps, fit-out cost benchmarks per sq. ft, and document checklists."
    badge="Costs & approvals"
    faqs={resourcesFaqs}
  />

  <!-- CTA -->
  <section class="section section-ink">
    <div class="container">
      <div class="cta-inner-card">
        <span class="eyebrow light">Direct consultation</span>
        <h2>Have a specific technical question for your space?</h2>
        <p>Our senior estimating and DEWA liaison engineers are available for direct consultations.</p>
        <div class="cta-btns">
          <a href="/contact" class="btn btn-primary">Schedule a free engineering consultation <Icon name="ArrowUpRight" size={16} /></a>
          <a href="https://wa.me/971505546943?text=Hi%20Abbadi%20Tech,%20I%20have%20a%20technical%20question" target="_blank" rel="noopener" class="btn btn-outline-white"><Icon name="MessageSquare" size={16} /> Ask on WhatsApp</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .resources-hero {
    position: relative;
    background: var(--ink-deep);
    color: var(--white);
    padding: clamp(2.75rem, 5vw, 4.5rem) 0 clamp(3rem, 5vw, 4.5rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }

  .hero-inner-container { position: relative; z-index: 2; }

  .crumb {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-heading);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 2.25rem;
  }

  .crumb a:hover { color: var(--brass-soft); }

  .hero-inner .eyebrow { color: var(--brass-soft); }

  .hero-inner h1 {
    color: var(--white);
    font-size: clamp(2.6rem, 5.4vw, 4.4rem);
    margin: 0.9rem 0 1.15rem;
    max-width: 19ch;
  }

  .hero-lead {
    font-size: clamp(1rem, 1.4vw, 1.08rem);
    color: rgba(255, 255, 255, 0.62);
    max-width: 68ch;
    line-height: 1.7;
  }

  .section-paper { background: var(--paper); }
  .articles-layout { display: flex; flex-direction: column; gap: 1.5rem; max-width: 980px; margin: 0 auto; }

  .resource-article-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3.5vw, 3rem);
  }

  .article-meta-row { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1.1rem; }

  .res-cat {
    font-family: var(--font-heading);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brass-deep);
    background: var(--brass-wash);
    border: 1px solid rgba(180, 134, 76, 0.24);
    border-radius: 6px;
    padding: 0.28rem 0.55rem;
  }

  .meta-right { display: flex; align-items: center; gap: 0.45rem; font-size: 0.68rem; color: var(--stone-light); }
  .read-time, .pub-date { display: inline-flex; align-items: center; gap: 0.3rem; }

  .resource-article-card h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.7rem, 3vw, 2.35rem);
    line-height: 1.12;
    color: var(--ink);
    margin-bottom: 0.8rem;
    max-width: 26ch;
  }

  .article-summary {
    font-size: 0.95rem;
    color: var(--brass-deep);
    line-height: 1.65;
    margin-bottom: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .article-body-content :global(h3) {
    font-family: var(--font-heading);
    font-size: 1.12rem;
    font-weight: 600;
    color: var(--ink);
    margin-top: 1.9rem;
    margin-bottom: 0.65rem;
  }

  .article-body-content :global(p), .article-body-content :global(li) {
    font-size: 0.9rem;
    color: var(--stone);
    line-height: 1.75;
  }

  .article-body-content :global(p) { margin-bottom: 1.05rem; }
  .article-body-content :global(ul), .article-body-content :global(ol) { margin: 0.75rem 0 1.25rem 1.25rem; }
  .article-body-content :global(li) { margin-bottom: 0.4rem; }
  .article-body-content :global(strong) { color: var(--ink); font-weight: 600; }
  .article-body-content :global(a) { color: var(--brass-deep); text-decoration: underline; text-underline-offset: 3px; }

  .article-body-content :global(.data-table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.25rem 0 1.75rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    font-size: 0.84rem;
  }

  .article-body-content :global(.data-table th),
  .article-body-content :global(.data-table td) { padding: 0.7rem 0.9rem; text-align: left; border-bottom: 1px solid var(--line); }

  .article-body-content :global(.data-table th) {
    background: var(--ink);
    color: var(--white);
    font-family: var(--font-heading);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .article-body-content :global(.data-table td) { color: var(--stone); }
  .article-body-content :global(.data-table tr:nth-child(even) td) { background: var(--ivory); }

  .article-body-content :global(.resource-cta-box) {
    margin-top: 2rem;
    background: var(--ivory);
    border: 1px solid var(--line);
    border-left: 2px solid var(--brass);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .article-body-content :global(.resource-cta-box h4) { margin: 0; font-family: var(--font-heading); font-size: 1rem; font-weight: 600; color: var(--ink); }
  .article-body-content :global(.resource-cta-box p) { margin: 0; font-size: 0.84rem; color: var(--stone); }

  .section-ink { background: var(--ink); }

  .cta-inner-card {
    background: var(--ink-2);
    border: 1px solid var(--ink-line);
    border-radius: var(--radius-xl);
    padding: clamp(2rem, 5vw, 4rem);
    text-align: center;
  }

  .cta-inner-card .eyebrow { color: var(--brass-soft); }
  .cta-inner-card h2 { color: var(--white); font-size: clamp(2rem, 3.6vw, 3rem); margin: 1rem auto 0.9rem; max-width: 22ch; }
  .cta-inner-card p { color: rgba(255, 255, 255, 0.55); font-size: 0.95rem; line-height: 1.7; max-width: 60ch; margin: 0 auto 1.75rem; }
  .cta-btns { display: flex; justify-content: center; gap: 0.7rem; flex-wrap: wrap; }

  @media (max-width: 768px) {
    .hero-inner h1 { font-size: clamp(2.2rem, 10.5vw, 3rem); }
    .cta-btns .btn { width: 100%; }
  }
</style>
