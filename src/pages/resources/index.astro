---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import FAQSection from '../../components/FAQSection.astro';
import { resourcesData } from '../../data/resources';
import { resourcesFaqs } from '../../data/faq';

const pageTitle = "Technical Resources & Guides | DEWA & MEP Dubai | Abbadi Tech";
const pageDescription = "Authoritative technical guides for Dubai MEP projects: step-by-step DEWA electrical approval processes, commercial fit-out cost benchmarks, and UAE plumbing standards.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.abbaditech.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Resources & Guides",
      "item": "https://www.abbaditech.com/resources"
    }
  ]
};
---

<Layout 
  title={pageTitle} 
  description={pageDescription} 
  currentPath="/resources"
  jsonLd={breadcrumbSchema}
>
  <!-- RESOURCES HERO -->
  <section class="resources-hero">
    <div class="container">
      <div class="crumb">
        <a href="/">Home</a> <span>/</span> <span>Resources &amp; Guides</span>
      </div>

      <div class="hero-inner">
        <span class="badge badge-gold">Engineering Knowledge Base</span>
        <h1>TECHNICAL GUIDES &amp; REGULATORY INSIGHTS FOR DUBAI MEP</h1>
        <p class="hero-lead">
          Practical, engineering-grade advice compiled by Abbadi Tech's licensed project managers to help retail operators, F&amp;B managers, architects, and property owners navigate Dubai regulations, load schedules, and technical costs.
        </p>
      </div>
    </div>
  </section>

  <!-- RESOURCES ARTICLES LIST -->
  <section class="section">
    <div class="container">
      <div class="articles-layout">
        {resourcesData.map((res) => (
          <article class="resource-article-card" id={res.slug}>
            <div class="article-meta-row">
              <span class="badge badge-blue">{res.category}</span>
              <div class="meta-right">
                <span class="read-time"><Icon name="Clock" size={13} /> {res.readTime}</span>
                <span class="divider">•</span>
                <span class="pub-date"><Icon name="Calendar" size={13} /> {res.publishDate}</span>
              </div>
            </div>

            <h2>{res.title}</h2>
            <p class="article-summary">{res.summary}</p>

            <div class="article-body-content" set:html={res.contentHtml} />
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ SECTION -->
  <FAQSection 
    title="Frequently Asked Questions: Costs, Permits & Approvals" 
    subtitle="Direct answers regarding DEWA approval steps, fit-out cost benchmarks per sq. ft, and document checklists."
    badge="Costs & Approvals FAQ"
    faqs={resourcesFaqs}
  />

  <!-- CTA -->
  <section class="section section-cta">
    <div class="container">
      <div class="cta-inner-card">
        <h2>Have a Specific Technical Question for Your Space?</h2>
        <p>Our senior estimating and DEWA liaison engineers are available for direct consultations.</p>
        <div class="cta-btns">
          <a href="/contact" class="btn btn-primary">
            Schedule Free Engineering Consultation <Icon name="ArrowRight" size={16} />
          </a>
          <a href="https://wa.me/971505546943?text=Hi%20Abbadi%20Tech,%20I%20have%20a%20technical%20question" target="_blank" rel="noopener" class="btn btn-secondary">
            <Icon name="MessageSquare" size={16} /> Ask on WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .resources-hero {
    padding: 3.5rem 0 3rem;
    background: radial-gradient(circle at top right, rgba(255, 149, 0, 0.12) 0%, transparent 60%);
    border-bottom: 1px solid var(--border-subtle);
  }

  .crumb {
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-bottom: 1.25rem;
  }

  .crumb a {
    color: var(--text-muted);
  }

  .crumb a:hover {
    color: var(--primary);
  }

  .crumb span {
    margin: 0 0.35rem;
  }

  .hero-inner h1 {
    font-size: 2.3rem;
    color: #fff;
    margin-top: 0.8rem;
    margin-bottom: 1rem;
    max-width: 900px;
  }

  .hero-lead {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 820px;
    line-height: 1.7;
  }

  .articles-layout {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .resource-article-card {
    background: #111724;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 3rem;
  }

  .article-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .meta-right {
    font-size: 0.82rem;
    color: var(--text-dim);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .read-time, .pub-date {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .resource-article-card h2 {
    font-size: 1.85rem;
    color: #fff;
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .article-summary {
    font-size: 1.1rem;
    color: var(--primary);
    line-height: 1.6;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* HTML body inside articles */
  .article-body-content :global(h3) {
    font-size: 1.35rem;
    color: #fff;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .article-body-content :global(p) {
    font-size: 0.98rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 1.2rem;
  }

  .article-body-content :global(ul), .article-body-content :global(ol) {
    margin: 1rem 0 1.5rem 1.5rem;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .article-body-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .article-body-content :global(strong) {
    color: #fff;
  }

  .article-body-content :global(.data-table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0 2rem;
    background: #0d121d;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .article-body-content :global(.data-table th),
  .article-body-content :global(.data-table td) {
    padding: 0.9rem 1.2rem;
    text-align: left;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 0.88rem;
  }

  .article-body-content :global(.data-table th) {
    background: #172033;
    color: var(--primary);
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .article-body-content :global(.resource-cta-box) {
    margin-top: 2.5rem;
    background: #182030;
    border: 1px solid rgba(255, 149, 0, 0.3);
    border-radius: var(--radius-md);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.8rem;
  }

  .article-body-content :global(.resource-cta-box h4) {
    font-size: 1.2rem;
    color: #fff;
    margin: 0;
  }

  .article-body-content :global(.resource-cta-box p) {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin: 0;
  }

  .cta-inner-card {
    background: linear-gradient(135deg, #161e2e 0%, #1e1b18 100%);
    border: 1px solid rgba(255, 149, 0, 0.3);
    border-radius: var(--radius-lg);
    padding: 3.5rem;
    text-align: center;
  }

  .cta-inner-card h2 {
    font-size: 2.2rem;
    color: #fff;
    margin-bottom: 0.8rem;
  }

  .cta-inner-card p {
    font-size: 1.1rem;
    color: var(--text-muted);
    max-width: 650px;
    margin: 0 auto 2rem;
  }

  .cta-btns {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .resource-article-card {
      padding: 1.75rem 1.25rem;
    }

    .hero-inner h1 {
      font-size: 1.85rem;
    }

    .resource-article-card h2 {
      font-size: 1.45rem;
    }
  }
</style>
