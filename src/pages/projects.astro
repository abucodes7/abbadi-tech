---
import Layout from '../layouts/Layout.astro';
import FAQSection from '../components/FAQSection.astro';
import Icon from '../components/Icon.astro';
import HeroAnimation from '../components/HeroAnimation.astro';
import { projectsFaqs } from '../data/faq';
import { projectsList, sectorsList, areasList } from '../data/projects';

const pageTitle = "Completed Projects | Electrical & Plumbing in Dubai | Abbadi Tech";
const pageDescription = "Explore completed MEP contracting projects in Dubai: luxury retail fit-outs, restaurant kitchens, MDB panels & villas delivered by Abbadi Tech.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.abbaditech.com/" },
    { "@type": "ListItem", "position": 2, "name": "Our Projects", "item": "https://www.abbaditech.com/projects" }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  currentPath="/projects"
  jsonLd={breadcrumbSchema}
>
  <!-- HERO -->
  <section class="projects-hero">
    <HeroAnimation />
    <div class="container hero-inner-container">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><span>Projects</span>
      </nav>

      <div class="projects-hero-text">
        <div class="badges-row">
          <span class="live-status-pill"><span class="pulse-dot"></span> Active UAE execution</span>
          <span class="badge badge-gold">Verified Case Studies</span>
        </div>
        <h1>A delivery record built across Dubai &amp; the UAE.</h1>
        <p class="lead">
          Explore our extensive delivery record spanning luxury retail fit-outs in The Dubai Mall, high-volume dining on JBR Walk and DIFC, banking branches, 5-star beachfront resorts, and industrial facilities across the UAE.
        </p>

        <div class="projects-hero-stats">
          <div class="stat-box">
            <span class="stat-val">21+</span>
            <span class="stat-name">Years UAE Experience</span>
          </div>
          <div class="stat-box">
            <span class="stat-val" data-counter="21" data-suffix="+">21+</span>
            <span class="stat-name">Years in the UAE</span>
          </div>
          <div class="stat-box">
            <span class="stat-val">6</span>
            <span class="stat-name">Core sectors</span>
          </div>
          <div class="stat-box">
            <span class="stat-val">100%</span>
            <span class="stat-name">DEWA compliant</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DIRECTORY -->
  <section class="section section-paper" id="directory">
    <div class="container">
      <div class="filter-panel-card">
        <div class="filter-row">
          <label for="proj-search" class="filter-label">Search case studies</label>
          <div class="search-input-wrap">
            <Icon name="Search" size={16} />
            <input
              type="search"
              id="proj-search"
              placeholder="Search by client (Rolex, Subway), area (Dubai Mall, Palm Jumeirah), or scope…"
              class="search-input"
            />
          </div>
        </div>

        <div class="filter-row">
          <span class="filter-label">Filter by sector</span>
          <div class="pill-group" id="sector-pills">
            {sectorsList.map((sec) => (
              <button type="button" class:list={['filter-pill', { active: sec.id === 'all' }]} data-sector={sec.id}>
                {sec.label}
              </button>
            ))}
          </div>
        </div>

        <div class="filter-row dropdown-filters-row">
          <div class="dropdown-group">
            <label for="area-select" class="filter-label">Location / area</label>
            <select id="area-select" class="filter-select">
              {areasList.map((area) => (<option value={area === 'All Areas' ? 'all' : area}>{area}</option>))}
            </select>
          </div>

          <div class="dropdown-group">
            <label for="scope-select" class="filter-label">Technical scope</label>
            <select id="scope-select" class="filter-select">
              <option value="all">All technical trades</option>
              <option value="electrical">Electrical technical work</option>
              <option value="plumbing">Plumbing technical work</option>
              <option value="both">Combined trades</option>
            </select>
          </div>
        </div>
      </div>

      <div class="results-header">
        <span id="results-count" class="results-count">Showing all 57 featured case studies</span>
        <button id="reset-filters" class="reset-btn" type="button">
          <Icon name="RotateCcw" size={13} /> Reset filters
        </button>
      </div>

      <div class="projects-case-grid" id="projects-grid">
        {projectsList.map((p) => (
          <article
            class="case-card"
            data-id={p.id}
            data-sector={p.sector}
            data-area={p.area}
            data-scope={p.scope}
            data-search={`${p.name} ${p.clientType} ${p.location} ${p.delivered} ${p.sectorLabel}`.toLowerCase()}
          >
            <div class="card-top-tags">
              <span class="sec-badge">{p.sectorLabel}</span>
              <span class="scope-tag" class:list={[{ 'scope-elec': p.scope === 'electrical', 'scope-plumb': p.scope === 'plumbing', 'scope-both': p.scope === 'both' }]}>
                {p.scope === 'electrical' ? (
                  <span><Icon name="Zap" size={11} /> Electrical</span>
                ) : p.scope === 'plumbing' ? (
                  <span><Icon name="Droplets" size={11} /> Plumbing</span>
                ) : (
                  <span><Icon name="Zap" size={11} /><Icon name="Droplets" size={11} /> Combined</span>
                )}
              </span>
            </div>

            <div class="card-main">
              <span class="project-id-pill">Project #{p.id}</span>
              <h3>{p.name}</h3>
              <p class="client-type-line">{p.clientType}</p>

              <div class="location-badge">
                <Icon name="MapPin" size={12} /> {p.location}
              </div>

              <div class="delivered-box">
                <span class="deliv-label">What was delivered</span>
                <p class="deliv-text">{p.delivered}</p>
              </div>

              <div class="card-footer-meta">
                <span class="compliance-tag"><Icon name="CheckCircle2" size={12} /> 100% DEWA compliant</span>
                <span class="photo-placeholder"><Icon name="Camera" size={12} /> Photo on request</span>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div id="no-results" class="no-results" style="display:none;">
        <p>No completed projects match your specific filter criteria.</p>
        <button type="button" class="btn btn-secondary" onclick="document.getElementById('reset-filters').click()">Clear filters</button>
      </div>
    </div>
  </section>

  <FAQSection
    title="Frequently asked questions about our project portfolio"
    subtitle="Learn more about our site approvals, client confidentiality, and handover standards."
    badge="Portfolio & delivery"
    faqs={projectsFaqs}
  />

  <!-- CTA -->
  <section class="section section-ivory">
    <div class="container">
      <div class="cta-inner-card">
        <span class="eyebrow">Your next project</span>
        <h2>Want your next project delivered with this track record?</h2>
        <p>Connect directly with Abbadi Tech's engineering estimation department for technical appraisals and transparent tender pricing.</p>
        <div class="cta-btns">
          <a href="/contact" class="btn btn-primary">Schedule a project review <Icon name="ArrowUpRight" size={16} /></a>
          <a href="https://wa.me/971505546943?text=Hi%20Abbadi%20Tech,%20I%20have%20an%20upcoming%20project%20tender" target="_blank" rel="noopener" class="btn btn-secondary"><Icon name="MessageSquare" size={16} /> Discuss on WhatsApp</a>
          <a href="tel:+971505546943" class="btn btn-outline"><Icon name="Phone" size={15} /> +971 50 554 6943</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .projects-hero {
    position: relative;
    background: var(--ink-deep);
    color: var(--white);
    padding: clamp(2.75rem, 5vw, 4.5rem) 0 clamp(3rem, 5vw, 4.5rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }

  .hero-inner-container { position: relative; z-index: 2; }

  .crumb {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-heading);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 2.25rem;
  }

  .crumb a:hover { color: var(--brass-soft); }

  .badges-row { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 1rem; }

  .live-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-heading);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--brass-soft);
    border: 1px solid rgba(180, 134, 76, 0.3);
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
  }

  .pulse-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--brass-soft); animation: pulseDot 2.4s ease-in-out infinite; }
  @keyframes pulseDot { 0%, 100% { opacity: 0.35; } 50% { opacity: 1; } }

  .projects-hero-text h1 {
    color: var(--white);
    font-size: clamp(2.6rem, 5.4vw, 4.4rem);
    margin: 0.9rem 0 1.2rem;
    max-width: 18ch;
  }

  .lead {
    font-size: clamp(1rem, 1.4vw, 1.08rem);
    color: rgba(255, 255, 255, 0.62);
    max-width: 68ch;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .projects-hero-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    border-left: 1px solid rgba(255, 255, 255, 0.12);
    max-width: 760px;
  }

  .stat-box { padding: 1.1rem 1.2rem; border-right: 1px solid rgba(255, 255, 255, 0.12); border-bottom: 1px solid rgba(255, 255, 255, 0.12); }
  .stat-val { display: block; font-family: var(--font-display); font-size: clamp(1.5rem, 2.4vw, 2.1rem); line-height: 1; color: var(--brass-soft); }
  .stat-name { display: block; margin-top: 0.35rem; font-family: var(--font-heading); font-size: 0.58rem; font-weight: 600; letter-spacing: 0.09em; text-transform: uppercase; color: rgba(255, 255, 255, 0.4); }

  .section-paper { background: var(--paper); }
  .section-ivory { background: var(--ivory); }

  .filter-panel-card {
    background: var(--ivory);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 2.5vw, 1.8rem);
    margin-bottom: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .filter-row { display: flex; flex-direction: column; gap: 0.55rem; }

  .filter-label {
    font-family: var(--font-heading);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--stone-light);
  }

  .search-input-wrap { display: flex; align-items: center; gap: 0.6rem; padding: 0 0.95rem; background: var(--white); border: 1px solid var(--line-strong); border-radius: 10px; }
  .search-input-wrap svg { color: var(--stone-light); flex-shrink: 0; }
  .search-input { flex: 1; border: 0; background: transparent; padding: 0.75rem 0; font-size: 0.88rem; box-shadow: none; }
  .search-input:focus { outline: none; border: 0; box-shadow: none; }
  .search-input-wrap:focus-within { border-color: var(--brass); box-shadow: 0 0 0 4px rgba(180, 134, 76, 0.1); }

  .pill-group { display: flex; gap: 0.45rem; flex-wrap: wrap; }

  .filter-pill {
    background: transparent;
    border: 1px solid var(--line-strong);
    color: var(--stone);
    padding: 0.45rem 0.85rem;
    border-radius: 9px;
    font-family: var(--font-heading);
    font-size: 0.76rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.24s, color 0.24s, border-color 0.24s;
  }

  .filter-pill:hover { color: var(--ink); border-color: var(--ink); }
  .filter-pill.active { background: var(--ink); color: var(--white); border-color: var(--ink); }

  .dropdown-filters-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .dropdown-group { display: flex; flex-direction: column; gap: 0.45rem; }

  .filter-select {
    padding: 0.68rem 0.9rem;
    background: var(--white);
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    color: var(--ink);
    font-size: 0.86rem;
    outline: none;
  }

  .filter-select:focus { border-color: var(--brass); box-shadow: 0 0 0 4px rgba(180, 134, 76, 0.1); }

  .results-header { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
  .results-count { font-size: 0.8rem; color: var(--stone); }

  .reset-btn { display: inline-flex; align-items: center; gap: 0.35rem; background: none; border: 0; color: var(--brass-deep); font-family: var(--font-heading); font-size: 0.76rem; font-weight: 600; cursor: pointer; }
  .reset-btn:hover { color: var(--ink); }

  .projects-case-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }

  .case-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.28s var(--ease-out), border-color 0.28s, box-shadow 0.28s;
  }

  .case-card:hover { transform: translateY(-4px); border-color: var(--line-strong); box-shadow: var(--shadow-md); }

  .card-top-tags { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.9rem; }

  .sec-badge { font-family: var(--font-heading); font-size: 0.58rem; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; color: var(--brass-deep); background: var(--brass-wash); border: 1px solid rgba(180, 134, 76, 0.22); border-radius: 6px; padding: 0.25rem 0.5rem; }

  .scope-tag { font-family: var(--font-heading); font-size: 0.62rem; font-weight: 600; padding: 0.25rem 0.5rem; border-radius: 6px; }
  .scope-tag > span { display: inline-flex; align-items: center; gap: 0.25rem; }
  .scope-elec { background: rgba(180, 134, 76, 0.1); color: var(--brass-deep); }
  .scope-plumb { background: rgba(47, 110, 104, 0.1); color: var(--teal); }
  .scope-both { background: rgba(63, 125, 99, 0.1); color: #3F7D63; }

  .project-id-pill { display: block; font-family: var(--font-heading); font-size: 0.6rem; letter-spacing: 0.08em; color: var(--stone-light); margin-bottom: 0.35rem; }

  .case-card h3 { font-family: var(--font-heading); font-size: 1.05rem; font-weight: 600; color: var(--ink); margin-bottom: 0.2rem; line-height: 1.3; }
  .client-type-line { font-size: 0.76rem; color: var(--stone-light); font-style: italic; margin-bottom: 0.7rem; }

  .location-badge { display: inline-flex; align-items: center; gap: 0.3rem; align-self: flex-start; background: var(--ivory); border: 1px solid var(--line); padding: 0.28rem 0.55rem; border-radius: 6px; font-size: 0.7rem; color: var(--stone); margin-bottom: 0.9rem; }

  .delivered-box { background: var(--paper); border-left: 2px solid var(--brass); padding: 0.7rem 0.85rem; border-radius: 0 8px 8px 0; margin-bottom: 1.1rem; }
  .deliv-label { display: block; font-family: var(--font-heading); font-size: 0.56rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--brass-deep); margin-bottom: 0.25rem; }
  .deliv-text { font-size: 0.78rem; color: var(--stone); line-height: 1.55; }

  .card-footer-meta { display: flex; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap; font-size: 0.64rem; color: var(--stone-light); border-top: 1px solid var(--line); padding-top: 0.7rem; margin-top: auto; }
  .card-footer-meta span { display: inline-flex; align-items: center; gap: 0.25rem; }
  .compliance-tag { color: #3F7D63; font-weight: 600; }

  .no-results { text-align: center; padding: 3rem 1rem; background: var(--ivory); border: 1px solid var(--line); border-radius: var(--radius-md); }
  .no-results p { font-size: 1rem; color: var(--stone); margin-bottom: 1.25rem; }

  .cta-inner-card {
    background: var(--ink);
    border: 1px solid var(--ink-line);
    border-radius: var(--radius-xl);
    padding: clamp(2rem, 5vw, 4rem);
    text-align: center;
  }

  .cta-inner-card .eyebrow { color: var(--brass-soft); }
  .cta-inner-card h2 { color: var(--white); font-size: clamp(2rem, 3.6vw, 3rem); margin: 1rem auto 0.9rem; max-width: 21ch; }
  .cta-inner-card p { color: rgba(255, 255, 255, 0.55); font-size: 0.95rem; line-height: 1.7; max-width: 64ch; margin: 0 auto 1.75rem; }
  .cta-btns { display: flex; justify-content: center; gap: 0.7rem; flex-wrap: wrap; }
  .cta-btns .btn-outline { border-color: rgba(255, 255, 255, 0.24); color: var(--white); }

  @media (max-width: 1024px) {
    .projects-case-grid { grid-template-columns: 1fr 1fr; }
    .dropdown-filters-row { grid-template-columns: 1fr; }
    .projects-hero-stats { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 650px) {
    .projects-case-grid { grid-template-columns: 1fr; }
    .projects-hero-text h1 { font-size: clamp(2.2rem, 10.5vw, 3rem); }
    .cta-btns .btn { width: 100%; }
  }
</style>

<script>
  const searchInput = document.getElementById('proj-search') as HTMLInputElement | null;
  const sectorPills = document.querySelectorAll('#sector-pills .filter-pill');
  const areaSelect = document.getElementById('area-select') as HTMLSelectElement | null;
  const scopeSelect = document.getElementById('scope-select') as HTMLSelectElement | null;
  const resultsCount = document.getElementById('results-count');
  const resetBtn = document.getElementById('reset-filters');
  const cards = document.querySelectorAll('.case-card');
  const noResults = document.getElementById('no-results');

  let activeSector = 'all';
  let activeArea = 'all';
  let activeScope = 'all';
  let searchQuery = '';

  function filterProjects() {
    let visibleCount = 0;

    cards.forEach((cardEl) => {
      const card = cardEl as HTMLElement;
      const cardSector = card.getAttribute('data-sector') || '';
      const cardArea = card.getAttribute('data-area') || '';
      const cardScope = card.getAttribute('data-scope') || '';
      const cardSearch = card.getAttribute('data-search') || '';

      const matchSector = (activeSector === 'all' || cardSector === activeSector);
      const matchArea = (activeArea === 'all' || cardArea === activeArea);
      const matchScope = (activeScope === 'all' || cardScope === activeScope);
      const matchSearch = (!searchQuery || cardSearch.includes(searchQuery));

      if (matchSector && matchArea && matchScope && matchSearch) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (resultsCount) {
      resultsCount.textContent = `Showing ${visibleCount} of ${cards.length} featured case studies`;
    }

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  sectorPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      sectorPills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      activeSector = pill.getAttribute('data-sector') || 'all';
      filterProjects();
    });
  });

  if (areaSelect) {
    areaSelect.addEventListener('change', () => {
      activeArea = areaSelect.value;
      filterProjects();
    });
  }

  if (scopeSelect) {
    scopeSelect.addEventListener('change', () => {
      activeScope = scopeSelect.value;
      filterProjects();
    });
  }

  if (searchInput) {
    searchInput.addEventListener('input', () => {
      searchQuery = searchInput.value.toLowerCase().trim();
      filterProjects();
    });
  }

  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      activeSector = 'all';
      activeArea = 'all';
      activeScope = 'all';
      searchQuery = '';

      if (searchInput) searchInput.value = '';
      if (areaSelect) areaSelect.value = 'all';
      if (scopeSelect) scopeSelect.value = 'all';

      sectorPills.forEach((p, idx) => {
        if (idx === 0) p.classList.add('active');
        else p.classList.remove('active');
      });

      filterProjects();
    });
  }
</script>
