---
// Hero Engineering Animation: Dynamic electrical conduits and plumbing flow traces
---

<div class="hero-canvas-wrap" aria-hidden="true">
  <svg class="hero-svg" viewBox="0 0 1440 700" fill="none" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <!-- Electrical Gold Gradients -->
      <linearGradient id="electricGrad" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#FF9500" stop-opacity="0" />
        <stop offset="50%" stop-color="#FF9500" stop-opacity="0.9" />
        <stop offset="100%" stop-color="#ffaa33" stop-opacity="0" />
      </linearGradient>

      <!-- Plumbing Cyan Gradients -->
      <linearGradient id="waterGrad" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#38bdf8" stop-opacity="0" />
        <stop offset="50%" stop-color="#0284c7" stop-opacity="0.8" />
        <stop offset="100%" stop-color="#38bdf8" stop-opacity="0" />
      </linearGradient>

      <!-- Glow Filters -->
      <filter id="glowGold" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="4" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>

      <filter id="glowBlue" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="3.5" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </defs>

    <!-- Isometric Blueprint Grid Background -->
    <g class="grid-layer" opacity="0.12">
      <path d="M0 100 H1440 M0 200 H1440 M0 300 H1440 M0 400 H1440 M0 500 H1440 M0 600 H1440" stroke="#26334d" stroke-width="1" stroke-dasharray="4 8" />
      <path d="M120 0 V700 M280 0 V700 M440 0 V700 M600 0 V700 M760 0 V700 M920 0 V700 M1080 0 V700 M1240 0 V700 M1400 0 V700" stroke="#26334d" stroke-width="1" stroke-dasharray="4 8" />
    </g>

    <!-- Electrical Conduits (Warm Gold) -->
    <g class="conduit-layer" filter="url(#glowGold)">
      <!-- Main busbar power trace -->
      <path class="circuit-path pulse-1" d="M -50 180 H 420 L 520 280 H 980 L 1080 180 H 1500" stroke="url(#electricGrad)" stroke-width="2.5" />
      
      <!-- Branch breaker trace -->
      <path class="circuit-path pulse-2" d="M 300 -50 V 220 L 400 320 V 650" stroke="url(#electricGrad)" stroke-width="2" />
      <path class="circuit-path pulse-3" d="M 850 -50 V 150 L 750 250 H 550 V 550" stroke="url(#electricGrad)" stroke-width="1.8" />
    </g>

    <!-- Plumbing Supply Piping (Hydro Blue) -->
    <g class="piping-layer" filter="url(#glowBlue)">
      <path class="pipe-path flow-1" d="M 1500 480 H 1060 L 960 380 H 520 L 420 480 H -50" stroke="url(#waterGrad)" stroke-width="2" stroke-dasharray="12 18" />
      <path class="pipe-path flow-2" d="M 1180 750 V 420 L 1080 320 H 920" stroke="url(#waterGrad)" stroke-width="1.8" stroke-dasharray="10 14" />
    </g>

    <!-- Live Nodes / Technical Junctions -->
    <g class="nodes-layer">
      <!-- Electrical DB junctions -->
      <circle class="junction-node node-gold" cx="420" cy="180" r="5" fill="#FF9500" />
      <circle class="junction-node node-gold" cx="520" cy="280" r="5" fill="#FF9500" />
      <circle class="junction-node node-gold" cx="980" cy="280" r="5" fill="#FF9500" />
      <circle class="junction-node node-gold" cx="1080" cy="180" r="5" fill="#FF9500" />
      <circle class="junction-node node-gold" cx="400" cy="320" r="4.5" fill="#ffaa33" />

      <!-- Plumbing Manifold junctions -->
      <circle class="junction-node node-blue" cx="1060" cy="480" r="4.5" fill="#38bdf8" />
      <circle class="junction-node node-blue" cx="960" cy="380" r="4.5" fill="#38bdf8" />
      <circle class="junction-node node-blue" cx="520" cy="380" r="4.5" fill="#38bdf8" />
      <circle class="junction-node node-blue" cx="420" cy="480" r="4.5" fill="#38bdf8" />
    </g>
  </svg>
</div>

<style>
  .hero-canvas-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
    opacity: 0.85;
  }

  .hero-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Circuit pulse animation (electrical signal traversing the conduits) */
  .circuit-path {
    stroke-dasharray: 220 380;
    animation: circuitFlow 12s linear infinite;
  }

  .pulse-1 {
    animation-duration: 9s;
  }

  .pulse-2 {
    animation-duration: 11s;
    animation-delay: -3s;
  }

  .pulse-3 {
    animation-duration: 14s;
    animation-delay: -6s;
  }

  @keyframes circuitFlow {
    0% {
      stroke-dashoffset: 600;
    }
    100% {
      stroke-dashoffset: -600;
    }
  }

  /* Pipe water flow animation */
  .pipe-path {
    animation: pipeFlow 10s linear infinite;
  }

  .flow-1 {
    animation-duration: 13s;
    animation-direction: reverse;
  }

  .flow-2 {
    animation-duration: 9s;
  }

  @keyframes pipeFlow {
    0% {
      stroke-dashoffset: 200;
    }
    100% {
      stroke-dashoffset: 0;
    }
  }

  /* Junction Node Pulsing */
  .junction-node {
    animation: nodePulse 3s ease-in-out infinite;
  }

  .node-gold {
    filter: drop-shadow(0 0 6px #FF9500);
  }

  .node-blue {
    filter: drop-shadow(0 0 6px #38bdf8);
    animation-delay: -1.5s;
  }

  @keyframes nodePulse {
    0%, 100% {
      transform: scale(1);
      opacity: 0.8;
    }
    50% {
      transform: scale(1.35);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .circuit-path, .pipe-path, .junction-node {
      animation: none !important;
    }
  }
</style>
