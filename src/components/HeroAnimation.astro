---
// Subtle architectural single-line diagram: a quiet technical signature behind hero content.
---

<div class="hero-canvas-wrap" aria-hidden="true">
  <svg class="hero-svg" viewBox="0 0 1440 760" fill="none" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="lineFade" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#D9BC92" stop-opacity="0" />
        <stop offset="45%" stop-color="#D9BC92" stop-opacity="0.55" />
        <stop offset="100%" stop-color="#D9BC92" stop-opacity="0" />
      </linearGradient>
    </defs>

    <g class="grid-layer" opacity="0.045">
      <path d="M0 100 H1440 M0 220 H1440 M0 340 H1440 M0 460 H1440 M0 580 H1440 M0 700 H1440" stroke="#FFFFFF" stroke-width="1" stroke-dasharray="3 10" />
      <path d="M120 0 V760 M280 0 V760 M440 0 V760 M600 0 V760 M760 0 V760 M920 0 V760 M1080 0 V760 M1240 0 V760 M1400 0 V760" stroke="#FFFFFF" stroke-width="1" stroke-dasharray="3 10" />
    </g>

    <g class="sld-base-layer" opacity="0.16" stroke="#D9BC92" stroke-width="1.1">
      <path d="M 120 0 V 180 H 480 V 380 H 780" />
      <path d="M 480 180 H 980 V 280 H 1320 V 520" />
      <path d="M 980 280 V 620 H 640 V 760" />
      <path d="M 240 760 V 580 H 560 V 440 H 840" />
      <path d="M 1120 0 V 160 H 1380 V 380" />
      <path d="M 720 0 V 120 H 880" />
    </g>

    <g class="busbar-layer" opacity="0.22">
      <path d="M 0 135 H 440 L 540 235 H 1020 L 1120 135 H 1440" stroke="url(#lineFade)" stroke-width="1.4" />
      <path d="M 0 148 H 445 L 545 248 H 1015 L 1115 148 H 1440" stroke="url(#lineFade)" stroke-width="1.4" />
      <path d="M 0 161 H 450 L 550 261 H 1010 L 1110 161 H 1440" stroke="url(#lineFade)" stroke-width="1.4" />
    </g>

    <g class="active-circuits">
      <path class="current-pulse pulse-fast" d="M -80 148 H 445 L 545 248 H 1015 L 1115 148 H 1520" stroke="#D9BC92" stroke-width="1.6" stroke-linecap="round" />
      <path class="current-pulse pulse-med" d="M 180 -50 V 220 L 320 360 H 680 V 540 L 820 680 H 1240" stroke="#D9BC92" stroke-width="1.3" stroke-linecap="round" />
      <path class="current-pulse pulse-slow" d="M 820 -40 V 180 L 960 320 V 620 L 1080 740" stroke="#D9BC92" stroke-width="1.3" stroke-linecap="round" />
    </g>

    <g class="relay-nodes" fill="#D9BC92" opacity="0.5">
      <circle cx="445" cy="148" r="2.5" />
      <circle cx="545" cy="248" r="2" />
      <circle cx="680" cy="540" r="2.5" />
      <circle cx="1015" cy="248" r="2" />
      <circle cx="960" cy="320" r="2" />
      <circle cx="320" cy="360" r="2" />
    </g>

    <g class="sld-tags" opacity="0.18" fill="#F5F2E9" font-family="'Manrope', sans-serif" font-size="9" font-weight="600" letter-spacing="0.14em">
      <text x="50" y="125">DEWA 415V 3-PHASE INCOMER</text>
      <text x="560" y="235">BUS-COUPLER / MDB-01</text>
      <text x="1035" y="235">SMDB-HV01 FEEDER</text>
      <text x="700" y="530">LOAD BALANCING · 0.98 PF</text>
      <text x="1135" y="130">DEWA METER CT CABINET</text>
      <text x="195" y="240">EARTH IMPEDANCE &lt; 1.0 OHM</text>
    </g>
  </svg>
</div>

<style>
  .hero-canvas-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
    background:
      radial-gradient(ellipse at 78% 18%, rgba(180, 134, 76, 0.09) 0%, transparent 55%),
      radial-gradient(ellipse at 15% 85%, rgba(47, 110, 104, 0.07) 0%, transparent 55%);
  }

  .hero-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.52;
    mask-image: linear-gradient(180deg, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.35) 70%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.35) 70%, transparent 100%);
  }

  .current-pulse {
    stroke-dasharray: 120 640;
    animation: currentFlow 24s linear infinite;
    opacity: 0.22;
  }

  .pulse-fast { animation-duration: 22s; }
  .pulse-med { animation-duration: 30s; animation-delay: -8s; }
  .pulse-slow { animation-duration: 34s; animation-delay: -16s; }

  @keyframes currentFlow {
    0% { stroke-dashoffset: 760; opacity: 0.12; }
    50% { opacity: 0.3; }
    100% { stroke-dashoffset: -760; opacity: 0.12; }
  }

  @media (prefers-reduced-motion: reduce) {
    .current-pulse { animation: none !important; }
  }
</style>
