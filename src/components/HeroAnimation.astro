---
// Hero Technical Blueprint: Refined architectural schematics for electrical and hydraulic engineering
---

<div class="hero-canvas-wrap" aria-hidden="true">
  <svg class="hero-svg" viewBox="0 0 1440 700" fill="none" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <!-- Subtle Electrical Amber Gradient -->
      <linearGradient id="electricGrad" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#F5A623" stop-opacity="0" />
        <stop offset="50%" stop-color="#F5A623" stop-opacity="0.45" />
        <stop offset="100%" stop-color="#F5A623" stop-opacity="0" />
      </linearGradient>

      <!-- Subtle Plumbing Teal Gradient -->
      <linearGradient id="waterGrad" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#16A6A1" stop-opacity="0" />
        <stop offset="50%" stop-color="#16A6A1" stop-opacity="0.4" />
        <stop offset="100%" stop-color="#16A6A1" stop-opacity="0" />
      </linearGradient>
    </defs>

    <!-- Blueprint Engineering Grid -->
    <g class="grid-layer" opacity="0.06">
      <path d="M0 120 H1440 M0 240 H1440 M0 360 H1440 M0 480 H1440 M0 600 H1440" stroke="#FFFFFF" stroke-width="1" stroke-dasharray="3 6" />
      <path d="M160 0 V700 M320 0 V700 M480 0 V700 M640 0 V700 M800 0 V700 M960 0 V700 M1120 0 V700 M1280 0 V700" stroke="#FFFFFF" stroke-width="1" stroke-dasharray="3 6" />
    </g>

    <!-- Electrical Conduits (Amber #F5A623) -->
    <g class="conduit-layer" opacity="0.6">
      <path class="circuit-path pulse-1" d="M -50 180 H 420 L 520 280 H 980 L 1080 180 H 1500" stroke="url(#electricGrad)" stroke-width="1.8" />
      <path class="circuit-path pulse-2" d="M 300 -50 V 220 L 400 320 V 650" stroke="url(#electricGrad)" stroke-width="1.5" />
      <path class="circuit-path pulse-3" d="M 850 -50 V 150 L 750 250 H 550 V 550" stroke="url(#electricGrad)" stroke-width="1.4" />
    </g>

    <!-- Plumbing Piping (Teal #16A6A1) -->
    <g class="piping-layer" opacity="0.6">
      <path class="pipe-path flow-1" d="M 1500 480 H 1060 L 960 380 H 520 L 420 480 H -50" stroke="url(#waterGrad)" stroke-width="1.6" stroke-dasharray="8 16" />
      <path class="pipe-path flow-2" d="M 1180 750 V 420 L 1080 320 H 920" stroke="url(#waterGrad)" stroke-width="1.4" stroke-dasharray="6 12" />
    </g>

    <!-- Refined Engineering Nodes -->
    <g class="nodes-layer" opacity="0.5">
      <circle cx="420" cy="180" r="3.5" fill="#F5A623" />
      <circle cx="520" cy="280" r="3.5" fill="#F5A623" />
      <circle cx="980" cy="280" r="3.5" fill="#F5A623" />
      <circle cx="1080" cy="180" r="3.5" fill="#F5A623" />
      <circle cx="1060" cy="480" r="3.5" fill="#16A6A1" />
      <circle cx="960" cy="380" r="3.5" fill="#16A6A1" />
      <circle cx="520" cy="380" r="3.5" fill="#16A6A1" />
      <circle cx="420" cy="480" r="3.5" fill="#16A6A1" />
    </g>
  </svg>
</div>

<style>
  .hero-canvas-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .hero-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .circuit-path {
    stroke-dasharray: 200 400;
    animation: circuitFlow 14s linear infinite;
  }

  .pulse-1 { animation-duration: 10s; }
  .pulse-2 { animation-duration: 13s; animation-delay: -3s; }
  .pulse-3 { animation-duration: 16s; animation-delay: -6s; }

  @keyframes circuitFlow {
    0% { stroke-dashoffset: 600; }
    100% { stroke-dashoffset: -600; }
  }

  .pipe-path {
    animation: pipeFlow 12s linear infinite;
  }

  .flow-1 { animation-duration: 15s; animation-direction: reverse; }
  .flow-2 { animation-duration: 10s; }

  @keyframes pipeFlow {
    0% { stroke-dashoffset: 200; }
    100% { stroke-dashoffset: -200; }
  }

  @media (prefers-reduced-motion: reduce) {
    .circuit-path, .pipe-path {
      animation: none !important;
    }
  }
</style>
