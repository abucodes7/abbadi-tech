---
import Icon from './Icon.astro';
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-content">
    <!-- Column 1: Brand & Credentials -->
    <div class="footer-col brand-col">
      <a href="/" class="footer-brand-logo" aria-label="Abbadi Tech Home">
        <div class="brand-logo-inline">
          <img 
            src="/images/logo/logo-icon.png" 
            alt="Abbadi Tech Official Emblem" 
            width="34" 
            height="34" 
            class="footer-emblem" 
          />
          <div class="brand-text-block">
            <div class="logo-text"><span class="logo-abbadi">ABBADI</span><span class="logo-tech">TECH</span></div>
            <div class="logo-sub">TECHNICAL SOLUTIONS L.L.C</div>
          </div>
        </div>
      </a>
      <p class="tagline">
        Specialized electrical and plumbing technical contracting for commercial, residential, and industrial infrastructure across Dubai and the UAE since 2005.
      </p>
      
      <div class="compliance-tags">
        <div class="compliance-row">
          <Icon name="Landmark" size={13} />
          <span>Trade License: <strong>571822</strong></span>
        </div>
        <div class="compliance-row">
          <Icon name="Zap" size={13} />
          <span>DEWA Registered: <strong>DEWA-M-4892</strong></span>
        </div>
      </div>

      <div class="footer-badges">
        <span class="badge badge-gold"><Icon name="Zap" size={11} /> DEWA Approved</span>
        <span class="badge badge-teal"><Icon name="Droplets" size={11} /> 1,000+ Projects</span>
        <span class="badge badge-navy badge-white-on-navy"><Icon name="CheckCircle2" size={11} /> 21+ Years Experience</span>
      </div>
    </div>

    <!-- Column 2: Electrical Engineering Services -->
    <div class="footer-col">
      <h3 class="footer-heading">Electrical Services</h3>
      <ul class="footer-links">
        <li>
          <a href="/services/electrical-contractors-dubai">
            <span class="link-title">Commercial &amp; Villa Electrical</span>
            <span class="link-sub">Full turnkey installations, wiring, lighting &amp; testing</span>
          </a>
        </li>
        <li>
          <a href="/services/electrical-contractors-dubai#panels">
            <span class="link-title">MDB &amp; SMDB Switchgear Panels</span>
            <span class="link-sub">Panel assembly, load balancing &amp; ferruled dressing</span>
          </a>
        </li>
        <li>
          <a href="/dewa-approvals-dubai">
            <span class="link-title text-amber">DEWA Approvals Dubai Division</span>
            <span class="link-sub">Fast-track fit-out NOCs, SLD drawings &amp; meter fixing</span>
          </a>
        </li>
        <li>
          <a href="/services/electrical-contractors-dubai#maintenance">
            <span class="link-title">Fault Rectification &amp; Red Notices</span>
            <span class="link-sub">DEWA compliance clearance &amp; preventive maintenance</span>
          </a>
        </li>
      </ul>
    </div>

    <!-- Column 3: Plumbing & Hydraulic Services -->
    <div class="footer-col">
      <h3 class="footer-heading">Plumbing Services</h3>
      <ul class="footer-links">
        <li>
          <a href="/services/plumbing-contractors-dubai">
            <span class="link-title">Water Supply &amp; Piping</span>
            <span class="link-sub">PPR, PEX &amp; copper installations for buildings &amp; villas</span>
          </a>
        </li>
        <li>
          <a href="/services/plumbing-contractors-dubai#drainage">
            <span class="link-title">Drainage &amp; Waste Water Networks</span>
            <span class="link-sub">UPVC &amp; HDPE drainage lines, grease traps, vent pipes</span>
          </a>
        </li>
        <li>
          <a href="/services/plumbing-contractors-dubai#pumps">
            <span class="link-title">Booster &amp; Transfer Pumps</span>
            <span class="link-sub">Pressure vessel maintenance &amp; automated pumping panels</span>
          </a>
        </li>
        <li>
          <a href="/gallery">
            <span class="link-title">Work Photos Gallery</span>
            <span class="link-sub">16+ Verified real project installations in Dubai</span>
          </a>
        </li>
        <li>
          <a href="/blog">
            <span class="link-title text-amber">Engineering Blog &amp; Guides</span>
            <span class="link-sub">DEWA regulations, Red Notices &amp; Trakhees NOC insights</span>
          </a>
        </li>
      </ul>
    </div>

    <!-- Column 4: Dubai Headquarters & Direct Contacts -->
    <div class="footer-col">
      <h3 class="footer-heading">Dubai Headquarters</h3>
      <address class="footer-address">
        Oberoi Properties Building,<br/>
        Behind Al Khail Mall,<br/>
        P.O. Box: 121908, Dubai, UAE
      </address>
      
      <div class="footer-direct-contact">
        <a href="tel:+971505546943" class="contact-action-link">
          <Icon name="Phone" size={14} />
          <span>+971 50 554 6943</span>
        </a>
        <a href="https://wa.me/971505546943?text=Hello%20Abbadi%20Tech,%20I%20have%20an%20enquiry" target="_blank" rel="noopener" class="contact-action-link wa">
          <Icon name="MessageSquare" size={14} />
          <span>WhatsApp Quick Dispatch</span>
        </a>
        <a href="mailto:it.abbaditech@gmail.com" class="contact-action-link">
          <Icon name="Mail" size={14} />
          <span>it.abbaditech@gmail.com</span>
        </a>
      </div>

      <div class="footer-hours">
        <span class="hours-label">Operational Hours:</span>
        <span class="hours-val">Saturday – Thursday: 8:00 AM – 6:00 PM<br/>(24/7 On-Call Emergency Teams)</span>
      </div>
    </div>
  </div>

  <!-- Bottom Copyright & Compliance Bar -->
  <div class="footer-bottom">
    <div class="container bottom-inner">
      <p>&copy; 2005 – {currentYear} Abbadi Tech Technical Solutions LLC. All rights reserved.</p>
      <div class="bottom-links">
        <a href="/">Home</a>
        <span class="sep">•</span>
        <a href="/about">About Us</a>
        <span class="sep">•</span>
        <a href="/services/electrical-contractors-dubai">Electrical</a>
        <span class="sep">•</span>
        <a href="/services/plumbing-contractors-dubai">Plumbing</a>
        <span class="sep">•</span>
        <a href="/dewa-approvals-dubai">DEWA Approvals</a>
        <span class="sep">•</span>
        <a href="/projects">Projects</a>
        <span class="sep">•</span>
        <a href="/gallery">Gallery</a>
        <span class="sep">•</span>
        <a href="/blog">Blog &amp; Guides</a>
        <span class="sep">•</span>
        <a href="/contact">Contact</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-navy);
    border-top: 1px solid var(--color-navy-border);
    color: #94A3B8;
    font-size: 0.92rem;
    margin-top: auto;
  }

  .footer-content {
    display: grid;
    grid-template-columns: 1.25fr 1fr 1fr 1.15fr;
    gap: 2.5rem;
    padding-top: 4.5rem;
    padding-bottom: 4rem;
  }

  .brand-logo-inline {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1rem;
    text-decoration: none;
  }

  .footer-emblem {
    width: 34px;
    height: 34px;
    object-fit: contain;
  }

  .brand-text-block {
    display: flex;
    flex-direction: column;
  }

  .logo-text {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1;
    display: flex;
    gap: 0.15rem;
  }

  .logo-abbadi {
    color: #FFFFFF;
  }

  .logo-tech {
    color: var(--color-teal);
    font-weight: 900;
  }

  .logo-sub {
    font-family: var(--font-heading);
    font-size: 0.54rem;
    letter-spacing: 0.12em;
    color: #94A3B8;
    margin-top: 0.2rem;
    font-weight: 700;
  }

  .tagline {
    font-size: 0.88rem;
    line-height: 1.6;
    color: #CBD5E1;
    margin-bottom: 1.25rem;
  }

  .compliance-tags {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: #94A3B8;
    background: rgba(7, 21, 36, 0.6);
    border: 1px solid var(--color-navy-border);
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    margin-bottom: 1.25rem;
  }

  .compliance-row {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .compliance-row strong {
    color: #FFFFFF;
  }

  .footer-badges {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .footer-heading {
    font-size: 1.1rem;
    font-weight: 800;
    color: #FFFFFF;
    margin-bottom: 1.35rem;
    position: relative;
    padding-bottom: 0.5rem;
    letter-spacing: -0.01em;
  }

  .footer-heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 28px;
    height: 2px;
    background: var(--color-amber);
    border-radius: 1px;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-links a {
    display: block;
  }

  .link-title {
    display: block;
    font-weight: 600;
    font-size: 0.9rem;
    color: #E2E8F0;
    transition: color 0.2s ease;
  }

  .footer-links a:hover .link-title {
    color: var(--color-amber);
  }

  .text-amber {
    color: var(--color-amber);
  }

  .link-sub {
    display: block;
    font-size: 0.78rem;
    color: #64748B;
    margin-top: 0.15rem;
    line-height: 1.35;
  }

  .footer-address {
    font-style: normal;
    font-size: 0.88rem;
    line-height: 1.55;
    color: #CBD5E1;
    margin-bottom: 1.25rem;
  }

  .footer-direct-contact {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
  }

  .contact-action-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #E2E8F0;
    font-size: 0.88rem;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .contact-action-link:hover {
    color: var(--color-amber);
  }

  .contact-action-link.wa {
    color: var(--color-teal-light);
  }

  .contact-action-link.wa:hover {
    color: #FFFFFF;
  }

  .footer-hours {
    font-size: 0.78rem;
    color: #64748B;
    line-height: 1.45;
  }

  .hours-label {
    display: block;
    color: #94A3B8;
    font-weight: 600;
    margin-bottom: 0.15rem;
  }

  .footer-bottom {
    background: var(--color-navy-dark);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding: 1.25rem 0;
    font-size: 0.82rem;
  }

  .bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .bottom-links {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .bottom-links a {
    color: #94A3B8;
  }

  .bottom-links a:hover {
    color: var(--color-amber);
  }

  .sep {
    color: #334155;
  }

  @media (max-width: 1024px) {
    .footer-content {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: 2.2rem;
      padding-top: 3.5rem;
    }

    .bottom-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
