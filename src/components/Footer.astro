---
import Icon from './Icon.astro';
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-cta">
    <div class="container footer-cta-inner">
      <div>
        <span class="eyebrow">Start a project</span>
        <h2 class="footer-cta-title">Engineering that holds.<br /><em>From first fix to final handover.</em></h2>
      </div>
      <div class="footer-cta-actions">
        <a href="/contact" class="btn btn-primary">
          Request a technical quote
          <Icon name="ArrowUpRight" size={16} />
        </a>
        <a href="tel:+971505546943" class="btn btn-outline-white">
          <Icon name="Phone" size={15} /> +971 50 554 6943
        </a>
      </div>
    </div>
  </div>

  <div class="container footer-main">
    <div class="footer-brand-col">
      <a href="/" class="footer-brand" aria-label="Abbadi Tech Home">
        <img src="/images/logo/logo-icon.png" alt="" width="34" height="34" />
        <span>
          <strong>Abbadi Tech</strong>
          <span>Technical Solutions L.L.C</span>
        </span>
      </a>
      <p class="footer-tagline">
        Specialized electrical and plumbing technical contracting for commercial, residential, and industrial infrastructure across Dubai and the UAE since 2005.
      </p>
      <div class="footer-badges">
        <span class="badge badge-white-on-navy"><Icon name="Calendar" size={11} /> Since 2005</span>
        <span class="badge badge-white-on-navy"><Icon name="Building2" size={11} /> 20+ Years UAE Execution</span>
      </div>
    </div>

    <div class="footer-col">
      <h3 class="footer-heading">Electrical</h3>
      <ul class="footer-links">
        <li><a href="/services/electrical-contractors-dubai">Commercial &amp; villa electrical</a></li>
        <li><a href="/services/electrical-contractors-dubai#panels">MDB &amp; SMDB switchgear</a></li>
        <li><a href="/dewa-approvals-dubai">DEWA approvals &amp; fit-out NOCs</a></li>
        <li><a href="/services/electrical-contractors-dubai#maintenance">Fault rectification &amp; maintenance</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h3 class="footer-heading">Plumbing</h3>
      <ul class="footer-links">
        <li><a href="/services/plumbing-contractors-dubai">Water supply &amp; PPR piping</a></li>
        <li><a href="/services/plumbing-contractors-dubai#drainage">Drainage &amp; grease traps</a></li>
        <li><a href="/services/plumbing-contractors-dubai#pumps">Booster &amp; transfer pumps</a></li>
        <li><a href="/gallery">Verified work photos</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h3 class="footer-heading">Company</h3>
      <ul class="footer-links">
        <li><a href="/about">About Abbadi Tech</a></li>
        <li><a href="/projects">Projects directory</a></li>
        <li><a href="/areas-we-serve">Areas we serve</a></li>
        <li><a href="/blog">Engineering insights</a></li>
        <li><a href="/resources">Technical resources</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </div>

    <div class="footer-col footer-contact-col">
      <h3 class="footer-heading">Dubai HQ</h3>
      <address class="footer-address">
        Oberoi Properties Building,<br />
        Behind Al Khail Mall,<br />
        P.O. Box 121908, Dubai, UAE
      </address>
      <div class="footer-contact-links">
        <a href="tel:+971505546943"><Icon name="Phone" size={14} /> +971 50 554 6943</a>
        <a href="mailto:it.abbaditech@gmail.com"><Icon name="Mail" size={14} /> it.abbaditech@gmail.com</a>
        <a href="https://wa.me/971505546943?text=Hello%20Abbadi%20Tech,%20I%20have%20an%20enquiry" target="_blank" rel="noopener">
          <Icon name="MessageSquare" size={14} /> WhatsApp quick dispatch
        </a>
      </div>
      <p class="footer-hours">
        <span>Saturday – Thursday</span>
        8:00 AM – 6:00 PM · 24/7 emergency on-call
      </p>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>&copy; 2005 – {currentYear} Abbadi Tech Technical Solutions LLC. All rights reserved.</p>
      <nav class="footer-legal" aria-label="Footer">
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a href="/resources">Resources</a>
        <a href="/areas-we-serve">Coverage</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink-deep);
    color: rgba(255, 255, 255, 0.62);
    margin-top: auto;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .footer-cta {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: var(--ink-2);
  }

  .footer-cta-inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2.5rem;
    padding-top: clamp(3rem, 5vw, 5rem);
    padding-bottom: clamp(3rem, 5vw, 5rem);
  }

  .footer-cta .eyebrow { color: var(--brass-soft); }

  .footer-cta-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.6vw, 3.2rem);
    font-weight: 400;
    line-height: 1.05;
    color: var(--white);
    margin-top: 0.9rem;
    letter-spacing: -0.012em;
  }

  .footer-cta-title em { font-style: italic; color: var(--brass-soft); }

  .footer-cta-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; flex-shrink: 0; }

  .footer-main {
    display: grid;
    grid-template-columns: 1.5fr 0.85fr 0.85fr 0.8fr 1.2fr;
    gap: 2.5rem;
    padding-top: 4rem;
    padding-bottom: 3.5rem;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 1.15rem;
  }

  .footer-brand img { width: 32px; height: 32px; object-fit: contain; }

  .footer-brand span { display: flex; flex-direction: column; line-height: 1; }

  .footer-brand strong {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--white);
  }

  .footer-brand span span {
    margin-top: 0.35rem;
    font-family: var(--font-heading);
    font-size: 0.48rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.38);
  }

  .footer-tagline {
    font-size: 0.9rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.55);
    max-width: 34ch;
    margin-bottom: 1.35rem;
  }

  .footer-badges { display: flex; gap: 0.45rem; flex-wrap: wrap; }

  .footer-heading {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
    margin-bottom: 1.4rem;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .footer-links a {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.65);
    transition: color 0.22s, padding-left 0.22s var(--ease-out);
  }

  .footer-links a:hover { color: var(--white); padding-left: 4px; }

  .footer-address {
    font-style: normal;
    font-size: 0.88rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 1.25rem;
  }

  .footer-contact-links {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-bottom: 1.35rem;
  }

  .footer-contact-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.68);
  }

  .footer-contact-links a:hover { color: var(--brass-soft); }

  .footer-hours {
    font-size: 0.74rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.38);
  }

  .footer-hours span {
    display: block;
    color: rgba(255, 255, 255, 0.55);
    font-weight: 600;
    margin-bottom: 0.15rem;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    padding: 1.35rem 0;
  }

  .footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.36);
  }

  .footer-legal { display: flex; gap: 1.25rem; }
  .footer-legal a { color: rgba(255, 255, 255, 0.46); }
  .footer-legal a:hover { color: var(--brass-soft); }

  @media (max-width: 1100px) {
    .footer-main { grid-template-columns: 1.4fr 1fr 1fr 1.2fr; }
    .footer-contact-col { grid-column: 2 / -1; }
  }

  @media (max-width: 900px) {
    .footer-cta-inner { flex-direction: column; align-items: flex-start; }
    .footer-main { grid-template-columns: 1fr 1fr; gap: 2.5rem; }
    .footer-contact-col { grid-column: auto; }
  }

  @media (max-width: 600px) {
    .footer-main { grid-template-columns: 1fr; gap: 2.25rem; padding-top: 3rem; }
    .footer-bottom-inner { flex-direction: column; text-align: center; }
    .footer-cta-actions { width: 100%; }
    .footer-cta-actions .btn { width: 100%; }
  }
</style>
