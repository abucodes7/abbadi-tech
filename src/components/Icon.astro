---
import DynamicIcon from './DynamicIcon';

interface Props {
  name: string;
  size?: number | string;
  color?: string;
  strokeWidth?: number | string;
  class?: string;
  className?: string;
  style?: Record<string, any> | string;
  [key: string]: any;
}

const { 
  name, 
  size = 18, 
  color = 'currentColor', 
  strokeWidth = 2, 
  class: classProp, 
  className, 
  style, 
  ...rest 
} = Astro.props;

const appliedClass = classProp || className || '';
---

<DynamicIcon 
  name={name} 
  size={size} 
  color={color} 
  strokeWidth={strokeWidth} 
  className={appliedClass} 
  style={style} 
  {...rest} 
/>
