---
// Mobile Sticky Call & WhatsApp Bar for maximum conversion
interface Props {
  phone?: string;
  mobile?: string;
}

const { 
  phone = "+971505546943", 
  mobile = "971505546943" 
} = Astro.props;
---

<div class="mobile-sticky-action-bar" aria-label="Quick Contact Actions">
  <a href="tel:+971505546943" class="action-btn action-call" aria-label="Call Abbadi Tech Engineer">
    <svg class="action-icon" viewBox="0 0 24 24" fill="currentColor">
      <path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 00-1.01.24l-1.57 1.97c-2.83-1.44-5.15-3.75-6.59-6.59l1.97-1.57c.28-.28.36-.67.25-1.02A11.36 11.36 0 018.57 4.3c0-.55-.45-1-1-1H4.14c-.55 0-1 .45-1 1 0 9.39 7.61 17 17 17 .55 0 1-.45 1-1v-3.47c0-.55-.45-1-.99-1.45z"/>
    </svg>
    <div class="btn-text">
      <span class="btn-sub">Direct Call</span>
      <span class="btn-main">+971 50 554 6943</span>
    </div>
  </a>

  <a href={`https://wa.me/${mobile}?text=${encodeURIComponent("Hello Abbadi Tech, I would like to request a quote for electrical / plumbing contracting.")}`} target="_blank" rel="noopener noreferrer" class="action-btn action-whatsapp" aria-label="WhatsApp Abbadi Tech">
    <svg class="action-icon" viewBox="0 0 32 32" fill="currentColor">
      <path d="M16.01 2.012c-7.72 0-14 6.28-14 14 0 2.47.64 4.88 1.87 7.02l-1.99 7.27 7.44-1.95c2.07 1.13 4.41 1.73 6.68 1.73h.01c7.72 0 14-6.28 14-14 0-3.74-1.46-7.26-4.1-9.9-2.65-2.65-6.17-4.11-9.91-4.11v-.06zm0 25.59c-2.11 0-4.17-.57-5.99-1.65l-.43-.25-4.44 1.16 1.18-4.33-.28-.44c-1.19-1.89-1.81-4.07-1.81-6.31 0-6.43 5.23-11.66 11.67-11.66 3.12 0 6.05 1.21 8.25 3.42 2.21 2.21 3.42 5.14 3.42 8.25 0 6.43-5.23 11.66-11.57 11.82v-.01zm6.39-8.73c-.35-.18-2.07-1.02-2.39-1.14-.32-.12-.55-.18-.79.18-.23.35-.91 1.14-1.11 1.38-.2.23-.41.26-.76.09-.35-.18-1.48-.55-2.82-1.74-1.04-.93-1.75-2.08-1.95-2.43-.2-.35-.02-.54.15-.71.16-.16.35-.41.53-.61.18-.2.23-.35.35-.59.12-.23.06-.44-.03-.61-.09-.18-.79-1.91-1.09-2.62-.29-.69-.58-.6-.79-.61h-.67c-.23 0-.61.09-.93.44-.32.35-1.23 1.2-1.23 2.93 0 1.73 1.26 3.4 1.44 3.63.18.23 2.48 3.79 6.01 5.31.84.36 1.5.58 2.01.74.84.27 1.61.23 2.22.14.68-.1 2.07-.85 2.36-1.66.29-.82.29-1.52.2-1.66-.08-.14-.32-.23-.67-.41z"/>
    </svg>
    <div class="btn-text">
      <span class="btn-sub">WhatsApp</span>
      <span class="btn-main">Get Instant Quote</span>
    </div>
  </a>
</div>

<style>
  .mobile-sticky-action-bar {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 9998;
    background: #0B1F33;
    border-top: 1px solid var(--color-navy-border);
    padding: 0.65rem 0.85rem;
    padding-bottom: calc(0.65rem + env(safe-area-inset-bottom, 0px));
    gap: 0.65rem;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.45);
  }

  .action-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.65rem 0.75rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-family: var(--font-heading);
    transition: transform 0.15s ease, filter 0.15s ease;
  }

  .action-call {
    background: #132B45;
    border: 1px solid var(--color-navy-border);
    color: #FFFFFF;
  }

  .action-call:hover, .action-call:active {
    background: #1A3859;
    color: var(--color-amber);
  }

  .action-whatsapp {
    background: #16A6A1;
    color: #FFFFFF;
    border: 1px solid #107E7A;
    box-shadow: 0 2px 8px rgba(22, 166, 161, 0.35);
  }

  .action-whatsapp:hover, .action-whatsapp:active {
    background: #128A86;
  }

  .action-icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
  }

  .btn-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    text-align: left;
  }

  .btn-sub {
    font-size: 0.68rem;
    color: rgba(255, 255, 255, 0.75);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 600;
  }

  .btn-main {
    font-size: 0.88rem;
    font-weight: 700;
    color: #FFFFFF;
  }

  @media (max-width: 768px) {
    .mobile-sticky-action-bar {
      display: flex;
    }
  }
</style>
