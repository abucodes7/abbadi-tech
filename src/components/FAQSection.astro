---
import type { FAQItem } from '../data/faq';
import Icon from './Icon.astro';

interface Props {
  items?: FAQItem[];
  faqs?: FAQItem[];
  title?: string;
  subtitle?: string;
  sectionId?: string;
  badge?: string;
}

const {
  items: rawItems,
  faqs: rawFaqs,
  title = "Frequently Asked Questions",
  subtitle = "Direct, expert answers regarding technical execution, DEWA compliance, standards, and quotations in Dubai.",
  sectionId = "faq-section",
  badge = "FAQ"
} = Astro.props;

const items = rawItems || rawFaqs || [];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": items.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<section id={sectionId} class="section section-faq">
  <div class="container">
    <div class="faq-layout">
      <aside class="faq-aside">
        <span class="eyebrow">{badge}</span>
        <h2>{title}</h2>
        <p class="faq-lead">{subtitle}</p>

        <div class="faq-search-wrapper">
          <label class="faq-search-label" for={`faq-search-${sectionId}`}>Search this section</label>
          <div class="faq-search-field">
            <Icon name="Search" size={16} />
            <input
              id={`faq-search-${sectionId}`}
              type="search"
              class="faq-search-input"
              placeholder="Search DEWA approvals, MDB panels, PPR, booster pumps"
              aria-label="Filter frequently asked questions"
            />
          </div>
          <div class="faq-count" aria-live="polite"></div>
        </div>

        <div class="faq-help">
          <p>Need a direct answer for your site?</p>
          <a href="https://wa.me/971505546943?text=Hi%20AbbadiTech,%20I%20have%20a%20technical%20question%20regarding%20my%20site" target="_blank" rel="noopener" class="text-link">
            Ask a senior engineer
            <Icon name="ArrowUpRight" size={15} />
          </a>
        </div>
      </aside>

      <div class="faq-accordion-list">
        {items.map((item, index) => (
          <details class="faq-item" open={index === 0}>
            <summary class="faq-summary">
              <span class="q-index">{String(index + 1).padStart(2, '0')}</span>
              <span class="q-text">{item.question}</span>
              <span class="faq-toggle" aria-hidden="true"></span>
            </summary>
            <div class="faq-body">
              <div class="faq-body-inner">
                <p>{item.answer}</p>
                {item.category && <span class="faq-cat-tag">{item.category}</span>}
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

<script>
  const searchInputs = document.querySelectorAll('.faq-search-input');
  searchInputs.forEach(input => {
    input.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement;
      const term = target.value.toLowerCase().trim();
      const parentSection = target.closest('.section-faq');
      if (!parentSection) return;

      const items = parentSection.querySelectorAll<HTMLDetailsElement>('.faq-item');
      let visibleCount = 0;

      items.forEach(item => {
        const text = item.textContent?.toLowerCase() || '';
        if (text.includes(term)) {
          item.style.display = 'block';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      const countEl = parentSection.querySelector('.faq-count');
      if (countEl) {
        countEl.textContent = q ? `${visibleCount} match${visibleCount === 1 ? '' : 'es'} found` : '';
      }
    });
  });
</script>

<style>
  .section-faq {
    background: var(--paper);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    position: relative;
  }

  .faq-layout {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .faq-aside { position: sticky; top: 130px; }

  .faq-aside h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 2.9rem);
    font-weight: 400;
    line-height: 1.06;
    margin: 0.9rem 0 1rem;
    color: var(--ink);
  }

  .faq-lead { font-size: 0.93rem; line-height: 1.7; color: var(--stone); max-width: 42ch; margin-bottom: 1.75rem; }

  .faq-search-wrapper { margin-bottom: 2rem; }

  .faq-search-label {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--stone-light);
    margin-bottom: 0.5rem;
  }

  .faq-search-field {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0 0.9rem;
    background: var(--white);
    border: 1px solid var(--line-strong);
    border-radius: 11px;
    transition: border-color 0.24s, box-shadow 0.24s;
  }

  .faq-search-field:focus-within { border-color: var(--brass); box-shadow: 0 0 0 4px rgba(180, 134, 76, 0.12); }
  .faq-search-field svg { color: var(--stone-light); flex-shrink: 0; }

  .faq-search-input {
    flex: 1;
    border: 0;
    background: transparent;
    padding: 0.8rem 0;
    font-size: 0.88rem;
    box-shadow: none;
  }

  .faq-search-input:focus { outline: none; box-shadow: none; border: 0; }

  .faq-count { margin-top: 0.5rem; font-size: 0.72rem; color: var(--stone-light); }

  .faq-help {
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .faq-help p { font-size: 0.85rem; color: var(--stone); margin-bottom: 0.6rem; }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink);
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 0.2rem;
    transition: color 0.24s, border-color 0.24s, gap 0.24s var(--ease-out);
  }

  .text-link:hover { color: var(--brass-deep); border-color: var(--brass); gap: 0.7rem; }

  .faq-accordion-list { display: flex; flex-direction: column; }

  .faq-item {
    border-top: 1px solid var(--line);
    transition: border-color 0.3s;
  }

  .faq-item:last-child { border-bottom: 1px solid var(--line); }
  .faq-item[open] { border-top-color: var(--brass); }

  .faq-summary {
    list-style: none;
    cursor: pointer;
    padding: 1.35rem 0;
    display: flex;
    align-items: baseline;
    gap: 1rem;
    user-select: none;
  }

  .faq-summary::-webkit-details-marker { display: none; }

  .q-index {
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--brass);
    flex-shrink: 0;
    width: 1.6rem;
  }

  .q-text {
    flex: 1;
    font-family: var(--font-heading);
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.45;
    transition: color 0.24s;
  }

  .faq-summary:hover .q-text { color: var(--brass-deep); }

  .faq-toggle {
    position: relative;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    align-self: center;
  }

  .faq-toggle::before,
  .faq-toggle::after {
    content: '';
    position: absolute;
    background: var(--ink);
    border-radius: 1px;
    transition: transform 0.28s var(--ease-out), opacity 0.28s;
  }

  .faq-toggle::before { top: 7px; left: 0; width: 16px; height: 1.5px; }
  .faq-toggle::after { top: 0; left: 7.25px; width: 1.5px; height: 16px; }
  .faq-item[open] .faq-toggle::after { transform: rotate(90deg); opacity: 0; }

  .faq-body { padding: 0 0 1.5rem 2.6rem; }

  .faq-body-inner p { font-size: 0.92rem; line-height: 1.72; color: var(--stone); }

  .faq-cat-tag {
    display: inline-block;
    margin-top: 0.8rem;
    font-family: var(--font-heading);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brass-deep);
    background: var(--brass-wash);
    border: 1px solid rgba(180, 134, 76, 0.24);
    border-radius: 6px;
    padding: 0.25rem 0.55rem;
  }

  @media (max-width: 900px) {
    .faq-layout { grid-template-columns: 1fr; }
    .faq-aside { position: static; }
    .faq-body { padding-left: 2.6rem; }
  }

  @media (max-width: 560px) {
    .faq-body { padding-left: 0; }
    .q-index { display: none; }
  }
</style>
