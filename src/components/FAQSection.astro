---
import type { FAQItem } from '../data/faq';
import Icon from './Icon.astro';

interface Props {
  items?: FAQItem[];
  faqs?: FAQItem[];
  title?: string;
  subtitle?: string;
  sectionId?: string;
  badge?: string;
}

const { 
  items: rawItems,
  faqs: rawFaqs,
  title = "Frequently Asked Questions", 
  subtitle = "Direct, expert answers regarding technical execution, DEWA compliance, standards, and quotations in Dubai.",
  sectionId = "faq-section",
  badge = "SEO Technical FAQ"
} = Astro.props;

const items = rawItems || rawFaqs || [];

// Generate Schema.org FAQPage JSON-LD
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": items.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<section id={sectionId} class="section section-faq">
  <div class="container">
    <div class="section-header">
      <span class="badge badge-navy">{badge}</span>
      <h2>{title}</h2>
      <p>{subtitle}</p>

      <!-- Interactive Search Filter -->
      <div class="faq-search-wrapper">
        <input 
          type="search" 
          class="faq-search-input" 
          placeholder="Search questions (e.g. DEWA, MDB panel, PPR pipes, booster pump, quote)..." 
          aria-label="Filter frequently asked questions"
        />
        <div class="faq-count" aria-live="polite">Showing {items.length} questions</div>
      </div>
    </div>

    <!-- Accordion List -->
    <div class="faq-accordion-list">
      {items.map((item, index) => (
        <details class="faq-item" open={index === 0}>
          <summary class="faq-summary">
            <span class="q-icon">Q</span>
            <span class="q-text">{item.question}</span>
            <span class="toggle-icon"></span>
          </summary>
          <div class="faq-body">
            <div class="faq-body-inner">
              <span class="a-icon">A</span>
              <div class="a-content">
                <p>{item.answer}</p>
                {item.category && (
                  <span class="faq-cat-tag">Discipline: {item.category}</span>
                )}
              </div>
            </div>
          </div>
        </details>
      ))}
    </div>

    <!-- Direct Consultation Help Box inside FAQ -->
    <div class="faq-help-box">
      <div class="help-text">
        <h4>Have a specific engineering question about your site?</h4>
        <p>Our senior MEP engineers and DEWA-licensed coordinators are ready to inspect your site drawings and premises.</p>
      </div>
      <div class="help-actions">
        <a href="https://wa.me/971505546943?text=Hi%20AbbadiTech,%20I%20have%20a%20technical%20question%20regarding%20my%20site" target="_blank" rel="noopener" class="btn btn-primary">
          <Icon name="MessageSquare" size={16} /> Ask via WhatsApp
        </a>
        <a href="tel:+971505546943" class="btn btn-secondary">
          <Icon name="Phone" size={16} /> +971 50 554 6943
        </a>
      </div>
    </div>
  </div>

  <!-- Schema.org FAQPage structured data -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

<script>
  // Client-side search filtering
  const searchInputs = document.querySelectorAll('.faq-search-input');
  searchInputs.forEach(input => {
    input.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement;
      const term = target.value.toLowerCase().trim();
      const parentSection = target.closest('.section-faq');
      if (!parentSection) return;

      const items = parentSection.querySelectorAll<HTMLDetailsElement>('.faq-item');
      let visibleCount = 0;

      items.forEach(item => {
        const text = item.textContent?.toLowerCase() || '';
        if (text.includes(term)) {
          item.style.display = 'block';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      const countEl = parentSection.querySelector('.faq-count');
      if (countEl) {
        countEl.textContent = `Showing ${visibleCount} of ${items.length} questions`;
      }
    });
  });
</script>

<style>
  .section-faq {
    background: #F6F8FA;
    border-top: 1px solid var(--color-border-light);
    border-bottom: 1px solid var(--color-border-light);
    position: relative;
  }

  .faq-search-wrapper {
    margin-top: 2rem;
    max-width: 620px;
    margin-left: auto;
    margin-right: auto;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .faq-search-input {
    width: 100%;
    padding: 0.95rem 1.4rem;
    background: #FFFFFF;
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    color: var(--color-graphite);
    font-size: 0.95rem;
    font-family: inherit;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .faq-search-input:focus {
    outline: none;
    border-color: var(--color-navy);
    box-shadow: 0 0 0 3px rgba(11, 31, 51, 0.1);
  }

  .faq-count {
    font-size: 0.82rem;
    color: var(--color-slate);
    text-align: right;
  }

  .faq-accordion-list {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    background: #FFFFFF;
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
    overflow: hidden;
    box-shadow: var(--shadow-subtle);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .faq-item:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-sm);
  }

  .faq-item[open] {
    border-color: #CBD5E1;
    border-left: 3px solid var(--color-amber);
  }

  .faq-summary {
    list-style: none;
    cursor: pointer;
    padding: 1.25rem 1.6rem;
    display: flex;
    align-items: center;
    gap: 1.2rem;
    user-select: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .q-icon {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 0.95rem;
    background: var(--color-amber-subtle);
    color: #B87708;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .q-text {
    font-family: var(--font-heading);
    font-size: 1.08rem;
    font-weight: 700;
    color: var(--color-navy);
    flex: 1;
    line-height: 1.4;
  }

  .toggle-icon {
    position: relative;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .toggle-icon::before, .toggle-icon::after {
    content: '';
    position: absolute;
    background: var(--color-navy);
    border-radius: 2px;
    transition: transform 0.25s ease;
  }

  .toggle-icon::before {
    top: 8px;
    left: 0;
    width: 18px;
    height: 2px;
  }

  .toggle-icon::after {
    top: 0;
    left: 8px;
    width: 2px;
    height: 18px;
  }

  .faq-item[open] .toggle-icon::after {
    transform: rotate(90deg);
    opacity: 0;
  }

  .faq-body {
    padding: 0 1.6rem 1.4rem;
    border-top: 1px solid var(--color-border-light);
    margin-top: 0.2rem;
    padding-top: 1.2rem;
  }

  .faq-body-inner {
    display: flex;
    gap: 1.2rem;
    align-items: flex-start;
  }

  .a-icon {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 0.95rem;
    background: rgba(22, 166, 161, 0.12);
    color: var(--color-teal);
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .a-content p {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-graphite);
  }

  .faq-cat-tag {
    display: inline-block;
    font-size: 0.74rem;
    color: var(--color-slate);
    margin-top: 0.75rem;
    font-weight: 600;
  }

  /* Help box */
  .faq-help-box {
    margin-top: 3.5rem;
    background: var(--color-navy);
    color: #FFFFFF;
    border: 1px solid var(--color-navy-border);
    border-radius: var(--radius-md);
    padding: 2.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    box-shadow: var(--shadow-md);
  }

  .help-text h4 {
    font-size: 1.25rem;
    color: #FFFFFF;
    margin-bottom: 0.4rem;
  }

  .help-text p {
    font-size: 0.92rem;
    color: #CBD5E1;
    line-height: 1.5;
  }

  .help-actions {
    display: flex;
    gap: 0.85rem;
    flex-shrink: 0;
    flex-wrap: wrap;
  }

  @media (max-width: 800px) {
    .faq-help-box {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
      padding: 1.75rem;
    }
    .help-actions {
      width: 100%;
    }
    .help-actions .btn {
      width: 100%;
    }
  }
</style>
