---
interface Props {
  phone?: string;
  defaultMessage?: string;
}

const { 
  phone = "971551313403", 
  defaultMessage = "Hello AbbadiTech, I have an urgent inquiry regarding Electrical / Plumbing technical work in Dubai." 
} = Astro.props;

const waUrl = `https://wa.me/${phone}?text=${encodeURIComponent(defaultMessage)}`;
---

<div class="wa-float-container">
  <a href={waUrl} target="_blank" rel="noopener noreferrer" class="wa-float-btn" aria-label="Chat on WhatsApp with AbbadiTech Engineer">
    <svg class="wa-icon" viewBox="0 0 32 32" fill="currentColor">
      <path d="M16.01 2.012c-7.72 0-14 6.28-14 14 0 2.47.64 4.88 1.87 7.02l-1.99 7.27 7.44-1.95c2.07 1.13 4.41 1.73 6.68 1.73h.01c7.72 0 14-6.28 14-14 0-3.74-1.46-7.26-4.1-9.9-2.65-2.65-6.17-4.11-9.91-4.11v-.06zm0 25.59c-2.11 0-4.17-.57-5.99-1.65l-.43-.25-4.44 1.16 1.18-4.33-.28-.44c-1.19-1.89-1.81-4.07-1.81-6.31 0-6.43 5.23-11.66 11.67-11.66 3.12 0 6.05 1.21 8.25 3.42 2.21 2.21 3.42 5.14 3.42 8.25 0 6.43-5.23 11.66-11.57 11.82v-.01zm6.39-8.73c-.35-.18-2.07-1.02-2.39-1.14-.32-.12-.55-.18-.79.18-.23.35-.91 1.14-1.11 1.38-.2.23-.41.26-.76.09-.35-.18-1.48-.55-2.82-1.74-1.04-.93-1.75-2.08-1.95-2.43-.2-.35-.02-.54.15-.71.16-.16.35-.41.53-.61.18-.2.23-.35.35-.59.12-.23.06-.44-.03-.61-.09-.18-.79-1.91-1.09-2.62-.29-.69-.58-.6-.79-.61h-.67c-.23 0-.61.09-.93.44-.32.35-1.23 1.2-1.23 2.93 0 1.73 1.26 3.4 1.44 3.63.18.23 2.48 3.79 6.01 5.31.84.36 1.5.58 2.01.74.84.27 1.61.23 2.22.14.68-.1 2.07-.85 2.36-1.66.29-.82.29-1.52.2-1.66-.08-.14-.32-.23-.67-.41z"/>
    </svg>
    <div class="wa-tooltip">
      <span class="online-indicator"></span>
      <div>
        <strong>Engineer Online</strong>
        <p>Instant Quote on WhatsApp</p>
      </div>
    </div>
  </a>
</div>

<style>
  .wa-float-container {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 9999;
  }

  .wa-float-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    background: #25d366;
    color: #fff;
    border-radius: 50%;
    box-shadow: 0 6px 25px rgba(37, 211, 102, 0.45);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .wa-float-btn:hover {
    transform: scale(1.08);
    box-shadow: 0 8px 30px rgba(37, 211, 102, 0.6);
  }

  .wa-icon {
    width: 34px;
    height: 34px;
  }

  .wa-tooltip {
    position: absolute;
    right: calc(100% + 14px);
    background: #111827;
    border: 1px solid var(--border-subtle);
    padding: 0.6rem 0.9rem;
    border-radius: var(--radius-sm);
    color: #fff;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
    opacity: 0.95;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .wa-tooltip strong {
    font-size: 0.85rem;
    display: block;
    font-family: var(--font-heading);
    color: #fff;
  }

  .wa-tooltip p {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin: 0;
  }

  .online-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #25d366;
    box-shadow: 0 0 8px #25d366;
  }

  @media (max-width: 600px) {
    .wa-tooltip {
      display: none;
    }
  }
</style>
