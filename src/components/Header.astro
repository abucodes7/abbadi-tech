---
import Icon from './Icon.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const navItems = [
  { href: '/about', label: 'About' },
  { href: '/services/electrical-contractors-dubai', label: 'Electrical' },
  { href: '/services/plumbing-contractors-dubai', label: 'Plumbing' },
  { href: '/dewa-approvals-dubai', label: 'DEWA Approvals' },
  { href: '/projects', label: 'Projects' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/blog', label: 'Insights' },
];

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(href);
---

<header class="site-header">
  <div class="utility-bar">
    <div class="container utility-inner">
      <p class="utility-location">
        <Icon name="MapPin" size={12} />
        Dubai &nbsp;·&nbsp; Abu Dhabi &nbsp;·&nbsp; Ajman
      </p>
      <div class="utility-links">
        <span class="utility-note">Licensed technical contracting since 2005</span>
        <a href="tel:+971505546943" class="utility-link">
          <Icon name="Phone" size={12} /> +971 50 554 6943
        </a>
        <a href="mailto:info@abbaditech.com" class="utility-link u-desktop">
          <Icon name="Mail" size={12} /> info@abbaditech.com
        </a>
      </div>
    </div>
  </div>

  <div class="main-bar">
    <div class="container header-inner">
      <a href="/" class="brand" aria-label="Abbadi Tech Technical Solutions LLC — Home">
        <span class="brand-mark">
          <img src="/images/logo/logo-icon.png" alt="" width="34" height="34" />
        </span>
        <span class="brand-copy">
          <span class="brand-name">Abbadi Tech</span>
          <span class="brand-sub">Technical Solutions L.L.C</span>
        </span>
      </a>

      <nav class="desktop-nav" aria-label="Primary">
        {navItems.map((item) => (
          <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
            {item.label}
          </a>
        ))}
        <a href="/contact" class="nav-link contact-link">Contact</a>
      </nav>

      <div class="header-actions">
        <a href="tel:+971505546943" class="header-phone" aria-label="Call Abbadi Tech">
          <Icon name="Phone" size={15} />
        </a>
        <a href="/contact" class="btn btn-primary btn-sm header-cta">
          Request a Quote
          <Icon name="ArrowUpRight" size={15} />
        </a>
        <button
          id="mobile-menu-btn"
          class="menu-toggle"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobile-drawer"
        >
          <span></span><span></span>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-overlay" class="mobile-overlay" aria-hidden="true"></div>

  <aside id="mobile-drawer" class="mobile-drawer" aria-hidden="true">
    <div class="drawer-head">
      <span class="drawer-label">Navigation</span>
      <button id="mobile-close-btn" class="drawer-close" aria-label="Close navigation menu">
        <Icon name="X" size={20} />
      </button>
    </div>

    <nav class="mobile-nav" aria-label="Mobile">
      <a href="/" class:list={['mobile-link', { active: currentPath === '/' }]}>
        <span>Home</span><Icon name="ArrowUpRight" size={16} />
      </a>
      {navItems.map((item) => (
        <a href={item.href} class:list={['mobile-link', { active: isActive(item.href) }]}>
          <span>{item.label}</span><Icon name="ArrowUpRight" size={16} />
        </a>
      ))}
      <a href="/areas-we-serve" class:list={['mobile-link', { active: currentPath === '/areas-we-serve' }]}>
        <span>Areas We Serve</span><Icon name="ArrowUpRight" size={16} />
      </a>
      <a href="/resources" class:list={['mobile-link', { active: currentPath === '/resources' }]}>
        <span>Resources</span><Icon name="ArrowUpRight" size={16} />
      </a>
      <a href="/contact" class:list={['mobile-link', { active: currentPath === '/contact' }]}>
        <span>Contact</span><Icon name="ArrowUpRight" size={16} />
      </a>
    </nav>

    <div class="drawer-contact">
      <p class="drawer-contact-label">Speak with an engineer</p>
      <a href="tel:+971505546943" class="btn btn-primary">
        <Icon name="Phone" size={15} /> +971 50 554 6943
      </a>
      <a
        href="https://wa.me/971505546943?text=Hello%20Abbadi%20Tech,%20I%20would%20like%20to%20discuss%20a%20project"
        target="_blank"
        rel="noopener"
        class="btn btn-outline-white"
      >
        <Icon name="MessageSquare" size={15} /> WhatsApp the team
      </a>
    </div>
  </aside>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(13, 26, 33, 0.97);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    transition: background 0.3s var(--ease-soft), box-shadow 0.3s var(--ease-soft), border-color 0.3s var(--ease-soft);
  }

  .site-header.header-scrolled {
    background: rgba(8, 18, 23, 0.96);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 20px 40px -30px rgba(0, 0, 0, 0.7);
  }

  .utility-bar {
    background: var(--ink-deep);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .utility-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 34px;
  }

  .utility-location,
  .utility-link,
  .utility-note {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-heading);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }

  .utility-location { color: rgba(255, 255, 255, 0.62); }

  .utility-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .utility-link {
    color: rgba(255, 255, 255, 0.7);
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: 0.72rem;
  }

  .utility-link:hover { color: var(--brass-soft); }
  .utility-note { color: rgba(255, 255, 255, 0.36); font-size: 0.62rem; }

  .main-bar { padding: 0.65rem 0; }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    flex-shrink: 0;
  }

  .brand-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: border-color 0.25s var(--ease-soft), background 0.25s var(--ease-soft);
  }

  .brand-mark img { width: 30px; height: 30px; object-fit: contain; }
  .brand:hover .brand-mark { border-color: var(--brass); background: rgba(180, 134, 76, 0.12); }

  .brand-copy { display: flex; flex-direction: column; line-height: 1; }

  .brand-name {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--white);
  }

  .brand-sub {
    margin-top: 0.35rem;
    font-family: var(--font-heading);
    font-size: 0.5rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1.55rem;
    margin-left: auto;
    margin-right: 0.5rem;
  }

  .nav-link {
    position: relative;
    font-family: var(--font-heading);
    font-size: 0.79rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: rgba(255, 255, 255, 0.68);
    padding: 0.35rem 0;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1px;
    background: var(--brass-soft);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s var(--ease-out);
  }

  .nav-link:hover,
  .nav-link.active { color: var(--white); }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .contact-link { color: rgba(255, 255, 255, 0.55); }

  .header-actions { display: flex; align-items: center; gap: 0.8rem; }

  .header-phone {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: rgba(255, 255, 255, 0.8);
  }

  .header-phone:hover { border-color: var(--brass); color: var(--brass-soft); }

  .header-cta { border-radius: 10px; }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
    gap: 6px;
    width: 42px;
    height: 42px;
    padding: 0 10px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 10px;
    cursor: pointer;
  }

  .menu-toggle span {
    display: block;
    width: 18px;
    height: 1.5px;
    background: var(--white);
    border-radius: 2px;
    transition: transform 0.3s var(--ease-out), width 0.3s var(--ease-out), opacity 0.3s;
  }

  .menu-toggle span:last-child { width: 12px; }
  .menu-toggle.active span:first-child { transform: translateY(3.75px) rotate(45deg); width: 18px; }
  .menu-toggle.active span:last-child { transform: translateY(-3.75px) rotate(-45deg); width: 18px; }

  /* Drawer --------------------------------------------------------------- */
  .mobile-overlay {
    position: fixed;
    inset: 0;
    background: rgba(8, 18, 23, 0.6);
    backdrop-filter: blur(4px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s var(--ease-soft), visibility 0.3s;
    z-index: 9998;
  }

  .mobile-overlay.open { opacity: 1; visibility: visible; }

  .mobile-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: min(380px, 92vw);
    height: 100dvh;
    background: var(--ink-deep);
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    z-index: 9999;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    overflow-y: auto;
    transform: translateX(102%);
    transition: transform 0.4s var(--ease-out);
  }

  .mobile-drawer.open { transform: translateX(0); }

  .drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .drawer-label {
    font-family: var(--font-heading);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
  }

  .drawer-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: transparent;
    color: var(--white);
    cursor: pointer;
  }

  .drawer-close:hover { border-color: var(--brass); color: var(--brass-soft); }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    padding: 0.75rem 0;
    flex: 1;
  }

  .mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0.25rem;
    font-family: var(--font-heading);
    font-size: 1.02rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.72);
    border-bottom: 1px solid rgba(255, 255, 255, 0.055);
    transition: color 0.2s, padding 0.25s var(--ease-out);
  }

  .mobile-link svg { color: rgba(255, 255, 255, 0.3); }
  .mobile-link:hover, .mobile-link.active { color: var(--white); padding-left: 0.5rem; }
  .mobile-link.active svg, .mobile-link:hover svg { color: var(--brass-soft); }

  .drawer-contact {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .drawer-contact-label {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 0.15rem;
  }

  @media (max-width: 1120px) {
    .desktop-nav { gap: 1.1rem; }
    .nav-link { font-size: 0.75rem; }
    .header-phone { display: none; }
  }

  @media (max-width: 1024px) {
    .desktop-nav { display: none; }
    .menu-toggle { display: flex; }
    .utility-note, .u-desktop { display: none; }
  }

  @media (max-width: 560px) {
    .brand-sub { display: none; }
    .brand-name { font-size: 1.05rem; }
    .header-cta { display: none; }
    .utility-location { font-size: 0.6rem; }
    .utility-link { font-size: 0.66rem; }
  }
</style>
