---
import Icon from './Icon.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const serviceLinks = [
  { href: '/services/electrical-contractors-dubai', label: 'Electrical Contractors', icon: 'Zap', desc: 'DEWA Works, MDB/SMDB Panels, Metering' },
  { href: '/services/plumbing-contractors-dubai', label: 'Plumbing & Drainage', icon: 'Droplets', desc: 'PPR, Copper, HDPE & Booster Pumps' },
];

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services', hasDropdown: true },
  { href: '/gallery', label: 'Work Photos', badge: '16+ Photos' },
  { href: '/projects', label: 'Projects (1000+)' },
  { href: '/areas-we-serve', label: 'Areas Served' },
  { href: '/resources', label: 'Resources' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="site-header">
  <!-- Top Announcement Bar -->
  <div class="top-bar">
    <div class="container top-bar-inner">
      <div class="badges-group">
        <span class="live-status-pill"><span class="pulse-dot"></span> DEWA Dispatch: Active Now</span>
        <span class="badge badge-gold"><Icon name="Zap" size={13} /> Registered DEWA Contractor</span>
        <span class="badge badge-green"><Icon name="CheckCircle2" size={13} /> 21+ Years in Dubai</span>
      </div>
      <div class="top-contact">
        <a href="tel:+971505546943" class="phone-link"><Icon name="Phone" size={13} /> +971 50 554 6943</a>
        <span class="divider">•</span>
        <a href="mailto:it.abbaditech@gmail.com" class="phone-link"><Icon name="Mail" size={13} /> it.abbaditech@gmail.com</a>
        <span class="divider">•</span>
        <a href="https://wa.me/971505546943?text=Hello%20Abbadi%20Tech,%20I%20have%20an%20inquiry%20regarding%20contracting%20work" target="_blank" rel="noopener" class="wa-quick"><Icon name="MessageSquare" size={13} /> WhatsApp</a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Header -->
  <div class="main-header">
    <div class="container header-container">
      <a href="/" class="brand-logo" aria-label="Abbadi Tech LLC Home">
        <div class="logo-text">ABBADI<span>TECH</span></div>
        <div class="logo-sub">ELECTRICAL & MECHANICAL CONT. CO. L.L.C</div>
      </a>

      <!-- Desktop Nav -->
      <nav class="desktop-nav" aria-label="Main Navigation">
        {navItems.map((item) => (
          item.hasDropdown ? (
            <div class="nav-dropdown-wrapper">
              <a 
                href={item.href} 
                class:list={['nav-link', 'dropdown-trigger', { active: currentPath.startsWith('/services') }]}
              >
                {item.label} <span class="arrow">▾</span>
              </a>
              <div class="dropdown-menu">
                <div class="dropdown-header">
                  <a href="/services" class="dropdown-all-link">All MEP Contracting Services →</a>
                </div>
                {serviceLinks.map((s) => (
                  <a href={s.href} class="dropdown-item">
                    <span class="item-title">
                      <Icon name={s.icon} size={15} class="service-menu-icon" />
                      {s.label}
                    </span>
                    <span class="item-desc">{s.desc}</span>
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a 
              href={item.href} 
              class:list={['nav-link', { active: currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) }]}
            >
              <span>{item.label}</span>
              {item.badge && (
                <span class="nav-badge-pill">
                  <span class="badge-dot"></span>
                  {item.badge}
                </span>
              )}
            </a>
          )
        ))}
      </nav>

      <!-- Action buttons -->
      <div class="header-actions">
        <a href="/contact" class="btn btn-primary btn-sm">
          <span>Get Free Quote</span>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button id="mobile-menu-btn" class="menu-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
          <span class="bar"></span>
          <span class="bar"></span>
          <span class="bar"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-drawer" class="mobile-drawer">
    <nav class="mobile-nav">
      <a href="/" class:list={['mobile-nav-link', { active: currentPath === '/' }]}>Home</a>
      <a href="/about" class:list={['mobile-nav-link', { active: currentPath === '/about' }]}>About Abbadi Tech</a>
      
      <div class="mobile-section-label">Our MEP Services</div>
      <div class="mobile-sub-services">
        {serviceLinks.map((s) => (
          <a href={s.href} class:list={['mobile-sub-link', { active: currentPath === s.href }]}>
            <Icon name={s.icon} size={14} />
            <span>{s.label}</span>
          </a>
        ))}
      </div>

      <a href="/gallery" class:list={['mobile-nav-link', { active: currentPath === '/gallery' }]}>
        Work Photos <span class="nav-badge-pill">16+ Verified</span>
      </a>
      <a href="/projects" class:list={['mobile-nav-link', { active: currentPath === '/projects' }]}>Projects (1000+ Completed)</a>
      <a href="/areas-we-serve" class:list={['mobile-nav-link', { active: currentPath === '/areas-we-serve' }]}>Areas We Serve</a>
      <a href="/resources" class:list={['mobile-nav-link', { active: currentPath === '/resources' }]}>Guides & Resources</a>
      <a href="/contact" class:list={['mobile-nav-link', { active: currentPath === '/contact' }]}>Contact Us</a>

      <div class="mobile-drawer-contact">
        <p>Direct Engineering Dispatch:</p>
        <a href="tel:+971505546943" class="btn btn-primary" style="width:100%; margin-bottom:0.8rem">
          <Icon name="PhoneCall" size={16} /> Call +971 50 554 6943
        </a>
        <a href="mailto:it.abbaditech@gmail.com" class="btn btn-secondary" style="width:100%; margin-bottom:0.8rem">
          <Icon name="Mail" size={16} /> it.abbaditech@gmail.com
        </a>
        <a href="https://wa.me/971505546943?text=Hi%20Abbadi%20Tech,%20I%20need%20a%20quote" class="btn btn-plumbing" style="width:100%">
          <Icon name="MessageSquare" size={16} /> Instant WhatsApp Chat
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(15, 20, 29, 0.94);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border-subtle);
    transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .site-header.header-scrolled {
    background: rgba(10, 14, 23, 0.98);
    border-bottom: 1px solid rgba(255, 149, 0, 0.35);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6);
  }

  .site-header.header-scrolled .main-header {
    padding: 0.6rem 0;
  }

  .nav-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.65rem;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
    background: rgba(16, 185, 129, 0.18);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.45);
    font-weight: 700;
    letter-spacing: 0.02em;
    margin-left: 0.25rem;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 6px #10b981;
    display: inline-block;
  }

  .top-bar {
    background: #090d15;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding: 0.35rem 0;
    font-size: 0.78rem;
  }

  .top-bar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .badges-group {
    display: flex;
    gap: 0.5rem;
  }

  .top-contact {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-muted);
  }

  .phone-link, .wa-quick {
    color: var(--text-main);
    font-weight: 600;
  }

  .phone-link:hover, .wa-quick:hover {
    color: var(--primary);
  }

  .divider {
    color: var(--text-dim);
  }

  .main-header {
    padding: 0.85rem 0;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand-logo {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }

  .logo-text {
    font-family: var(--font-heading);
    font-size: 1.65rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #fff;
    line-height: 1;
  }

  .logo-text span {
    color: var(--primary);
  }

  .logo-sub {
    font-family: var(--font-heading);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    margin-top: 0.2rem;
    font-weight: 600;
  }

  .desktop-nav {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  .nav-link {
    font-family: var(--font-heading);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-muted);
    padding: 0.4rem 0;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link:hover, .nav-link.active {
    color: #fff;
  }

  .nav-link.active::after, .nav-link:hover::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--primary);
  }

  /* Dropdown styling */
  .nav-dropdown-wrapper {
    position: relative;
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: -20px;
    width: 320px;
    background: #111724;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 0.75rem;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6);
    display: none;
    flex-direction: column;
    gap: 0.25rem;
    z-index: 1001;
  }

  .nav-dropdown-wrapper:hover .dropdown-menu {
    display: flex;
  }

  .dropdown-header {
    padding-bottom: 0.4rem;
    margin-bottom: 0.4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .dropdown-all-link {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .dropdown-item {
    display: flex;
    flex-direction: column;
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius-sm);
    transition: background 0.15s ease;
  }

  .dropdown-item:hover {
    background: rgba(255, 149, 0, 0.12);
  }

  .item-title {
    color: #fff;
    font-size: 0.88rem;
    font-weight: 600;
    font-family: var(--font-heading);
  }

  .item-desc {
    color: var(--text-dim);
    font-size: 0.74rem;
    line-height: 1.25;
    margin-top: 0.15rem;
  }

  .btn-sm {
    padding: 0.55rem 1.1rem;
    font-size: 0.82rem;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.4rem;
  }

  .menu-toggle .bar {
    width: 24px;
    height: 2px;
    background: #fff;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .mobile-drawer {
    display: none;
    background: #0d131f;
    border-top: 1px solid var(--border-subtle);
    padding: 1.5rem;
    max-height: 80vh;
    overflow-y: auto;
  }

  .mobile-drawer.open {
    display: block;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .mobile-nav-link {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 600;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    color: var(--text-main);
  }

  .mobile-nav-link.active {
    color: var(--primary);
  }

  .mobile-section-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    margin-top: 0.5rem;
    margin-bottom: 0.2rem;
  }

  .mobile-sub-services {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-left: 0.75rem;
    border-left: 2px solid rgba(255, 149, 0, 0.3);
    margin-bottom: 0.5rem;
  }

  .mobile-sub-link {
    font-size: 0.9rem;
    color: var(--text-muted);
    padding: 0.25rem 0;
  }

  .mobile-sub-link:hover, .mobile-sub-link.active {
    color: var(--primary);
  }

  .mobile-drawer-contact {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
  }

  .mobile-drawer-contact p {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 0.8rem;
  }

  @media (max-width: 1250px) {
    .desktop-nav {
      gap: 0.85rem;
    }
    .nav-link {
      font-size: 0.84rem;
    }
    .nav-badge-pill {
      font-size: 0.6rem;
      padding: 0.1rem 0.38rem;
    }
  }

  @media (max-width: 1024px) {
    .desktop-nav {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }

    .badges-group {
      display: none;
    }

    .top-bar-inner {
      justify-content: center;
    }
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-drawer');

  if (btn && drawer) {
    btn.addEventListener('click', () => {
      const isOpen = drawer.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(isOpen));
    });
  }
</script>
