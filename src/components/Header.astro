---
import Icon from './Icon.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About Us' },
  { href: '/services/electrical-contractors-dubai', label: 'Electrical Services', badge: 'Electrical' },
  { href: '/services/plumbing-contractors-dubai', label: 'Plumbing Services', badge: 'Plumbing' },
  { href: '/dewa-approvals-dubai', label: 'DEWA Approvals' },
  { href: '/projects', label: 'Projects' },
  { href: '/gallery', label: 'Work Photos' },
  { href: '/blog', label: 'Blog & Guides' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="site-header">
  <!-- Top Utility Bar: Trust & Direct Communications -->
  <div class="top-bar">
    <div class="container top-bar-inner">
      <div class="badges-group">
        <span class="live-status-pill"><span class="pulse-dot"></span> DEWA Registered</span>
        <span class="top-meta-item"><Icon name="Landmark" size={12} /> Trade Lic. 571822</span>
        <span class="top-meta-item desktop-only"><Icon name="CheckCircle2" size={12} /> 21+ Years UAE Experience</span>
      </div>
      <div class="top-contact">
        <a href="tel:+971505546943" class="phone-link"><Icon name="Phone" size={12} /> +971 50 554 6943</a>
        <span class="divider desktop-only">•</span>
        <a href="mailto:it.abbaditech@gmail.com" class="phone-link desktop-only"><Icon name="Mail" size={12} /> it.abbaditech@gmail.com</a>
        <span class="divider">•</span>
        <a href="https://wa.me/971505546943?text=Hello%20Abbadi%20Tech,%20I%20have%20an%20inquiry%20regarding%20contracting%20work" target="_blank" rel="noopener" class="wa-quick"><Icon name="MessageSquare" size={12} /> WhatsApp</a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Header -->
  <div class="main-header">
    <div class="container header-container">
      <!-- Logo -->
      <a href="/" class="brand-logo" aria-label="Abbadi Tech Technical Solutions LLC Home">
        <img 
          src="/images/logo/logo-icon.png" 
          alt="Abbadi Tech Official Emblem" 
          width="40" 
          height="40" 
          class="brand-emblem-img" 
        />
        <div class="brand-text-block">
          <div class="logo-text"><span class="logo-abbadi">ABBADI</span><span class="logo-tech">TECH</span></div>
          <div class="logo-sub">TECHNICAL SOLUTIONS L.L.C</div>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="desktop-nav" aria-label="Main Navigation">
        {navItems.map((item) => (
          <a 
            href={item.href} 
            class:list={['nav-link', { active: currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) }]}
          >
            <span>{item.label}</span>
            {item.badge === 'Electrical' && (
              <span class="nav-tag nav-tag-electrical"></span>
            )}
            {item.badge === 'Plumbing' && (
              <span class="nav-tag nav-tag-plumbing"></span>
            )}
          </a>
        ))}
      </nav>

      <!-- Action buttons -->
      <div class="header-actions">
        <a href="/contact" class="btn btn-primary btn-sm">
          <span>Request a Quote</span>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button id="mobile-menu-btn" class="menu-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
          <span class="bar"></span>
          <span class="bar"></span>
          <span class="bar"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-drawer" class="mobile-drawer">
    <div class="mobile-drawer-brand">
      <img src="/images/logo/logo-dark.png" alt="Abbadi Tech Technical Solutions LLC" width="150" class="drawer-logo" />
    </div>
    <nav class="mobile-nav">
      <a href="/" class:list={['mobile-nav-link', { active: currentPath === '/' }]}>Home</a>
      <a href="/about" class:list={['mobile-nav-link', { active: currentPath === '/about' }]}>About Us</a>
      
      <div class="mobile-section-label">Core Technical Services</div>
      <a href="/services/electrical-contractors-dubai" class:list={['mobile-sub-link', { active: currentPath === '/services/electrical-contractors-dubai' }]}>
        <Icon name="Zap" size={15} />
        <span>Electrical Services (DEWA &amp; Panels)</span>
      </a>
      <a href="/services/plumbing-contractors-dubai" class:list={['mobile-sub-link', { active: currentPath === '/services/plumbing-contractors-dubai' }]}>
        <Icon name="Droplets" size={15} />
        <span>Plumbing Services (Piping &amp; Pumps)</span>
      </a>
      <a href="/dewa-approvals-dubai" class:list={['mobile-sub-link', { active: currentPath === '/dewa-approvals-dubai' }]}>
        <Icon name="CheckCircle2" size={15} />
        <span>DEWA Approvals Dubai Division</span>
      </a>

      <div class="mobile-section-label">Company &amp; Work</div>
      <a href="/projects" class:list={['mobile-nav-link', { active: currentPath === '/projects' }]}>Projects Directory (1,000+)</a>
      <a href="/gallery" class:list={['mobile-nav-link', { active: currentPath === '/gallery' }]}>Work Photos Gallery (16+ Real Photos)</a>
      <a href="/blog" class:list={['mobile-nav-link', { active: currentPath === '/blog' || currentPath.startsWith('/blog/') }]}>Engineering Blog &amp; DEWA Guides</a>
      <a href="/areas-we-serve" class:list={['mobile-nav-link', { active: currentPath === '/areas-we-serve' }]}>Areas We Serve</a>
      <a href="/resources" class:list={['mobile-nav-link', { active: currentPath === '/resources' }]}>Guides &amp; Compliance Resources</a>
      <a href="/contact" class:list={['mobile-nav-link', { active: currentPath === '/contact' }]}>Contact Us</a>

      <div class="mobile-drawer-contact">
        <p class="mobile-contact-title">Direct Engineering Dispatch:</p>
        <a href="tel:+971505546943" class="btn btn-primary" style="width:100%; margin-bottom:0.75rem">
          <Icon name="PhoneCall" size={15} /> Call +971 50 554 6943
        </a>
        <a href="https://wa.me/971505546943?text=Hi%20Abbadi%20Tech,%20I%20need%20a%20quote" target="_blank" rel="noopener" class="btn btn-teal" style="width:100%; margin-bottom:0.75rem">
          <Icon name="MessageSquare" size={15} /> WhatsApp Dispatch
        </a>
        <a href="mailto:it.abbaditech@gmail.com" class="btn btn-secondary" style="width:100%">
          <Icon name="Mail" size={15} /> it.abbaditech@gmail.com
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-drawer');

  if (menuBtn && drawer) {
    menuBtn.addEventListener('click', () => {
      const isOpen = drawer.classList.toggle('open');
      menuBtn.setAttribute('aria-expanded', String(isOpen));
      menuBtn.classList.toggle('active', isOpen);
    });

    // Close drawer when clicking a link inside
    drawer.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        drawer.classList.remove('open');
        menuBtn.setAttribute('aria-expanded', 'false');
        menuBtn.classList.remove('active');
      });
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: #0B1F33;
    border-bottom: 1px solid var(--color-navy-border);
    transition: background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .site-header.header-scrolled {
    background: #071524;
    border-bottom: 1px solid #1E3A59;
    box-shadow: 0 4px 20px rgba(7, 21, 36, 0.5);
  }

  /* Top Utility Bar */
  .top-bar {
    background: #071524;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding: 0.4rem 0;
    font-size: 0.78rem;
  }

  .top-bar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .badges-group {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .top-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #94A3B8;
    font-size: 0.78rem;
    font-weight: 500;
  }

  .top-contact {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: #94A3B8;
  }

  .phone-link, .wa-quick {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #E2E8F0;
    font-weight: 600;
  }

  .phone-link:hover {
    color: var(--color-amber);
  }

  .wa-quick {
    color: var(--color-teal-light);
  }

  .wa-quick:hover {
    color: #FFFFFF;
  }

  .divider {
    color: #475569;
  }

  /* Main Navigation Header */
  .main-header {
    padding: 0.85rem 0;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-emblem-img {
    width: 38px;
    height: 38px;
    object-fit: contain;
    transition: transform 0.25s ease;
  }

  .brand-logo:hover .brand-emblem-img {
    transform: scale(1.05);
  }

  .brand-text-block {
    display: flex;
    flex-direction: column;
  }

  .logo-text {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1;
    display: flex;
    align-items: baseline;
    gap: 0.15rem;
  }

  .logo-abbadi {
    color: #FFFFFF;
  }

  .logo-tech {
    color: var(--color-teal);
    font-weight: 900;
  }

  .logo-sub {
    font-family: var(--font-heading);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    color: #94A3B8;
    margin-top: 0.25rem;
    font-weight: 700;
  }

  .desktop-nav {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  .nav-link {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 600;
    color: #CBD5E1;
    padding: 0.4rem 0;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .nav-link:hover, .nav-link.active {
    color: #FFFFFF;
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--color-amber);
    border-radius: 1px;
  }

  .nav-tag {
    width: 5px;
    height: 5px;
    border-radius: 50%;
  }

  .nav-tag-electrical {
    background-color: var(--color-amber);
  }

  .nav-tag-plumbing {
    background-color: var(--color-teal);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.4rem;
  }

  .menu-toggle .bar {
    width: 22px;
    height: 2px;
    background: #FFFFFF;
    transition: transform 0.25s ease, opacity 0.25s ease;
    border-radius: 2px;
  }

  .menu-toggle.active .bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .menu-toggle.active .bar:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle.active .bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile Drawer Menu */
  .mobile-drawer {
    display: none;
    position: fixed;
    top: 0;
    right: 0;
    width: 320px;
    height: 100vh;
    background: #0B1F33;
    border-left: 1px solid var(--color-navy-border);
    box-shadow: -10px 0 30px rgba(0, 0, 0, 0.6);
    z-index: 10000;
    overflow-y: auto;
    padding: 1.5rem;
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-drawer.open {
    transform: translateX(0);
  }

  .mobile-drawer-brand {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-navy-border);
    margin-bottom: 1.25rem;
    display: flex;
    justify-content: center;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .mobile-nav-link {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
    color: #E2E8F0;
    padding: 0.6rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .mobile-nav-link:hover, .mobile-nav-link.active {
    background: rgba(255, 255, 255, 0.05);
    color: var(--color-amber);
  }

  .mobile-section-label {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #64748B;
    margin-top: 1rem;
    margin-bottom: 0.3rem;
    padding-left: 0.5rem;
  }

  .mobile-sub-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.5rem;
    font-size: 0.9rem;
    color: #CBD5E1;
    border-radius: var(--radius-sm);
  }

  .mobile-sub-link:hover, .mobile-sub-link.active {
    background: rgba(255, 255, 255, 0.05);
    color: #FFFFFF;
  }

  .mobile-drawer-contact {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-navy-border);
  }

  .mobile-contact-title {
    font-size: 0.8rem;
    color: #94A3B8;
    margin-bottom: 0.75rem;
    font-weight: 500;
  }

  @media (max-width: 1024px) {
    .desktop-nav {
      display: none;
    }

    .desktop-only {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }

    .mobile-drawer {
      display: block;
    }
  }

  @media (max-width: 600px) {
    .logo-sub {
      font-size: 0.52rem;
      letter-spacing: 0.08em;
    }

    .logo-text {
      font-size: 1.35rem;
    }

    .header-actions .btn-sm {
      display: none;
    }
  }
</style>
