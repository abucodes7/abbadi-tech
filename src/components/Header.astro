---
import Icon from './Icon.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(href);

const isArabic = currentPath.startsWith('/ar');
---

<header class="site-header">
  <div class="utility-bar">
    <div class="container utility-inner">
      <p class="utility-location">
        <Icon name="MapPin" size={12} />
        Dubai &nbsp;·&nbsp; Abu Dhabi &nbsp;·&nbsp; Ajman
      </p>
      <div class="utility-links">
        <span class="utility-note">Licensed technical contracting since 2005</span>
        <a href="tel:+971505546943" class="utility-link">
          <Icon name="Phone" size={12} /> +971 50 554 6943
        </a>
        <a href="mailto:info@abbaditech.com" class="utility-link u-desktop">
          <Icon name="Mail" size={12} /> info@abbaditech.com
        </a>
        <a href={isArabic ? '/' : '/ar'} class="utility-link lang-switch" aria-label={isArabic ? 'Switch to English' : 'التحويل إلى اللغة العربية'}>
          <Icon name="Globe" size={12} />
          <span>{isArabic ? 'English' : 'العربية'}</span>
        </a>
      </div>
    </div>
  </div>

  <div class="main-bar">
    <div class="container header-inner">
      <a href={isArabic ? '/ar' : '/'} class="brand" aria-label="Abbadi Tech Technical Solutions LLC — Home">
        <span class="brand-mark">
          <img src="/images/logo/logo-icon.png" alt="" width="34" height="34" />
        </span>
        <span class="brand-copy">
          <span class="brand-name">Abbadi Tech</span>
          <span class="brand-sub">Technical Solutions L.L.C</span>
        </span>
      </a>

      <nav class="desktop-nav" aria-label="Primary">
        <!-- DEWA APPROVALS DROPDOWN -->
        <div class="nav-item-dropdown">
          <a href="/dewa-approvals-dubai" class:list={['nav-link', 'dropdown-trigger', { active: isActive('/dewa-approvals-dubai') }]}>
            DEWA Approvals <Icon name="ChevronDown" size={13} />
          </a>
          <div class="dropdown-menu">
            <a href="/dewa-approvals-dubai" class="dropdown-item dropdown-item-bold">
              <span>All DEWA Services</span>
              <Icon name="ArrowUpRight" size={12} />
            </a>
            <a href="/dewa-approvals-dubai/fit-out-approval-noc" class="dropdown-item">Fit-Out Approval NOC</a>
            <a href="/dewa-approvals-dubai/additional-load-upgrade" class="dropdown-item">Additional Load Upgrade</a>
            <a href="/dewa-approvals-dubai/single-line-diagram-load-schedule" class="dropdown-item">Stamped SLD &amp; Load Schedules</a>
            <a href="/dewa-approvals-dubai/lv-inspection-meter-connection" class="dropdown-item">LV Inspection &amp; Meter Connection</a>
            <a href="/dewa-approvals-dubai/red-notice-inspection-rectification" class="dropdown-item">Red Notice Rectification</a>
            <a href="/dewa-approvals-dubai/temporary-construction-power" class="dropdown-item">Temporary Construction Power</a>
            <a href="/dewa-approvals-dubai/shams-dubai-solar-approval" class="dropdown-item">Shams Dubai Solar Approvals</a>
          </div>
        </div>

        <!-- SERVICES DROPDOWN -->
        <div class="nav-item-dropdown">
          <a href="/services" class:list={['nav-link', 'dropdown-trigger', { active: isActive('/services') }]}>
            Services <Icon name="ChevronDown" size={13} />
          </a>
          <div class="dropdown-menu">
            <a href="/services" class="dropdown-item dropdown-item-bold">
              <span>Services Hub</span>
              <Icon name="ArrowUpRight" size={12} />
            </a>
            <a href="/services/electrical-contractors-dubai" class="dropdown-item">Electrical Contracting Hub</a>
            <a href="/services/plumbing-contractors-dubai" class="dropdown-item">Commercial Plumbing Hub</a>
            <a href="/services/mep-contractor-dubai" class="dropdown-item">Turnkey MEP Contracting</a>
            <a href="/services/mdb-smdb-panel-assembly-dubai" class="dropdown-item">MDB &amp; SMDB Panel Assembly</a>
            <a href="/services/grease-trap-installation-dubai" class="dropdown-item">Commercial Grease Traps</a>
            <a href="/services/water-booster-pump-installation-dubai" class="dropdown-item">Water Booster Pumps</a>
            <a href="/services/ev-charger-installation-dubai" class="dropdown-item">EV Charger Installation</a>
            <a href="/services/electrical-maintenance-amc-dubai" class="dropdown-item">Preventive Maintenance AMC</a>
          </div>
        </div>

        <!-- SECTORS & AREAS DROPDOWN -->
        <div class="nav-item-dropdown">
          <a href="/areas-we-serve" class:list={['nav-link', 'dropdown-trigger', { active: isActive('/areas-we-serve') || isActive('/industries') || isActive('/areas') }]}>
            Sectors &amp; Areas <Icon name="ChevronDown" size={13} />
          </a>
          <div class="dropdown-menu">
            <div class="dropdown-group-title">Commercial Sectors</div>
            <a href="/industries/restaurant-cafe-mep" class="dropdown-item">Restaurants &amp; Cafes</a>
            <a href="/industries/clinic-healthcare-mep" class="dropdown-item">Clinics &amp; Healthcare</a>
            <a href="/industries/retail-showroom-mep" class="dropdown-item">Retail &amp; Showrooms</a>
            <a href="/industries/warehouse-industrial-mep" class="dropdown-item">Warehouses &amp; Industrial</a>
            <div class="dropdown-group-title" style="margin-top: 0.5rem;">Dubai Districts</div>
            <a href="/areas-we-serve" class="dropdown-item dropdown-item-bold">
              <span>All 22 Dubai Areas</span>
              <Icon name="ArrowUpRight" size={12} />
            </a>
            <a href="/areas/business-bay" class="dropdown-item">Business Bay</a>
            <a href="/areas/downtown-dubai" class="dropdown-item">Downtown Dubai</a>
            <a href="/areas/al-quoz" class="dropdown-item">Al Quoz Industrial</a>
          </div>
        </div>

        <a href="/pricing" class:list={['nav-link', { active: isActive('/pricing') }]}>Pricing</a>
        <a href="/projects" class:list={['nav-link', { active: isActive('/projects') }]}>Projects</a>
        <a href="/gallery" class:list={['nav-link', { active: isActive('/gallery') }]}>Gallery</a>
        <a href="/about" class:list={['nav-link', { active: isActive('/about') }]}>About</a>
        <a href="/blog" class:list={['nav-link', { active: isActive('/blog') }]}>Insights</a>
        <a href="/contact" class="nav-link contact-link">Contact</a>
      </nav>

      <div class="header-actions">
        <a href="tel:+971505546943" class="header-phone" aria-label="Call Abbadi Tech">
          <Icon name="Phone" size={15} />
        </a>
        <a href="/contact" class="btn btn-primary btn-sm header-cta">
          Request a Quote
          <Icon name="ArrowUpRight" size={15} />
        </a>
        <button
          id="mobile-menu-btn"
          class="menu-toggle"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobile-drawer"
        >
          <span></span><span></span>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-overlay" class="mobile-overlay" aria-hidden="true"></div>

  <aside id="mobile-drawer" class="mobile-drawer" aria-hidden="true">
    <div class="drawer-head">
      <span class="drawer-label">Navigation</span>
      <button id="mobile-close-btn" class="drawer-close" aria-label="Close navigation menu">
        <Icon name="X" size={20} />
      </button>
    </div>

    <nav class="mobile-nav" aria-label="Mobile">
      <a href="/" class:list={['mobile-link', { active: currentPath === '/' }]}>
        <span>Home</span><Icon name="ArrowUpRight" size={16} />
      </a>
      <a href="/dewa-approvals-dubai" class:list={['mobile-link', { active: isActive('/dewa-approvals-dubai') }]}>
        <span>DEWA Approvals Hub</span><Icon name="ArrowUpRight" size={16} />
      </a>
      <a href="/services/electrical-contractors-dubai" class:list={['mobile-link', { active: isActive('/services/electrical-contractors-dubai') }]}>
        <span>Electrical Contracting</span><Icon name="ArrowUpRight" size={16} />
      </a>
      <a href="/services/plumbing-contractors-dubai" class:list={['mobile-link', { active: isActive('/services/plumbing-contractors-dubai') }]}>
        <span>Commercial Plumbing</span><Icon name="ArrowUpRight" size={16} />
      </a>
      <a href="/services/mep-contractor-dubai" class:list={['mobile-link', { active: isActive('/services/mep-contractor-dubai') }]}>
        <span>Turnkey MEP Works</span><Icon name="ArrowUpRight" size={16} />
      </a>
      <a href="/areas-we-serve" class:list={['mobile-link', { active: isActive('/areas-we-serve') }]}>
        <span>Areas We Serve</span><Icon name="ArrowUpRight" size={16} />
      </a>
      <a href="/pricing" class:list={['mobile-link', { active: isActive('/pricing') }]}>
        <span>Pricing &amp; Cost Guide</span><Icon name="ArrowUpRight" size={16} />
      </a>
      <a href="/projects" class:list={['mobile-link', { active: isActive('/projects') }]}>
        <span>Project Case Studies</span><Icon name="ArrowUpRight" size={16} />
      </a>
      <a href="/gallery" class:list={['mobile-link', { active: isActive('/gallery') }]}>
        <span>Site Photo Gallery</span><Icon name="ArrowUpRight" size={16} />
      </a>
      <a href="/certifications" class:list={['mobile-link', { active: isActive('/certifications') }]}>
        <span>Compliance &amp; Licences</span><Icon name="ArrowUpRight" size={16} />
      </a>
      <a href="/about" class:list={['mobile-link', { active: isActive('/about') }]}>
        <span>About Abbadi Tech</span><Icon name="ArrowUpRight" size={16} />
      </a>
      <a href="/blog" class:list={['mobile-link', { active: isActive('/blog') }]}>
        <span>Technical Insights</span><Icon name="ArrowUpRight" size={16} />
      </a>
      <a href="/resources" class:list={['mobile-link', { active: isActive('/resources') }]}>
        <span>Engineering Resources</span><Icon name="ArrowUpRight" size={16} />
      </a>
      <a href="/contact" class:list={['mobile-link', { active: isActive('/contact') }]}>
        <span>Contact &amp; RFQ</span><Icon name="ArrowUpRight" size={16} />
      </a>
      <a href={isArabic ? '/' : '/ar'} class="mobile-link" style="color: var(--brass-soft); font-weight: 600;">
        <span>{isArabic ? 'English Version' : 'النسخة العربية (Arabic)'}</span>
        <Icon name="Globe" size={16} />
      </a>
    </nav>

    <div class="drawer-contact">
      <p class="drawer-contact-label">Speak with an engineer</p>
      <a href="tel:+971505546943" class="btn btn-primary">
        <Icon name="Phone" size={15} /> +971 50 554 6943
      </a>
      <a
        href="https://wa.me/971505546943?text=Hello%20Abbadi%20Tech,%20I%20would%20like%20to%20discuss%20a%20project"
        target="_blank"
        rel="noopener"
        class="btn btn-outline-white"
      >
        <Icon name="MessageSquare" size={15} /> WhatsApp the team
      </a>
    </div>
  </aside>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(13, 26, 33, 0.97);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    transition: background 0.3s var(--ease-soft), box-shadow 0.3s var(--ease-soft), border-color 0.3s var(--ease-soft);
  }

  .site-header.header-scrolled {
    background: rgba(8, 18, 23, 0.96);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 20px 40px -30px rgba(0, 0, 0, 0.7);
  }

  .utility-bar {
    background: var(--ink-deep);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .utility-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 34px;
  }

  .utility-location,
  .utility-link,
  .utility-note {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-heading);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }

  .utility-location { color: rgba(255, 255, 255, 0.62); }

  .utility-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .utility-link {
    color: rgba(255, 255, 255, 0.7);
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: 0.72rem;
  }

  .utility-link:hover { color: var(--brass-soft); }
  .lang-switch {
    color: var(--brass-soft);
    font-weight: 600;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(180, 134, 76, 0.12);
  }
  .utility-note { color: rgba(255, 255, 255, 0.36); font-size: 0.62rem; }

  .main-bar { padding: 0.65rem 0; }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    flex-shrink: 0;
  }

  .brand-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: border-color 0.25s var(--ease-soft), background 0.25s var(--ease-soft);
  }

  .brand-mark img { width: 30px; height: 30px; object-fit: contain; }
  .brand:hover .brand-mark { border-color: var(--brass); background: rgba(180, 134, 76, 0.12); }

  .brand-copy { display: flex; flex-direction: column; line-height: 1; }

  .brand-name {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--white);
  }

  .brand-sub {
    margin-top: 0.35rem;
    font-family: var(--font-heading);
    font-size: 0.5rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1.35rem;
    margin-left: auto;
    margin-right: 0.5rem;
  }

  .nav-link {
    position: relative;
    font-family: var(--font-heading);
    font-size: 0.79rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: rgba(255, 255, 255, 0.68);
    padding: 0.35rem 0;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1px;
    background: var(--brass-soft);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s var(--ease-out);
  }

  .nav-link:hover,
  .nav-link.active { color: var(--white); }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* DROPDOWNS */
  .nav-item-dropdown {
    position: relative;
    padding: 0.35rem 0;
  }
  .dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }
  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 250px;
    background: rgba(13, 26, 33, 0.98);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    padding: 0.65rem;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.65);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    z-index: 100;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .nav-item-dropdown:hover .dropdown-menu,
  .nav-item-dropdown:focus-within .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .dropdown-group-title {
    font-family: var(--font-heading);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    padding: 0.35rem 0.65rem 0.15rem;
  }
  .dropdown-item {
    padding: 0.45rem 0.65rem;
    border-radius: var(--radius-sm);
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .dropdown-item:hover {
    background: rgba(180, 134, 76, 0.15);
    color: var(--white);
  }
  .dropdown-item-bold {
    font-weight: 600;
    color: var(--brass-soft);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 0.5rem;
    margin-bottom: 0.2rem;
  }

  .contact-link { color: rgba(255, 255, 255, 0.55); }

  .header-actions { display: flex; align-items: center; gap: 0.8rem; }

  .header-phone {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: rgba(255, 255, 255, 0.8);
  }

  .header-phone:hover { border-color: var(--brass); color: var(--brass-soft); }

  .header-cta { border-radius: 10px; }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
    gap: 6px;
    width: 42px;
    height: 42px;
    padding: 0 10px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 10px;
    cursor: pointer;
  }

  .menu-toggle span {
    display: block;
    height: 2px;
    background: var(--white);
    border-radius: 2px;
    transition: width 0.25s var(--ease-soft), transform 0.25s var(--ease-soft);
  }

  .menu-toggle span:first-child { width: 22px; }
  .menu-toggle span:last-child { width: 14px; }
  .menu-toggle:hover span:last-child { width: 22px; }

  /* Mobile Drawer */
  .mobile-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(6px);
    z-index: 1100;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s var(--ease-soft);
  }

  .mobile-overlay.open { opacity: 1; pointer-events: auto; }

  .mobile-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(88vw, 380px);
    background: var(--ink-deep);
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    z-index: 1200;
    padding: 1.5rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.35s var(--ease-out);
  }

  .mobile-drawer.open { transform: translateX(0); }

  .drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .drawer-label {
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
  }

  .drawer-close {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
  }

  .drawer-close:hover { color: var(--white); }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    padding: 1rem 0;
    gap: 0.2rem;
  }

  .mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 0.5rem;
    font-family: var(--font-heading);
    font-size: 0.92rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.78);
    border-radius: var(--radius-sm);
    text-decoration: none;
  }

  .mobile-link:hover,
  .mobile-link.active {
    color: var(--white);
    background: rgba(255, 255, 255, 0.05);
  }

  .drawer-contact {
    margin-top: auto;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .drawer-contact-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.4);
    margin: 0;
  }

  @media (max-width: 1080px) {
    .desktop-nav { display: none; }
    .menu-toggle { display: flex; }
    .header-cta { display: none; }
  }

  @media (max-width: 640px) {
    .u-desktop { display: none; }
    .utility-inner { justify-content: space-between; }
  }
</style>
